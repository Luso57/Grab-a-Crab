        <Item class="Folder" referent="567">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="568">
            <Properties>
              <string name="Name">CrabServer</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local CrabRigBuilder = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabRigBuilder)

local CrabServer = {}
CrabServer.__index = CrabServer

export type CrabServer = typeof(setmetatable({} :: {
	instanceId: string,
	crabId: string,
	tool: Tool,
}, CrabServer))

function CrabServer.new(instanceId: string, crabId: string, weightGrams: number?): CrabServer?
	local definition = Crabs.get(crabId)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local models = if assets then assets:FindFirstChild("Crabs") else nil
	local template = if definition and models then models:FindFirstChild(definition.modelName) else nil
	if not definition or not template or not template:IsA("Model") then
		warn("Missing crab model template:", crabId)
		return nil
	end

	local model = template:Clone()
	local body = CrabRigBuilder.rig(model)
	if not body then
		model:Destroy()
		return nil
	end
	local height = model:GetExtentsSize().Y
	if height <= 0 then
		model:Destroy()
		return nil
	end
	model:ScaleTo(model:GetScale() * 2 / height * CrabWeights.scale(weightGrams))

	local tool = Instance.new("Tool")
	tool.Name = definition.name
	tool.TextureId = "rbxassetid://" .. definition.imageId
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("CrabId", crabId)
	tool:SetAttribute("WeightGrams", CrabWeights.normalize(weightGrams))
	tool:SetAttribute("ItemId", "Crab." .. crabId)
	tool:SetAttribute("ItemInstanceId", instanceId)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.CFrame = model:GetPivot()
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Name = "CrabHandleWeld"
	weld.Part0 = handle
	weld.Part1 = body
	weld.Parent = handle

	model.Parent = tool
	return setmetatable({ instanceId = instanceId, crabId = crabId, tool = tool }, CrabServer) :: CrabServer
end

function CrabServer.destroy(self: CrabServer)
	self.tool:Destroy()
end

return CrabServer
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="569">
        <Properties>
          <string name="Name">DecorShop</string>
        </Properties>
        <Item class="ModuleScript" referent="570">
          <Properties>
            <string name="Name">DecorShopServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Data = require(ReplicatedStorage.Source.Game.Data).server
local Networker = require(ReplicatedStorage.Packages.Networker)
local DecorConfig = require(ReplicatedStorage.Source.Features.DecorShop.DecorConfig)
local ShopStock = require(ReplicatedStorage.Source.Features.Shop.Modules.ShopStock)
local InventoryConfig = require(ReplicatedStorage.Source.Features.Inventory.InventoryConfig)
local InventoryServiceServer = require(ServerScriptService.Features.Inventory.InventoryServiceServer)

local DecorShopServiceServer = {}
local initialized = false
local networker = nil
local stockByPlayer: { [Player]: ShopStock.Stock } = {}
local buying: { [Player]: boolean } = {}
local rng = Random.new()
local interval = DecorConfig.restockIntervalSeconds
local nextRefreshAt = math.floor(Workspace:GetServerTimeNow() / interval + 1) * interval

local function sendStock(player: Player, restocked: boolean?)
	local stock = stockByPlayer[player]
	if networker and stock and player.Parent == Players then
		networker:fire(player, "updateStock", table.clone(stock), nextRefreshAt, restocked == true)
	end
end

local function rollStock(player: Player, restocked: boolean?)
	stockByPlayer[player] = ShopStock.roll(DecorConfig.items, rng)
	sendStock(player, restocked)
end

local function sendResult(player: Player, eventName: string, requestId: string)
	if networker and player.Parent == Players then
		networker:fire(player, eventName, requestId)
	end
end

function DecorShopServiceServer:init()
	if initialized then
		return
	end
	initialized = true

	networker = Networker.server.new("DecorShopService", self, { self.buy, self.ready })
	Players.PlayerAdded:Connect(function(player)
		rollStock(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		stockByPlayer[player] = nil
		buying[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		rollStock(player)
	end

	task.spawn(function()
		while true do
			task.wait(math.max(0, nextRefreshAt - Workspace:GetServerTimeNow()))
			nextRefreshAt += interval
			for _, player in Players:GetPlayers() do
				rollStock(player, true)
			end
		end
	end)
end

function DecorShopServiceServer:ready(player: Player)
	if player.Parent ~= Players then
		return
	end
	if not stockByPlayer[player] then
		rollStock(player)
	else
		sendStock(player)
	end
end

function DecorShopServiceServer:buy(player: Player, itemId: any, requestId: any)
	if typeof(itemId) ~= "string" or typeof(requestId) ~= "string" or #requestId > 64
		or not DecorConfig.get(itemId) or player.Parent ~= Players or buying[player] then
		return
	end
	local item = DecorConfig.get(itemId)
	if not item then
		return
	end
	buying[player] = true
	local ok, result = pcall(function()
		local data = Data.Service:waitForData(player)
		if not data or player.Parent ~= Players then
			return nil
		end
		local stock = stockByPlayer[player]
		if not stock or (stock[itemId] or 0) <= 0 then
			return nil
		end
		local balance = data.money()
		if typeof(balance) ~= "number" or balance ~= balance or balance < item.price then
			if typeof(balance) == "number" and balance < item.price then
				sendResult(player, "showNotEnoughMoney", requestId)
			end
			return nil
		end

		local instanceId = InventoryServiceServer:grantItem(player, "Decor." .. itemId, function()
			local currentBalance = data.money()
			return player.Parent == Players and stockByPlayer[player] == stock
				and (stock[itemId] or 0) > 0 and typeof(currentBalance) == "number"
				and currentBalance >= item.price
		end)
		if not instanceId then
			local count = 0
			for _, savedItem in data.inventory() do
				if typeof(savedItem) == "table" and savedItem.itemId ~= InventoryConfig.hammerItemId then
					count += 1
				end
			end
			if count >= InventoryConfig.maxItems then
				sendResult(player, "showInventoryFull", requestId)
			end
			return nil
		end

		data.money(function(currentBalance: number)
			return currentBalance - item.price
		end)
		stock[itemId] -= 1
		sendStock(player)
		return instanceId
	end)
	buying[player] = nil
	if not ok then
		warn(`DecorShop purchase failed for {player.Name}: {result}`)
	elseif result and networker and player.Parent == Players then
		networker:fire(player, "showPurchasedItem", requestId)
	end
end

return DecorShopServiceServer
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="571">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="572">
            <Properties>
              <string name="Name">DecorToolFactoryServer</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DecorConfig = require(ReplicatedStorage.Source.Features.DecorShop.DecorConfig)

local DecorToolFactoryServer = {}

function DecorToolFactoryServer.createTool(player: Player, decorId: string, instanceId: string): Tool?
	local definition = DecorConfig.get(decorId)
	if not definition or not player.Parent then
		return nil
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local decorations = if assets then assets:FindFirstChild("Decorations") else nil
	local template = if decorations then decorations:FindFirstChild(decorId) else nil
	if not template or not template:IsA("Model") then
		warn("Missing decoration model template:", decorId)
		return nil
	end

	local model = template:Clone()
	local _, size = model:GetBoundingBox()
	if size.Y <= 0 then
		model:Destroy()
		return nil
	end
	model:ScaleTo(model:GetScale() * 2 / size.Y)

	local tool = Instance.new("Tool")
	tool.Name = definition.name
	tool.TextureId = "rbxassetid://" .. definition.imageId
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ItemId", "Decor." .. decorId)
	tool:SetAttribute("ItemInstanceId", instanceId)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.CFrame = model:GetPivot()
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = descendant
			weld.Parent = handle
		end
	end
	model.Parent = tool
	return tool
end

return DecorToolFactoryServer
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="573">
        <Properties>
          <string name="Name">Egg</string>
        </Properties>
        <Item class="Folder" referent="574">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="575">
            <Properties>
              <string name="Name">EggServer</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)

local DISPLAY_SCALE = 0.8
local SURFACE_GAP = 0.05

local EggServer = {}
EggServer.__index = EggServer

export type EggServer = typeof(setmetatable({} :: {
	model: Model,
	driver: Part,
	prompt: ProximityPrompt,
	tween: Tween,
	completion: RBXScriptConnection?,
	triggerConnection: RBXScriptConnection?,
	claimed: boolean,
	destroyed: boolean,
}, EggServer))

local function pivotAboveMarker(marker: BasePart, bottomOffset: number): CFrame
	return marker.CFrame * CFrame.new(0, marker.Size.Y / 2 + bottomOffset + SURFACE_GAP, 0)
end

function EggServer.new(template: Model, parent: Folder, spawnA: BasePart, spawnB: BasePart, speed: number): EggServer
	local model = template:Clone()
	model:ScaleTo(DISPLAY_SCALE)
	local boxCFrame, boxSize = model:GetBoundingBox()
	local bottomOffset = model:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	local startCFrame = pivotAboveMarker(spawnA, bottomOffset)
	local endCFrame = pivotAboveMarker(spawnB, bottomOffset)
	model:PivotTo(startCFrame)

	local driver = Instance.new("Part")
	driver.Name = "ConveyorDriver"
	driver.Size = Vector3.new(0.2, 0.2, 0.2)
	driver.CFrame = model:GetPivot()
	driver.Transparency = 1
	driver.Anchored = true
	driver.CanCollide = false
	driver.CanTouch = false
	driver.CanQuery = false
	driver.CastShadow = false
	driver.Parent = model

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GetEggPrompt"
	local definition = Eggs.get(template.Name)
	prompt.ActionText = if definition and definition.price > 0 then "Buy Egg" else "Get Egg"
	prompt.ObjectText = if definition then definition.name else template.Name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = driver

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= driver then
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = driver
			weld.Part1 = descendant
			weld.Parent = driver
			descendant.Anchored = false
		end
	end

	model.PrimaryPart = driver
	model:SetAttribute("EggId", template.Name)
	model:SetAttribute("CrabId", template:GetAttribute("CrabId"))
	model.Parent = parent

	local travelTime = (endCFrame.Position - startCFrame.Position).Magnitude / speed
	local tween = TweenService:Create(driver, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
		CFrame = endCFrame,
	})
	return setmetatable({
		model = model,
		driver = driver,
		prompt = prompt,
		tween = tween,
		completion = nil :: RBXScriptConnection?,
		triggerConnection = nil :: RBXScriptConnection?,
		claimed = false,
		destroyed = false,
	}, EggServer) :: EggServer
end

function EggServer.start(self: EggServer, onFinished: () -> (), onTriggered: (Player) -> ())
	self.completion = self.tween.Completed:Connect(function(playbackState)
		if self.destroyed or playbackState ~= Enum.PlaybackState.Completed then
			return
		end
		self:destroy()
		onFinished()
	end)
	self.triggerConnection = self.prompt.Triggered:Connect(onTriggered)
	self.tween:Play()
end

function EggServer.reserve(self: EggServer): boolean
	if self.destroyed or self.claimed then
		return false
	end
	self.claimed = true
	self.prompt.Enabled = false
	return true
end

function EggServer.release(self: EggServer)
	if self.destroyed or not self.claimed then
		return
	end
	self.claimed = false
	self.prompt.Enabled = true
end

function EggServer.destroy(self: EggServer)
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self.completion then
		self.completion:Disconnect()
		self.completion = nil
	end
	if self.triggerConnection then
		self.triggerConnection:Disconnect()
		self.triggerConnection = nil
	end
	self.prompt.Enabled = false
	self.tween:Cancel()
	self.model:Destroy()
end

return EggServer
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="576">
        <Properties>
          <string name="Name">EggConveyor</string>
        </Properties>
        <Item class="Folder" referent="577">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="578">
            <Properties>
              <string name="Name">EggConveyorServer</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Data = require(ReplicatedStorage.Source.Game.Data).server
local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)
local LuckConfig = require(ReplicatedStorage.Source.Features.EggConveyor.Modules.LuckConfig)
local EggServer = require(ServerScriptService.Features.Egg.Classes.EggServer)
local InventoryServiceServer = require(ServerScriptService.Features.Inventory.InventoryServiceServer)

local SPAWN_INTERVAL = 1.6
local TRAVEL_SPEED = 5
local DISTANCE_TOLERANCE = 2

local EggConveyorServer = {}
EggConveyorServer.__index = EggConveyorServer

export type EggConveyorServer = typeof(setmetatable({} :: {
	plotModel: Model,
	spawnA: BasePart,
	spawnB: BasePart,
	templatesByRarity: { [string]: { Model } },
	activeFolder: Folder,
	activeEggs: { [EggServer.EggServer]: boolean },
	purchasing: { [Player]: boolean },
	onNotEnoughMoney: (Player) -> (),
	onPurchased: (Player) -> (),
	random: Random,
	running: boolean,
}, EggConveyorServer))

function EggConveyorServer.new(plotModel: Model, templates: { Model }, onNotEnoughMoney: (Player) -> (), onPurchased: (Player) -> ()): EggConveyorServer?
	local conveyor = plotModel:FindFirstChild("EggConveyor")
	if not conveyor or not conveyor:IsA("Folder") then
		warn(plotModel.Name .. " needs EggConveyor")
		return nil
	end
	local spawnA = conveyor:FindFirstChild("SpawnA")
	local spawnB = conveyor:FindFirstChild("SpawnB")
	if not spawnA or not spawnA:IsA("BasePart") or not spawnB or not spawnB:IsA("BasePart") then
		warn(plotModel.Name .. " needs SpawnA and SpawnB")
		return nil
	end
	if (spawnA.Position - spawnB.Position).Magnitude == 0 then
		warn(plotModel.Name .. " has overlapping egg conveyor markers")
		return nil
	end

	local templatesByRarity: { [string]: { Model } } = {}
	for _, template in templates do
		local rarity = Eggs.getRarity(template.Name)
		if rarity then
			local bucket = templatesByRarity[rarity]
			if not bucket then
				bucket = {}
				templatesByRarity[rarity] = bucket
			end
			table.insert(bucket, template)
		end
	end

	local activeFolder = Instance.new("Folder")
	activeFolder.Name = "ActiveEggs"
	activeFolder.Parent = conveyor
	return setmetatable({
		plotModel = plotModel,
		spawnA = spawnA,
		spawnB = spawnB,
		templatesByRarity = templatesByRarity,
		activeFolder = activeFolder,
		activeEggs = {} :: { [EggServer.EggServer]: boolean },
		purchasing = {} :: { [Player]: boolean },
	onNotEnoughMoney = onNotEnoughMoney,
		onPurchased = onPurchased,
		random = Random.new(),
		running = false,
	}, EggConveyorServer) :: EggConveyorServer
end

local function canCollect(self: EggConveyorServer, player: Player, egg: EggServer.EggServer): boolean
	if not self.running or not self.activeEggs[egg] or egg.destroyed or egg.model.Parent ~= self.activeFolder then
		return false
	end
	if player.Parent ~= Players or self.plotModel:GetAttribute("OwnerUserId") ~= player.UserId then
		return false
	end
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	return root ~= nil and root:IsA("BasePart") and humanoid ~= nil and humanoid.Health > 0
		and (root.Position - egg.driver.Position).Magnitude <= egg.prompt.MaxActivationDistance + DISTANCE_TOLERANCE
end

local function collect(self: EggConveyorServer, player: Player, egg: EggServer.EggServer)
	if self.purchasing[player] or not canCollect(self, player, egg) or not egg:reserve() then
		return
	end
	self.purchasing[player] = true
	local insufficientFunds = false
	local ok, purchased = pcall(function(): string?
		local eggId = egg.model:GetAttribute("EggId")
		if typeof(eggId) ~= "string" then
			return nil
		end
		local definition = Eggs.get(eggId)
		if not definition then
			return nil
		end
		local price = definition.price
		local data = Data.Service:waitForData(player)
		if not data or not canCollect(self, player, egg) then
			return nil
		end
		local money = data.money()
		if typeof(money) ~= "number" or money < price then
			insufficientFunds = typeof(money) == "number" and money < price
			return nil
		end
		local instanceId = InventoryServiceServer:grantItem(player, "Egg." .. eggId, function()
			return canCollect(self, player, egg) and data.money() >= price
		end)
		if not instanceId then
			local currentMoney = data.money()
			insufficientFunds = typeof(currentMoney) == "number" and currentMoney < price
			return nil
		end
		if price > 0 then
			data.money(data.money() - price)
		end
		return instanceId
	end)
	self.purchasing[player] = nil
	if ok and purchased then
		self.activeEggs[egg] = nil
		egg:destroy()
		local equipped, err = pcall(function()
			InventoryServiceServer:equipGrantedEgg(player, purchased)
		end)
		if not equipped then
			warn("Could not auto-equip purchased egg:", err)
		end
		self.onPurchased(player)
	else
		egg:release()
		if ok and insufficientFunds then
			self.onNotEnoughMoney(player)
		end
		if not ok then
			warn("Egg purchase failed:", purchased)
		end
	end
end

local function chooseTemplate(self: EggConveyorServer): Model?
	-- Recalculate for every spawn so a purchased upgrade affects the next egg.
	local weights = LuckConfig.getWeights(self.plotModel:GetAttribute("ConveyorLuck"))
	local total = 0
	for _, entry in weights do
		local bucket = self.templatesByRarity[entry.rarity]
		if entry.weight > 0 and bucket and #bucket > 0 then
			total += entry.weight
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = self.random:NextNumber(0, total)
	local lastAvailable: { Model }? = nil
	for _, entry in weights do
		local bucket = self.templatesByRarity[entry.rarity]
		if entry.weight > 0 and bucket and #bucket > 0 then
			lastAvailable = bucket
			roll -= entry.weight
			if roll <= 0 then
				return bucket[self.random:NextInteger(1, #bucket)]
			end
		end
	end
	-- Account for rounding at the upper edge of the random roll.
	return if lastAvailable then lastAvailable[self.random:NextInteger(1, #lastAvailable)] else nil
end

function EggConveyorServer.start(self: EggConveyorServer)
	if self.running then
		return
	end
	self.running = true
	task.spawn(function()
		while self.running do
			local template = chooseTemplate(self)
			if not template then
				task.wait(SPAWN_INTERVAL)
				continue
			end
			local egg = EggServer.new(template, self.activeFolder, self.spawnA, self.spawnB, TRAVEL_SPEED)
			self.activeEggs[egg] = true
			egg:start(function()
				self.activeEggs[egg] = nil
			end, function(player)
				collect(self, player, egg)
			end)
			task.wait(SPAWN_INTERVAL)
		end
	end)
end

function EggConveyorServer.stop(self: EggConveyorServer)
	self.running = false
	for egg in self.activeEggs do
		egg:destroy()
	end
	table.clear(self.activeEggs)
	self.activeFolder:Destroy()
end

return EggConveyorServer
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="579">
          <Properties>
            <string name="Name">EggConveyorServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Networker = require(ReplicatedStorage.Packages.Networker)
local Data = require(ReplicatedStorage.Source.Game.Data).server
local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)
local LuckConfig = require(ReplicatedStorage.Source.Features.EggConveyor.Modules.LuckConfig)
local EggConveyorServer = require(ServerScriptService.Features.EggConveyor.Classes.EggConveyorServer)

local EggConveyorServiceServer = {}
local initialized = false
local templates: { Model } = {}
local active: { [Model]: EggConveyorServer.EggConveyorServer } = {}
local buying: { [Player]: boolean } = {}
local networker = nil

local function getSavedLuck(player: Player, data: any): number
    local luck = LuckConfig.normalizeLuck(data.conveyorLuck())
    local profile = Data.Service:getProfile(player)
    local saved = if profile then profile.Data else nil
    local oldLevel = if typeof(saved) == "table" then saved.conveyorLevel else nil
    if typeof(oldLevel) == "number" and oldLevel == oldLevel and oldLevel ~= math.huge and oldLevel ~= -math.huge then
        if luck == 0 then
            luck = LuckConfig.normalizeLuck((math.max(1, math.floor(oldLevel)) - 1) * LuckConfig.LUCK_PER_UPGRADE)
        end
        saved.conveyorLevel = nil
    end
    if data.conveyorLuck() ~= luck then
        data.conveyorLuck(luck)
    end
    return luck
end

local function getOwnedPlot(player: Player): any
    local PlotServiceServer = require(ServerScriptService.Features.Plots.PlotServiceServer)
    local plot = PlotServiceServer:getPlot(player)
    if plot and plot:getOwner() == player then
        return plot
    end
    return nil
end

local function isNearSign(player: Player, plotModel: Model): boolean
    local sign = plotModel:FindFirstChild("MoreLuckSign")
    local panel = if sign then sign:FindFirstChild("FrontPanel") else nil
    local character = player.Character
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    return panel ~= nil and panel:IsA("BasePart")
        and root ~= nil and root:IsA("BasePart")
        and humanoid ~= nil and humanoid.Health > 0
        and (root.Position - panel.Position).Magnitude <= 18
end

function EggConveyorServiceServer:init()
    if initialized then
        return
    end
    templates = Eggs.getTemplates()
    networker = Networker.server.new("EggConveyor", self, { self.ready, self.buyUpgrade })
    Players.PlayerRemoving:Connect(function(player)
        buying[player] = nil
    end)
    initialized = true
end

function EggConveyorServiceServer:start(plotModel: Model)
    if active[plotModel] then
        return
    end
    if not initialized or #templates == 0 then
        warn("Egg conveyor is unavailable: no egg templates loaded")
        return
    end
    local conveyor = EggConveyorServer.new(plotModel, templates, function(player: Player)
        if networker and player.Parent == Players then
            networker:fire(player, "showNotEnoughMoney")
        end
    end, function(player: Player)
        if networker and player.Parent == Players then
            networker:fire(player, "eggPurchased")
        end
    end)
    if not conveyor then
        return
    end
    active[plotModel] = conveyor
    conveyor:start()
end

function EggConveyorServiceServer:ready(player: Player)
    local data = Data.Service:waitForData(player)
    if not data or player.Parent ~= Players then
        return
    end
    local plot = getOwnedPlot(player)
    if plot then
        plot.model:SetAttribute("ConveyorLuck", getSavedLuck(player, data))
        self:start(plot.model)
    end
end

function EggConveyorServiceServer:buyUpgrade(player: Player)
    if buying[player] then
        return
    end
    buying[player] = true
    local ok, err = pcall(function()
        local data = Data.Service:waitForData(player)
        if not data or player.Parent ~= Players then
            return
        end
        local plot = getOwnedPlot(player)
        if not plot or not isNearSign(player, plot.model) then
            return
        end

        local luck = getSavedLuck(player, data)
        local price = LuckConfig.getUpgradePrice(luck)
        if not price then
            return
        end
        local money = data.money()
        if typeof(money) ~= "number" or money ~= money or money < price then
            return
        end

        data.money(money - price)
        local newLuck = luck + LuckConfig.LUCK_PER_UPGRADE
        data.conveyorLuck(newLuck)
        plot.model:SetAttribute("ConveyorLuck", newLuck)
    end)
    buying[player] = nil
    if not ok then
        warn("Egg conveyor upgrade failed:", err)
    end
end

function EggConveyorServiceServer:stop(plotModel: Model)
    local conveyor = active[plotModel]
    if conveyor then
        active[plotModel] = nil
        conveyor:stop()
    end
end

return EggConveyorServiceServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="580">
        <Properties>
          <string name="Name">Incubators</string>
        </Properties>
        <Item class="Folder" referent="581">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="582">
            <Properties>
              <string name="Name">IncubatorServer</string>
              <string name="Source"><![CDATA[--!strict



local IncubatorServer = {}
IncubatorServer.__index = IncubatorServer

export type IncubatorServer = typeof(setmetatable({} :: {
	owner: Player,
	instanceId: string,
	incubatorId: string,
	tool: Tool,
	model: Model,
}, IncubatorServer))

function IncubatorServer.new(owner: Player, instanceId: string, incubatorId: string, name: string, template: Model): IncubatorServer?
	local model = template:Clone()
	local height = model:GetExtentsSize().Y
	if height <= 0 then
		model:Destroy()
		return nil
	end
	model:ScaleTo(model:GetScale() * 2 / height)

	
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("IncubatorId", incubatorId)
	tool:SetAttribute("IncubatorInstanceId", instanceId)
	tool:SetAttribute("ItemId", incubatorId)
	tool:SetAttribute("ItemInstanceId", instanceId)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.CFrame = model:GetPivot()
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = descendant
			weld.Parent = handle
		end
	end

	model.Parent = tool
	return setmetatable({
		owner = owner,
		instanceId = instanceId,
		incubatorId = incubatorId,
		tool = tool,
		model = model,
	}, IncubatorServer) :: IncubatorServer
end

function IncubatorServer.destroy(self: IncubatorServer)
	self.tool:Destroy()
end

return IncubatorServer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="583">
            <Properties>
              <string name="Name">PlacedIncubatorServer</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Data = require(ReplicatedStorage.Source.Game.Data).server

type SavedItem = {
	itemId: string,
	incubatorInstanceId: string?,
	hatchAtUnixMs: number?,
}

local PlacedIncubatorServer = {}
PlacedIncubatorServer.__index = PlacedIncubatorServer

export type PlacedIncubatorServer = typeof(setmetatable({} :: {
	owner: Player,
	plotModel: Model,
	model: Model,
	instanceId: string,
	prompt: ProximityPrompt,
	hatchPrompt: ProximityPrompt?,
	eggInstanceId: string?,
	eggId: string?,
	hatchAtUnixMs: number?,
	visual: Model?,
	destroyed: boolean,
}, PlacedIncubatorServer))

local function inventoryService()
	return require(ServerScriptService.Features.Inventory.InventoryServiceServer)
end

local function moneyPadSide(self: PlacedIncubatorServer): Vector3?
	local slotId = self.model:GetAttribute("SlotId")
	local slots = self.plotModel:FindFirstChild("PlacementSlots")
	if typeof(slotId) ~= "string" or not slots then
		return nil
	end
	local side = string.match(slotId, "^(Left)") or string.match(slotId, "^(Right)")
	if not side then
		return nil
	end
	local own = slots:FindFirstChild(side .. "1")
	local opposite = slots:FindFirstChild((if side == "Left" then "Right" else "Left") .. "1")
	if not own or not own:IsA("BasePart") or not opposite or not opposite:IsA("BasePart") then
		return nil
	end
	local offset = opposite.Position - own.Position
	local horizontal = Vector3.new(offset.X, 0, offset.Z)
	return if horizontal.Magnitude > 0.01 then horizontal.Unit else nil
end

local function isOwnerInRange(self: PlacedIncubatorServer, player: Player): boolean
	if player ~= self.owner or player.Parent ~= Players or self.destroyed or not self.model.Parent then
		return false
	end
	local plotService = require(ServerScriptService.Features.Plots.PlotServiceServer)
	local plot = plotService:getPlot(player)
	if not plot or plot.model ~= self.plotModel or plot:getOwner() ~= player then
		return false
	end
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local surface = self.prompt.Parent :: BasePart
	return root ~= nil and root:IsA("BasePart") and humanoid ~= nil and humanoid.Health > 0
		and (root.Position - surface.Position).Magnitude <= 10
end

function PlacedIncubatorServer.new(owner: Player, plotModel: Model, model: Model, instanceId: string): PlacedIncubatorServer?
	local surface = model:FindFirstChild("InsideFloor", true)
	if not surface or not surface:IsA("BasePart") then
		surface = model.PrimaryPart
	end
	if not surface or not surface:IsA("BasePart") then
		return nil
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PlaceEggPrompt"
	prompt.ActionText = "Place Egg"
	prompt.ObjectText = "Incubator"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = surface

	local self = setmetatable({
		owner = owner,
		plotModel = plotModel,
		model = model,
		instanceId = instanceId,
		prompt = prompt,
		hatchPrompt = nil :: ProximityPrompt?,
		eggInstanceId = nil :: string?,
		eggId = nil :: string?,
		hatchAtUnixMs = nil :: number?,
		visual = nil :: Model?,
		destroyed = false,
	}, PlacedIncubatorServer) :: PlacedIncubatorServer

	prompt.Triggered:Connect(function(player)
		if self.eggInstanceId or not isOwnerInRange(self, player) then
			return
		end
		-- Set occupancy before creating the visual or scheduling a timer.
		local eggInstanceId, eggId, hatchAtUnixMs = inventoryService():startIncubation(player, instanceId)
		if not eggInstanceId or not eggId or not hatchAtUnixMs then
			return
		end
		self:occupy(eggInstanceId, eggId, hatchAtUnixMs)
	end)
	return self
end

function PlacedIncubatorServer.showEgg(self: PlacedIncubatorServer, eggId: string)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local eggs = if assets then assets:FindFirstChild("Eggs") else nil
	local template = if eggs then eggs:FindFirstChild(eggId) else nil
	if not template or not template:IsA("Model") then
		warn("Missing egg model for incubator:", eggId)
		return
	end
	local visual = template:Clone()
	local height = visual:GetExtentsSize().Y
	if height <= 0 then
		visual:Destroy()
		return
	end
	visual:ScaleTo(visual:GetScale() * 2 / height)
	local surface = self.prompt.Parent :: BasePart
	local boxCFrame, boxSize = visual:GetBoundingBox()
	local pivotToBottom = visual:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	visual:PivotTo(surface.CFrame * CFrame.new(0, surface.Size.Y / 2 + pivotToBottom, 0))
	for _, descendant in visual:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		elseif descendant:IsA("ProximityPrompt") then
			descendant:Destroy()
		end
	end
	visual.Name = "IncubatingEgg"
	visual.Parent = self.model
	self.visual = visual
	local eggPart = visual.PrimaryPart or visual:FindFirstChildWhichIsA("BasePart", true)
	if eggPart and eggPart:IsA("BasePart") then
		local hatchPrompt = Instance.new("ProximityPrompt")
		hatchPrompt.Name = "HatchEggPrompt"
		hatchPrompt.ActionText = "Hatch"
		hatchPrompt.ObjectText = "Egg"
		hatchPrompt.KeyboardKeyCode = Enum.KeyCode.E
		hatchPrompt.HoldDuration = 0
		hatchPrompt.MaxActivationDistance = 10
		hatchPrompt.RequiresLineOfSight = false
		hatchPrompt.Enabled = false
		hatchPrompt.Parent = eggPart
		hatchPrompt.Triggered:Connect(function(player)
			local eggInstanceId = self.eggInstanceId
			local hatchAtUnixMs = self.hatchAtUnixMs
			if not eggInstanceId or not hatchAtUnixMs or not hatchPrompt.Enabled
				or not isOwnerInRange(self, player)
				or DateTime.now().UnixTimestampMillis < hatchAtUnixMs then
				return
			end
			local completed, crabId, weightGrams = inventoryService():completeIncubation(player, eggInstanceId, self.instanceId, hatchAtUnixMs)
			if completed then
				local hatchedEggId = self.eggId
				local eggVisual = self.visual
				local eggPivot = if eggVisual then eggVisual:GetPivot() else nil
				local eggScale = if eggVisual then eggVisual:GetScale() else nil
				self:clear()
				if crabId and weightGrams then
					local IncubatorServiceServer = require(ServerScriptService.Features.Incubators.IncubatorServiceServer)
					IncubatorServiceServer:showHatch(player, crabId, weightGrams, hatchedEggId, eggPivot, eggScale, moneyPadSide(self), eggInstanceId)
				end
			end
		end)
		self.hatchPrompt = hatchPrompt
	end
end

function PlacedIncubatorServer.clear(self: PlacedIncubatorServer)
	if self.visual then
		self.visual:Destroy()
		self.visual = nil
	end
	self.hatchPrompt = nil
	self.eggInstanceId = nil
	self.eggId = nil
	self.hatchAtUnixMs = nil
	self.model:SetAttribute("IncubatingEggId", nil)
	self.model:SetAttribute("IncubatingHatchAtUnixMs", nil)
	self.prompt.Enabled = not self.destroyed
end

function PlacedIncubatorServer.occupy(self: PlacedIncubatorServer, eggInstanceId: string, eggId: string, hatchAtUnixMs: number)
	if self.destroyed or self.eggInstanceId then
		return
	end
	self.eggInstanceId = eggInstanceId
	self.eggId = eggId
	self.hatchAtUnixMs = hatchAtUnixMs
	self.model:SetAttribute("IncubatingEggId", eggInstanceId)
	self.model:SetAttribute("IncubatingHatchAtUnixMs", hatchAtUnixMs)
	self.prompt.Enabled = false
	self:showEgg(eggId)
	local function finish()
		if self.destroyed or self.eggInstanceId ~= eggInstanceId or self.hatchAtUnixMs ~= hatchAtUnixMs then
			return
		end
		local remaining = (hatchAtUnixMs - DateTime.now().UnixTimestampMillis) / 1000
		if remaining > 0 then
			task.delay(remaining, finish)
			return
		end
		if self.hatchPrompt then
			self.hatchPrompt.Enabled = true
		end
	end
	task.delay(math.max(0, (hatchAtUnixMs - DateTime.now().UnixTimestampMillis) / 1000), finish)
end

function PlacedIncubatorServer.restore(self: PlacedIncubatorServer)
	if self.destroyed or self.owner.Parent ~= Players then
		return
	end
	local inventory = Data[self.owner].inventory() :: { [string]: SavedItem }
	local instanceIds = {}
	for instanceId, item in inventory do
		if typeof(item) == "table" and item.incubatorInstanceId == self.instanceId then
			table.insert(instanceIds, instanceId)
		end
	end
	table.sort(instanceIds)
	for _, eggInstanceId in instanceIds do
		local item = inventory[eggInstanceId]
		local eggId = string.match(item.itemId, "^Egg%.([%w_]+)$")
		if eggId and typeof(item.hatchAtUnixMs) == "number" then
			self:occupy(eggInstanceId, eggId, item.hatchAtUnixMs :: number)
			break
		end
	end
end

function PlacedIncubatorServer.destroy(self: PlacedIncubatorServer)
	if self.destroyed then
		return
	end
	self.destroyed = true
	self.prompt:Destroy()
	if self.visual then
		self.visual:Destroy()
		self.visual = nil
	end
end

return PlacedIncubatorServer
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="584">
          <Properties>
            <string name="Name">IncubatorServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networker = require(ReplicatedStorage.Packages.Networker)

local IncubatorServer = require(script.Parent.Classes.IncubatorServer)
local PlacedIncubatorServer = require(script.Parent.Classes.PlacedIncubatorServer)
local Incubators = require(ReplicatedStorage.Source.Features.Incubators.Modules.Incubators)

local IncubatorServiceServer = {}
local initialized = false
local networker = nil
local ownedIncubators: { [Player]: { [string]: IncubatorServer.IncubatorServer } } = {}
local placedIncubators: { [Model]: PlacedIncubatorServer.PlacedIncubatorServer } = {}

local function playerRemoving(player: Player)
	local playerIncubators = ownedIncubators[player]
	ownedIncubators[player] = nil
	if playerIncubators then
		local held = {}
		for _, incubator in playerIncubators do
			table.insert(held, incubator)
		end
		for _, incubator in held do
			incubator:destroy()
		end
	end
	local toRemove = {}
	for model, incubator in placedIncubators do
		if incubator.owner == player then
			table.insert(toRemove, model)
		end
	end
	for _, model in toRemove do
		placedIncubators[model]:destroy()
		placedIncubators[model] = nil
	end
end

function IncubatorServiceServer:init()
	if initialized then
		return
	end
	initialized = true
	networker = Networker.server.new("IncubatorService", self)
	Players.PlayerRemoving:Connect(playerRemoving)
end

function IncubatorServiceServer:showHatch(
	player: Player,
	crabId: string,
	weightGrams: number,
	eggId: string?,
	eggPivot: CFrame?,
	eggScale: number?,
	viewDirection: Vector3?,
	instanceId: string
)
	if networker and player.Parent == Players then
		networker:fire(player, "showHatch", crabId, weightGrams, eggId, eggPivot, eggScale, viewDirection, instanceId)
	end
end

function IncubatorServiceServer:createTool(player: Player, incubatorId: string, instanceId: string): Tool?
	local definition = Incubators.get(incubatorId)
	if not definition or player.Parent ~= Players then
		return nil
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local templates = if assets then assets:FindFirstChild("Incubators") else nil
	local modelTemplate = if templates then templates:FindFirstChild(definition.modelName) else nil
	if not modelTemplate or not modelTemplate:IsA("Model") or not modelTemplate.PrimaryPart then
		warn("Missing incubator model template:", definition.modelName)
		return nil
	end
	local incubator = IncubatorServer.new(player, instanceId, incubatorId, definition.name, modelTemplate)
	if not incubator then
		return nil
	end
	local playerIncubators = ownedIncubators[player]
	if not playerIncubators then
		playerIncubators = {}
		ownedIncubators[player] = playerIncubators
	end
	playerIncubators[incubator.instanceId] = incubator
	incubator.tool.Destroying:Connect(function()
		playerIncubators[incubator.instanceId] = nil
	end)
	return incubator.tool
end

function IncubatorServiceServer:getIncubator(player: Player, instanceId: string): IncubatorServer.IncubatorServer?
	local playerIncubators = ownedIncubators[player]
	return if playerIncubators then playerIncubators[instanceId] else nil
end

function IncubatorServiceServer:registerPlaced(owner: Player, plotModel: Model, model: Model, instanceId: string): boolean
	if placedIncubators[model] then
		return false
	end
	local incubator = PlacedIncubatorServer.new(owner, plotModel, model, instanceId)
	if not incubator then
		return false
	end
	placedIncubators[model] = incubator
	incubator:restore()
	return true
end

function IncubatorServiceServer:unregisterPlaced(model: Model)
	local incubator = placedIncubators[model]
	if incubator then
		placedIncubators[model] = nil
		incubator:destroy()
	end
end

function IncubatorServiceServer:isOccupied(model: Model): boolean
	local incubator = placedIncubators[model]
	return incubator ~= nil and incubator.eggInstanceId ~= nil
end

function IncubatorServiceServer:getPlacedEggId(model: Model): string?
	local incubator = placedIncubators[model]
	return if incubator then incubator.eggInstanceId else nil
end

function IncubatorServiceServer:clearPlacedForPlayer(player: Player)
	local toRemove = {}
	for model, incubator in placedIncubators do
		if incubator.owner == player then
			table.insert(toRemove, model)
		end
	end
	for _, model in toRemove do
		self:unregisterPlaced(model)
	end
end

return IncubatorServiceServer
]]></string>
          </Properties>
        </Item>
