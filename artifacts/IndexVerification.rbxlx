      <Item class="Folder" referent="585">
        <Properties>
          <string name="Name">Inventory</string>
        </Properties>
        <Item class="ModuleScript" referent="586">
          <Properties>
            <string name="Name">InventoryServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Data = require(ReplicatedStorage.Source.Game.Data).server
local InventoryConfig = require(ReplicatedStorage.Source.Features.Inventory.InventoryConfig)
local ItemCatalog = require(ReplicatedStorage.Source.Game.Items.ItemCatalog)
local Networker = require(ReplicatedStorage.Packages.Networker)
local Tanks = require(ReplicatedStorage.Source.Features.Tanks.Modules.Tanks)
local TankServiceServer = require(ServerScriptService.Features.Tanks.TankServiceServer)
local IncubatorServiceServer = require(ServerScriptService.Features.Incubators.IncubatorServiceServer)
local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local CrabServer = require(ServerScriptService.Features.Crabs.Classes.CrabServer)
local DecorToolFactoryServer = require(ServerScriptService.Features.DecorShop.Modules.DecorToolFactoryServer)

type SavedItem = { itemId: string, placedSlotId: string?, incubatorInstanceId: string?, tankInstanceId: string?, hatchAtUnixMs: number?, weightGrams: number? }
type SavedInventory = { [string]: SavedItem }

local InventoryServiceServer = {}

local function isHotbarEligible(itemId: string): boolean
	local definition = ItemCatalog.get(itemId)
	return definition ~= nil and definition.hotbarEligible ~= false
end

local function isAvailable(item: SavedItem?): boolean
	return typeof(item) == "table" and typeof(item.itemId) == "string"
		and item.placedSlotId == nil and item.incubatorInstanceId == nil and item.tankInstanceId == nil
		and isHotbarEligible(item.itemId)
end

local function findAvailableCopy(inventory: SavedInventory, itemId: string, used: { [string]: boolean }): string?
	local firstId: string? = nil
	for instanceId, item in inventory do
		if not used[instanceId] and isAvailable(item) and item.itemId == itemId
			and (not firstId or instanceId < firstId) then
			firstId = instanceId
		end
	end
	return firstId
end

local initialized = false
local readyPlayers: { [Player]: boolean } = {}
local syncQueued: { [Player]: boolean } = {}

local function ensureHammer(data: any, player: Player): string
	local hammerId = InventoryConfig.hammerInstanceId(player.UserId)
	local inventory = data.inventory() :: SavedInventory
	for instanceId, item in inventory do
		if instanceId ~= hammerId and typeof(item) == "table" and item.itemId == InventoryConfig.hammerItemId then
			data.inventory[instanceId](nil)
		end
	end
	local saved = inventory[hammerId]
	if typeof(saved) ~= "table" or saved.itemId ~= InventoryConfig.hammerItemId or saved.placedSlotId ~= nil then
		data.inventory[hammerId]({ itemId = InventoryConfig.hammerItemId })
	end
	return hammerId
end

local function normalizeHotbar(data: any, player: Player): { string }
	local hammerId = ensureHammer(data, player)
	local inventory = data.inventory() :: SavedInventory
	local current = data.hotbar() :: { string }
	local normalized: { string } = { hammerId }
	local seen: { [string]: boolean } = { [hammerId] = true }
	local seenStackable: { [string]: boolean } = {}
	local changed = #current ~= InventoryConfig.hotbarSize or current[InventoryConfig.hammerSlot] ~= hammerId

	for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
		local instanceId = current[index]
		local item = if typeof(instanceId) == "string" then inventory[instanceId] else nil
		if typeof(item) == "table" and typeof(item.itemId) == "string"
			and ItemCatalog.isStackable(item.itemId) and not isAvailable(item) then
			instanceId = findAvailableCopy(inventory, item.itemId, seen) or InventoryConfig.emptySlot
			item = inventory[instanceId]
		end
		local stackable = typeof(item) == "table" and ItemCatalog.isStackable(item.itemId)
		if isAvailable(item) and item.itemId ~= InventoryConfig.hammerItemId
			and not seen[instanceId] and (not stackable or not seenStackable[item.itemId]) then
			normalized[index] = instanceId
			seen[instanceId] = true
			if stackable then
				seenStackable[item.itemId] = true
			end
		else
			normalized[index] = InventoryConfig.emptySlot
		end
	end

	local displacedId = current[InventoryConfig.hammerSlot]
	local displaced = if typeof(displacedId) == "string" then inventory[displacedId] else nil
	if isAvailable(displaced) and displaced.itemId ~= InventoryConfig.hammerItemId
		and not seen[displacedId]
		and (not ItemCatalog.isStackable(displaced.itemId) or not seenStackable[displaced.itemId]) then
		for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
			if normalized[index] == InventoryConfig.emptySlot then
				normalized[index] = displacedId
				if ItemCatalog.isStackable(displaced.itemId) then
					seenStackable[displaced.itemId] = true
				end
				break
			end
		end
	end

	for index = 1, InventoryConfig.hotbarSize do
		if normalized[index] ~= current[index] then
			changed = true
		end
	end
	if changed then
		data.hotbar(normalized)
	end
	return normalized
end

local function createEggTool(player: Player, eggId: string, instanceId: string): Tool?
	local definition = Eggs.get(eggId)
	if not definition or player.Parent ~= Players then
		return nil
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local templates = if assets then assets:FindFirstChild("Eggs") else nil
	local template = if templates then templates:FindFirstChild(eggId) else nil
	if not template or not template:IsA("Model") or not template.PrimaryPart then
		warn("Missing egg model template:", eggId)
		return nil
	end

	local model = template:Clone()
	local height = model:GetExtentsSize().Y
	if height <= 0 then
		model:Destroy()
		return nil
	end
	model:ScaleTo(model:GetScale() * 2 / height)

	local tool = Instance.new("Tool")
	tool.Name = definition.name
	tool.TextureId = "rbxassetid://" .. definition.imageId
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("EggId", eggId)
	tool:SetAttribute("ItemId", "Egg." .. eggId)
	tool:SetAttribute("ItemInstanceId", instanceId)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.CFrame = model:GetPivot()
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = descendant
			weld.Parent = handle
		end
	end
	model.Parent = tool
	return tool
end
local function createTool(player: Player, itemId: string, instanceId: string, weightGrams: number?): Tool?
	if itemId == InventoryConfig.hammerItemId then
		local template = ReplicatedStorage:FindFirstChild("Assets")
		local tools = if template then template:FindFirstChild("Tools") else nil
		local hammer = if tools then tools:FindFirstChild("Hammer") else nil
		if not hammer or not hammer:IsA("Tool") then
			warn("Missing ReplicatedStorage.Assets.Tools.Hammer Tool")
			return nil
		end
		local tool = hammer:Clone()
		tool.CanBeDropped = false
		tool:SetAttribute("ItemId", itemId)
		tool:SetAttribute("ItemInstanceId", instanceId)
		return tool
	end
	if itemId == "Incubator" then
		return IncubatorServiceServer:createTool(player, "Incubator", instanceId)
	end
	local decorId = string.match(itemId, "^Decor%.([%w_]+)$")
	if decorId then
		return DecorToolFactoryServer.createTool(player, decorId, instanceId)
	end
	local eggId = string.match(itemId, "^Egg%.([%w_]+)$")
	if eggId then
		return createEggTool(player, eggId, instanceId)
	end

	local crabId = string.match(itemId, "^Crab%.([%w_]+)$")
	if crabId and Crabs.get(crabId) then
		local crab = CrabServer.new(instanceId, crabId, weightGrams)
		return if crab then crab.tool else nil
	end

	local tankId = string.match(itemId, "^Tank%.([%w_]+)$")
	if tankId and Tanks.get(tankId) then
		return TankServiceServer:createTool(player, tankId, instanceId)
	end
	return nil
end

local function syncTools(player: Player)
	if not readyPlayers[player] or player.Parent ~= Players then
		return
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	local data = Data[player]
	local inventory = data.inventory() :: SavedInventory
	local hotbar = normalizeHotbar(data, player)
	local wanted: { [string]: string } = {}
	for index = 1, InventoryConfig.hotbarSize do
		local instanceId = hotbar[index]
		local item = if typeof(instanceId) == "string" then inventory[instanceId] else nil
		if typeof(item) == "table" and typeof(item.itemId) == "string" and item.placedSlotId == nil and item.incubatorInstanceId == nil and item.tankInstanceId == nil and isHotbarEligible(item.itemId) then
			wanted[instanceId] = item.itemId
		end
	end

	local found: { [string]: boolean } = {}
	local function scan(container: Instance?)
		if not container then
			return
		end
		for _, child in container:GetChildren() do
			if not child:IsA("Tool") then
				continue
			end
			local instanceId = child:GetAttribute("ItemInstanceId")
			if typeof(instanceId) ~= "string" then
				continue
			end
			if wanted[instanceId] == child:GetAttribute("ItemId") and not found[instanceId] then
				found[instanceId] = true
			else
				child:Destroy()
			end
		end
	end

	scan(backpack)
	scan(player.Character)

	for instanceId, itemId in wanted do
		if not found[instanceId] then
			local savedItem = inventory[instanceId]
			local tool = createTool(player, itemId, instanceId, if savedItem then savedItem.weightGrams else nil)
			if tool then
				tool.Parent = backpack
			end
		end
	end
end

local function scheduleSync(player: Player)
	if syncQueued[player] then
		return
	end
	syncQueued[player] = true
	task.defer(function()
		syncQueued[player] = nil
		syncTools(player)
	end)
end

local function grantStarterItems(player: Player, data: any)
	if data.starterItemsGranted() then
		return
	end

	local hasIncubator = false
	local ownedTanks: { [string]: boolean } = {}
	local inventory = data.inventory() :: SavedInventory
	for _, item in inventory do
		if typeof(item) == "table" and typeof(item.itemId) == "string" then
			hasIncubator = hasIncubator or item.itemId == "Incubator"
			ownedTanks[item.itemId] = true
		end
	end

	if not hasIncubator and not InventoryServiceServer:grantItem(player, "Incubator") then
		return
	end
	for _, tankItemId in { "Tank.Small" } do
		if not ownedTanks[tankItemId] and not InventoryServiceServer:grantItem(player, tankItemId) then
			return
		end
	end
	data.starterItemsGranted(true)
end

local function removeLegacyStarterCrabs(player: Player, data: any)
	local prefix = `StarterBasicCrab:{player.UserId}:`
	local inventory = data.inventory() :: SavedInventory
	local removeIds = {}
	for instanceId, item in inventory do
		if string.sub(instanceId, 1, #prefix) == prefix
			and typeof(item) == "table" and item.itemId == "Crab.BasicCrab"
			and item.placedSlotId == nil and item.incubatorInstanceId == nil and item.tankInstanceId == nil then
			table.insert(removeIds, instanceId)
		end
	end
	for _, instanceId in removeIds do
		data.inventory[instanceId](nil)
	end
end

local function setupPlayer(player: Player)
	local function watchToolRemoval(container: Instance)
		container.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") and child:GetAttribute("ItemId") == InventoryConfig.hammerItemId then
				scheduleSync(player)
			end
		end)
	end
	player.CharacterAdded:Connect(function(character)
		watchToolRemoval(character)
		scheduleSync(player)
	end)
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			watchToolRemoval(child)
			scheduleSync(player)
		end
	end)
	if player.Character then
		watchToolRemoval(player.Character)
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		watchToolRemoval(backpack)
	end
	task.spawn(function()
		local data = Data.Service:waitForData(player)
		if player.Parent ~= Players then
			return
		end
		grantStarterItems(player, data)
		removeLegacyStarterCrabs(player, data)
		normalizeHotbar(data, player)
		readyPlayers[player] = true
		scheduleSync(player)
	end)
end

function InventoryServiceServer:init()
	if initialized then
		return
	end
	initialized = true

	Networker.server.new("InventoryService", self, { self.setHotbarSlot, self.removeHotbarSlot, self.claimHatchedCrab })
	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(function(player)
		readyPlayers[player] = nil
		syncQueued[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		setupPlayer(player)
	end
end

function InventoryServiceServer:grantItem(player: Player, itemId: string, canGrant: (() -> boolean)?): string?
	if itemId == InventoryConfig.hammerItemId or not ItemCatalog.get(itemId) or player.Parent ~= Players then
		return nil
	end

	local data = Data.Service:waitForData(player)
	if not data or player.Parent ~= Players or (canGrant and not canGrant()) then
		return nil
	end

	local inventory = data.inventory() :: SavedInventory
	local count = 0
	for _, item in inventory do
		if typeof(item) == "table" and item.itemId ~= InventoryConfig.hammerItemId then
			count += 1
		end
	end
	if count >= InventoryConfig.maxItems then
		return nil
	end

	local instanceId = HttpService:GenerateGUID(false)
	data.inventory[instanceId]({ itemId = itemId })
	if isHotbarEligible(itemId) then
		local hotbar = normalizeHotbar(data, player)
		local alreadyAssigned = false
		if ItemCatalog.isStackable(itemId) then
			local currentInventory = data.inventory() :: SavedInventory
			for _, assignedId in hotbar do
				local assignedItem = currentInventory[assignedId]
				if assignedItem and assignedItem.itemId == itemId then
					alreadyAssigned = true
					break
				end
			end
		end
		if not alreadyAssigned then
			for index = 1, InventoryConfig.hotbarSize do
				if hotbar[index] == InventoryConfig.emptySlot then
					local updated = table.clone(hotbar)
					updated[index] = instanceId
					data.hotbar(updated)
					break
				end
			end
		end
	end

	readyPlayers[player] = true
	scheduleSync(player)
	return instanceId
end

function InventoryServiceServer:equipGrantedEgg(player: Player, instanceId: string): number?
	if player.Parent ~= Players then
		return nil
	end
	local data = Data[player]
	if not data then
		return nil
	end
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[instanceId]
	local itemId = if item then item.itemId else nil
	local eggId = if typeof(itemId) == "string" then string.match(itemId, "^Egg%.([%w_]+)$") else nil
	if not eggId or not Eggs.get(eggId) or not isAvailable(item) then
		return nil
	end

	local hotbar = normalizeHotbar(data, player)
	local equippedId: string? = nil
	local character = player.Character
	if character then
		for _, child in character:GetChildren() do
			if child:IsA("Tool") then
				local currentId = child:GetAttribute("ItemInstanceId")
				if typeof(currentId) == "string" then
					equippedId = currentId
					break
				end
			end
		end
	end

	local targetId = instanceId
	local targetSlot: number? = nil
	for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
		local assignedId = hotbar[index]
		local assignedItem = inventory[assignedId]
		if assignedItem and assignedItem.itemId == itemId then
			targetId = assignedId
			targetSlot = index
			break
		end
	end
	if not targetSlot then
		for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
			if hotbar[index] == InventoryConfig.emptySlot then
				targetSlot = index
				break
			end
		end
		if not targetSlot then
			local heldSlot = if equippedId then table.find(hotbar, equippedId) else nil
			targetSlot = if heldSlot and heldSlot > InventoryConfig.hammerSlot then heldSlot else InventoryConfig.hotbarSize
		end
		local updated = table.clone(hotbar)
		updated[targetSlot :: number] = instanceId
		data.hotbar(updated)
	end

	readyPlayers[player] = true
	syncTools(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if backpack and character and humanoid and humanoid.Health > 0 and character == player.Character then
		local targetTool: Tool? = nil
		for _, container in { backpack, character } do
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("ItemInstanceId") == targetId then
					targetTool = child
					break
				end
			end
			if targetTool then
				break
			end
		end
		if targetTool and targetTool.Parent == backpack then
			humanoid:EquipTool(targetTool)
		end
	end
	return targetSlot
end

function InventoryServiceServer:setHotbarSlot(player: Player, instanceId: any, slotIndex: any)
	if typeof(instanceId) ~= "string" or typeof(slotIndex) ~= "number" then
		return
	end
	if slotIndex % 1 ~= 0 or slotIndex <= InventoryConfig.hammerSlot or slotIndex > InventoryConfig.hotbarSize then
		return
	end
	if player.Parent ~= Players then
		return
	end

	local data = Data.Service:waitForData(player)
	if not data or player.Parent ~= Players then
		return
	end
	readyPlayers[player] = true
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[instanceId]
	if typeof(item) ~= "table" or typeof(item.itemId) ~= "string" or item.placedSlotId ~= nil or item.incubatorInstanceId ~= nil or item.tankInstanceId ~= nil or item.itemId == InventoryConfig.hammerItemId or not isHotbarEligible(item.itemId) then
		return
	end
	local hotbar = normalizeHotbar(data, player)
	if ItemCatalog.isStackable(item.itemId) then
		for _, assignedId in hotbar do
			local assignedItem = inventory[assignedId]
			if assignedItem and assignedItem.itemId == item.itemId then
				instanceId = assignedId
				break
			end
		end
	end
	local sourceIndex: number? = nil
	for index, assignedId in hotbar do
		if assignedId == instanceId then
			sourceIndex = index
			break
		end
	end
	if sourceIndex == slotIndex then
		return
	end

	local updated = table.clone(hotbar)
	if sourceIndex then
		updated[sourceIndex] = hotbar[slotIndex]
	end
	updated[slotIndex] = instanceId
	data.hotbar(updated)
	normalizeHotbar(data, player)
	scheduleSync(player)
end

function InventoryServiceServer:removeHotbarSlot(player: Player, instanceId: any)
	if typeof(instanceId) ~= "string" or player.Parent ~= Players then
		return
	end

	local data = Data.Service:waitForData(player)
	if not data or player.Parent ~= Players then
		return
	end
	readyPlayers[player] = true
	local inventory = data.inventory() :: SavedInventory
	if not inventory[instanceId] or inventory[instanceId].itemId == InventoryConfig.hammerItemId then
		return
	end

	local hotbar = normalizeHotbar(data, player)
	for index, assignedId in hotbar do
		if assignedId == instanceId then
			local updated = table.clone(hotbar)
			updated[index] = InventoryConfig.emptySlot
			data.hotbar(updated)
			scheduleSync(player)
			return
		end
	end
end

function InventoryServiceServer:startIncubation(player: Player, incubatorInstanceId: string): (string?, string?, number?)
	if not readyPlayers[player] or player.Parent ~= Players then
		return nil, nil, nil
	end
	local data = Data[player]
	local inventory = data.inventory() :: SavedInventory
	local incubatorItem = inventory[incubatorInstanceId]
	if typeof(incubatorItem) ~= "table" or incubatorItem.itemId ~= "Incubator"
		or typeof(incubatorItem.placedSlotId) ~= "string" then
		return nil, nil, nil
	end
	for _, item in inventory do
		if typeof(item) == "table" and item.incubatorInstanceId == incubatorInstanceId then
			return nil, nil, nil
		end
	end
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local hotbar = data.hotbar() :: { string }
	for _, child in character:GetChildren() do
		if not child:IsA("Tool") then
			continue
		end
		local instanceId = child:GetAttribute("ItemInstanceId")
		local itemId = child:GetAttribute("ItemId")
		if typeof(instanceId) ~= "string" or typeof(itemId) ~= "string" then
			continue
		end
		local eggId = string.match(itemId, "^Egg%.([%w_]+)$")
		local item = inventory[instanceId]
		if not eggId or not Eggs.get(eggId) or typeof(item) ~= "table" or item.itemId ~= itemId
			or item.placedSlotId ~= nil or item.incubatorInstanceId ~= nil or item.tankInstanceId ~= nil
			or table.find(hotbar, instanceId) == nil then
			continue
		end
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		local eggs = if assets then assets:FindFirstChild("Eggs") else nil
		local template = if eggs then eggs:FindFirstChild(eggId) else nil
		local crabId = if template then template:GetAttribute("CrabId") else nil
		if typeof(crabId) ~= "string" or not Crabs.get(crabId) then
			return nil, nil, nil
		end
		local crabs = if assets then assets:FindFirstChild("Crabs") else nil
		local crabTemplate = if crabs then crabs:FindFirstChild(crabId) else nil
		if not crabTemplate or not crabTemplate:IsA("Model") then
			return nil, nil, nil
		end

		local hatchAtUnixMs = DateTime.now().UnixTimestampMillis + 3000
		local updated = table.clone(item)
		updated.incubatorInstanceId = incubatorInstanceId
		updated.hatchAtUnixMs = hatchAtUnixMs
		data.inventory[instanceId](updated)
		child:Destroy()
		scheduleSync(player)
		return instanceId, eggId, hatchAtUnixMs
	end
	return nil, nil, nil
end

function InventoryServiceServer:completeIncubation(player: Player, eggInstanceId: string, incubatorInstanceId: string, hatchAtUnixMs: number): (boolean, string?, number?)
	if player.Parent ~= Players or DateTime.now().UnixTimestampMillis < hatchAtUnixMs then
		return false, nil, nil
	end
	local data = Data[player]
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[eggInstanceId]
	if typeof(item) ~= "table" or item.incubatorInstanceId ~= incubatorInstanceId
		or item.hatchAtUnixMs ~= hatchAtUnixMs then
		return false, nil, nil
	end
	local eggId = string.match(item.itemId, "^Egg%.([%w_]+)$")
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local eggs = if assets then assets:FindFirstChild("Eggs") else nil
	local template = if eggId and eggs then eggs:FindFirstChild(eggId) else nil
	local crabId = if template then template:GetAttribute("CrabId") else nil
	local crabDefinition = if typeof(crabId) == "string" then Crabs.get(crabId) else nil
	local crabs = if assets then assets:FindFirstChild("Crabs") else nil
	local crabTemplate = if crabDefinition and crabs then crabs:FindFirstChild(crabDefinition.modelName) else nil
	if not crabTemplate or not crabTemplate:IsA("Model") then
		warn("Cannot hatch egg without a valid crab model:", item.itemId)
		local recovered = table.clone(item)
		recovered.incubatorInstanceId = nil
		recovered.hatchAtUnixMs = nil
		data.inventory[eggInstanceId](recovered)
		scheduleSync(player)
		return true, nil, nil
	end
	local updated = table.clone(item)
	updated.itemId = "Crab." .. crabId
	local weightGrams = CrabWeights.roll()
	updated.weightGrams = weightGrams
	updated.hatchAtUnixMs = nil
	data.inventory[eggInstanceId](updated)
	if data.discoveredCrabs()[crabId] ~= true then
		data.discoveredCrabs[crabId](true)
	end
	normalizeHotbar(data, player)
	scheduleSync(player)
	return true, crabId, weightGrams
end

function InventoryServiceServer:claimHatchedCrab(player: Player, instanceId: any)
	if typeof(instanceId) ~= "string" or #instanceId > 64 or player.Parent ~= Players then
		return
	end
	local data = Data.Service:waitForData(player)
	if not data or player.Parent ~= Players then
		return
	end
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[instanceId]
	if typeof(item) ~= "table" or not string.match(item.itemId, "^Crab%.[%w_]+$")
		or item.incubatorInstanceId == nil or item.hatchAtUnixMs ~= nil then
		return
	end
	local updated = table.clone(item)
	updated.incubatorInstanceId = nil
	data.inventory[instanceId](updated)
	local hotbar = normalizeHotbar(data, player)
	local targetSlot = table.find(hotbar, instanceId)
	if not targetSlot then
		for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
			if hotbar[index] == InventoryConfig.emptySlot then
				targetSlot = index
				break
			end
		end
	end
	if not targetSlot then
		local heldId: string? = nil
		local character = player.Character
		if character then
			for _, child in character:GetChildren() do
				if child:IsA("Tool") then
					local currentId = child:GetAttribute("ItemInstanceId")
					if typeof(currentId) == "string" then
						heldId = currentId
						break
					end
				end
			end
		end
		local heldSlot = if heldId then table.find(hotbar, heldId) else nil
		targetSlot = if heldSlot and heldSlot > InventoryConfig.hammerSlot then heldSlot else InventoryConfig.hotbarSize
	end
	if hotbar[targetSlot :: number] ~= instanceId then
		local updatedHotbar = table.clone(hotbar)
		updatedHotbar[targetSlot :: number] = instanceId
		data.hotbar(updatedHotbar)
	end
	scheduleSync(player)
end

function InventoryServiceServer:repairIncubations(player: Player, active: { [string]: string })
	local data = Data[player]
	local inventory = data.inventory() :: SavedInventory
	local repaired = {}
	for instanceId, item in inventory do
		if typeof(item) == "table" and item.incubatorInstanceId ~= nil
			and (active[item.incubatorInstanceId] ~= instanceId
				or string.match(item.itemId, "^Egg%.([%w_]+)$") == nil
				or typeof(item.hatchAtUnixMs) ~= "number") then
			local updated = table.clone(item)
			updated.incubatorInstanceId = nil
			updated.hatchAtUnixMs = nil
			data.inventory[instanceId](updated)
			table.insert(repaired, instanceId)
		end
	end
	if #repaired == 0 then
		return
	end
	table.sort(repaired)
	local hotbar = normalizeHotbar(data, player)
	local updatedHotbar = table.clone(hotbar)
	for _, instanceId in repaired do
		for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
			if updatedHotbar[index] == InventoryConfig.emptySlot then
				updatedHotbar[index] = instanceId
				break
			end
		end
	end
	data.hotbar(updatedHotbar)
	scheduleSync(player)
end

function InventoryServiceServer:refreshTools(player: Player)
	if not readyPlayers[player] or player.Parent ~= Players then
		return
	end
	normalizeHotbar(Data[player], player)
	scheduleSync(player)
end

function InventoryServiceServer:getHotbarSlot(player: Player, instanceId: string): number?
	local data = Data[player]
	if not data then
		return nil
	end
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[instanceId]
	if not item then
		return nil
	end
	local hotbar = normalizeHotbar(data, player)
	local directSlot = table.find(hotbar, instanceId)
	if directSlot then
		return directSlot
	end
	if ItemCatalog.isStackable(item.itemId) then
		for index, assignedId in hotbar do
			local assignedItem = inventory[assignedId]
			if assignedItem and assignedItem.itemId == item.itemId then
				return index
			end
		end
	end
	return nil
end
return InventoryServiceServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="587">
        <Properties>
          <string name="Name">Monetization</string>
        </Properties>
        <Item class="Folder" referent="588">
          <Properties>
            <string name="Name">Handlers</string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="589">
        <Properties>
          <string name="Name">Plots</string>
        </Properties>
        <Item class="Folder" referent="590">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="591">
            <Properties>
              <string name="Name">PlotServer</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlotExtraSlots = require(ReplicatedStorage.Source.Features.Plots.Modules.PlotExtraSlots)

local SLOT_IDS = {
	Left1 = true,
	Left2 = true,
	Left3 = true,
	Right1 = true,
	Right2 = true,
	Right3 = true,
}

local PlotServer = {}
PlotServer.__index = PlotServer

export type PlotServer = typeof(setmetatable({} :: {
	index: number,
	spawn: BasePart,
	model: Model,
	spawnBase: BasePart,
	placementSlots: Folder,
	floorModels: { [number]: Model },
	extraSlotsPurchased: number,
	placedFolder: Folder,
	placedModels: { [string]: Model },
	owner: Player?,
	characterConnection: RBXScriptConnection?,
}, PlotServer))

function PlotServer.new(index: number, spawn: BasePart, template: Model, parent: Folder): PlotServer?
	local model = template:Clone()
	local spawnBase = model:FindFirstChild("PlaypenBase")
	local placementSlots = model:FindFirstChild("PlacementSlots")
	if not spawnBase or not spawnBase:IsA("BasePart")
		or not placementSlots or not placementSlots:IsA("Folder") then
		warn("Plot template needs PlaypenBase and PlacementSlots")
		model:Destroy()
		return nil
	end
	for slotId in SLOT_IDS do
		local slot = placementSlots:FindFirstChild(slotId)
		if not slot or not slot:IsA("BasePart") then
			warn("Plot template needs " .. slotId)
			model:Destroy()
			return nil
		end
	end
	local floorModels: { [number]: Model } = {}
	for floorIndex, floorName in PlotExtraSlots.floorNames do
		local floor = model:FindFirstChild(floorName)
		local deck = if floor then floor:FindFirstChild("Deck") else nil
		local mainDeck = if deck then deck:FindFirstChild("MainDeck") else nil
		if not floor or not floor:IsA("Model") or not mainDeck or not mainDeck:IsA("BasePart") then
			warn("Plot template needs " .. floorName .. ".Deck.MainDeck")
			model:Destroy()
			return nil
		end
		floorModels[floorIndex + 1] = floor
	end

	model.Name = "Plot_" .. index
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:PivotTo(spawn.CFrame)
	for _, floor in floorModels do
		floor.Parent = nil
	end
	model:SetAttribute("Index", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("ConveyorLuck", 0)
	model:SetAttribute("ExtraSlotsPurchased", 0)

	local placedFolder = Instance.new("Folder")
	placedFolder.Name = "PlacedItems"
	placedFolder.Parent = model
	model.Parent = parent

	return setmetatable({
		index = index,
		spawn = spawn,
		model = model,
		spawnBase = spawnBase,
		placementSlots = placementSlots,
		floorModels = floorModels,
		extraSlotsPurchased = 0,
		placedFolder = placedFolder,
		placedModels = {} :: { [string]: Model },
		owner = nil :: Player?,
		characterConnection = nil :: RBXScriptConnection?,
	}, PlotServer) :: PlotServer
end

function PlotServer.getOwner(self: PlotServer): Player?
	return self.owner
end

function PlotServer.getSlot(self: PlotServer, slotId: string): BasePart?
	local purchaseNumber = PlotExtraSlots.getPurchaseNumber(slotId)
	if not SLOT_IDS[slotId] and (not purchaseNumber or purchaseNumber > self.extraSlotsPurchased) then
		return nil
	end
	local slot = self.placementSlots:FindFirstChild(slotId)
	return if slot and slot:IsA("BasePart") then slot else nil
end

function PlotServer.unlockNextSlot(self: PlotServer): boolean
	local purchaseNumber = self.extraSlotsPurchased + 1
	local floorNumber, baseId, slotId = PlotExtraSlots.getSlotInfo(purchaseNumber)
	if not floorNumber or not baseId or not slotId then
		return false
	end
	local floor = self.floorModels[floorNumber]
	local deck = if floor then floor:FindFirstChild("Deck") else nil
	local mainDeck = if deck then deck:FindFirstChild("MainDeck") else nil
	local baseSlot = self.placementSlots:FindFirstChild(baseId)
	if not floor or not mainDeck or not mainDeck:IsA("BasePart")
		or not baseSlot or not baseSlot:IsA("BasePart") or self.placementSlots:FindFirstChild(slotId) then
		return false
	end

	local slot = baseSlot:Clone()
	slot.Name = slotId
	local deckTop = mainDeck.Position.Y + mainDeck.Size.Y / 2
	local baseTop = baseSlot.Position.Y + baseSlot.Size.Y / 2
	slot.CFrame = baseSlot.CFrame + Vector3.new(0, deckTop - baseTop + 0.05, 0)
	if floor.Parent ~= self.model then
		floor.Parent = self.model
	end
	slot.Parent = self.placementSlots
	self.extraSlotsPurchased = purchaseNumber
	self.model:SetAttribute("ExtraSlotsPurchased", purchaseNumber)
	return true
end

function PlotServer.unlockThrough(self: PlotServer, purchasedCount: number): boolean
	local target = PlotExtraSlots.normalizeCount(purchasedCount)
	while self.extraSlotsPurchased < target do
		if not self:unlockNextSlot() then
			return false
		end
	end
	return true
end

function PlotServer.getPlaced(self: PlotServer, slotId: string): Model?
	return self.placedModels[slotId]
end

function PlotServer.addPlaced(self: PlotServer, slotId: string, placedModel: Model): boolean
	if not self:getSlot(slotId) or self.placedModels[slotId] then
		return false
	end
	self.placedModels[slotId] = placedModel
	placedModel:SetAttribute("SlotId", slotId)
	placedModel.Parent = self.placedFolder
	return true
end

function PlotServer.removePlaced(self: PlotServer, slotId: string)
	local placedModel = self.placedModels[slotId]
	if placedModel then
		self.placedModels[slotId] = nil
		placedModel:Destroy()
	end
end

function PlotServer.clearPlaced(self: PlotServer)
	for slotId in self.placedModels do
		self:removePlaced(slotId)
	end
end

function PlotServer.teleportCharacter(self: PlotServer, player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or self.owner ~= player or player.Character ~= character or not character.Parent then
		return
	end

	character:PivotTo(self.spawnBase.CFrame * CFrame.new(0, self.spawnBase.Size.Y / 2 + 4, 0))
end

function PlotServer.claim(self: PlotServer, player: Player): boolean
	if self.owner then
		return false
	end

	self.owner = player
	self.model:SetAttribute("OwnerUserId", player.UserId)
	self.model:SetAttribute("ConveyorLuck", 0)
	self.characterConnection = player.CharacterAdded:Connect(function(character)
		task.spawn(PlotServer.teleportCharacter, self, player, character)
	end)

	if player.Character then
		task.spawn(PlotServer.teleportCharacter, self, player, player.Character)
	end

	return true
end

function PlotServer.release(self: PlotServer)
	if self.characterConnection then
		self.characterConnection:Disconnect()
		self.characterConnection = nil
	end
	self:clearPlaced()
	for purchaseNumber = 1, self.extraSlotsPurchased do
		local _, _, slotId = PlotExtraSlots.getSlotInfo(purchaseNumber)
		local slot = if slotId then self.placementSlots:FindFirstChild(slotId) else nil
		if slot then
			slot:Destroy()
		end
	end
	for _, floor in self.floorModels do
		floor.Parent = nil
	end
	self.extraSlotsPurchased = 0
	self.owner = nil
	self.model:SetAttribute("OwnerUserId", 0)
	self.model:SetAttribute("ConveyorLuck", 0)
	self.model:SetAttribute("ExtraSlotsPurchased", 0)
end

function PlotServer.destroy(self: PlotServer)
	self:release()
	for _, floor in self.floorModels do
		floor:Destroy()
	end
	self.model:Destroy()
end

return PlotServer
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="592">
          <Properties>
            <string name="Name">PlotServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Data = require(ReplicatedStorage.Source.Game.Data).server
local InventoryConfig = require(ReplicatedStorage.Source.Features.Inventory.InventoryConfig)
local InventoryServiceServer = require(ServerScriptService.Features.Inventory.InventoryServiceServer)
local IncubatorServiceServer = require(ServerScriptService.Features.Incubators.IncubatorServiceServer)
local TankServiceServer = require(ServerScriptService.Features.Tanks.TankServiceServer)
local EggConveyorServiceServer = require(ServerScriptService.Features.EggConveyor.EggConveyorServiceServer)
local Networker = require(ReplicatedStorage.Packages.Networker)
local PlotServer = require(script.Parent.Classes.PlotServer)
local PlotExtraSlots = require(ReplicatedStorage.Source.Features.Plots.Modules.PlotExtraSlots)
local Tanks = require(ReplicatedStorage.Source.Features.Tanks.Modules.Tanks)

type SavedItem = { itemId: string, placedSlotId: string?, incubatorInstanceId: string?, tankInstanceId: string? }
type SavedInventory = { [string]: SavedItem }

local MAX_INTERACTION_DISTANCE = 10

local PlotServiceServer = {}
local initialized = false
local plots: { [number]: PlotServer.PlotServer } = {}
local playerPlots: { [Player]: PlotServer.PlotServer } = {}
local waiting: { Player } = {}
local waitingSet: { [Player]: boolean } = {}
local lastTravel: { [Player]: number } = {}
local buyingExtraSlot: { [Player]: boolean } = {}

local function getTemplate(itemId: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	local folder: Instance?
	local modelName: string?
	if itemId == "Incubator" then
		folder = assets:FindFirstChild("Incubators")
		modelName = "Incubator"
	else
		local tankId = string.match(itemId, "^Tank%.([%w_]+)$")
		local definition = if tankId then Tanks.get(tankId) else nil
		if definition then
			folder = assets:FindFirstChild("Tanks")
			modelName = definition.modelName
		end
	end
	local template = if folder and modelName then folder:FindFirstChild(modelName) else nil
	return if template and template:IsA("Model") and template.PrimaryPart then template else nil
end

local function makePlacedModel(itemId: string, instanceId: string, slot: BasePart): Model?
	local template = getTemplate(itemId)
	if not template then
		return nil
	end
	local model = template:Clone()
	local boxCFrame, boxSize = model:GetBoundingBox()
	if boxSize.Y <= 0 then
		model:Destroy()
		return nil
	end
	local pivotToBottom = model:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	model:PivotTo(slot.CFrame * CFrame.new(0, slot.Size.Y / 2 + pivotToBottom, 0))
	model.Name = itemId .. "_" .. instanceId
	model:SetAttribute("ItemInstanceId", instanceId)
	model:SetAttribute("ItemId", itemId)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
		end
	end
	return model
end

local function inRange(player: Player, slot: BasePart): boolean
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	return root ~= nil and root:IsA("BasePart") and humanoid ~= nil and humanoid.Health > 0
		and (root.Position - slot.Position).Magnitude <= MAX_INTERACTION_DISTANCE
end

local function equippedTool(player: Player, instanceId: string, itemId: string): Tool?
	local character = player.Character
	if not character then
		return nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ItemInstanceId") == instanceId and child:GetAttribute("ItemId") == itemId then
			return child
		end
	end
	return nil
end

local function clearPlacement(data: any, instanceId: string, item: SavedItem)
	local updated = table.clone(item)
	updated.placedSlotId = nil
	data.inventory[instanceId](updated)
end

local function restorePlayer(player: Player, plot: PlotServer.PlotServer)
	local data = Data.Service:waitForData(player)
	if not data or player.Parent ~= Players or playerPlots[player] ~= plot or plot:getOwner() ~= player then
		return
	end
	if not plot:unlockThrough(PlotExtraSlots.normalizeCount(data.extraSlotsPurchased())) then
		warn("Could not restore extra slots for", player.Name)
		return
	end
	local inventory = data.inventory() :: SavedInventory
	local instanceIds: { string } = {}
	for instanceId, item in inventory do
		if typeof(item) == "table" and typeof(item.placedSlotId) == "string" then
			table.insert(instanceIds, instanceId)
		end
	end
	table.sort(instanceIds)

	local repaired = false
	for _, instanceId in instanceIds do
		if player.Parent ~= Players or playerPlots[player] ~= plot or plot:getOwner() ~= player then
			return
		end
		local item = inventory[instanceId]
		local slotId = item.placedSlotId
		local slot = if slotId then plot:getSlot(slotId) else nil
		if not slot or plot:getPlaced(slotId :: string) then
			clearPlacement(data, instanceId, item)
			repaired = true
			continue
		end
		local model = makePlacedModel(item.itemId, instanceId, slot)
		if not model or not plot:addPlaced(slotId :: string, model) then
			if model then
				model:Destroy()
			end
			clearPlacement(data, instanceId, item)
			repaired = true
		elseif item.itemId == "Incubator" then
			if not IncubatorServiceServer:registerPlaced(player, plot.model, model, instanceId) then
				plot:removePlaced(slotId :: string)
				clearPlacement(data, instanceId, item)
				repaired = true
			end
		elseif string.match(item.itemId, "^Tank%.([%w_]+)$") then
			if not TankServiceServer:registerPlaced(player, plot.model, model, instanceId) then
				plot:removePlaced(slotId :: string)
				clearPlacement(data, instanceId, item)
				repaired = true
			end
		end
	end
	local active: { [string]: string } = {}
	for _, model in plot.placedModels do
		if model:GetAttribute("ItemId") == "Incubator" then
			local incubatorId = model:GetAttribute("ItemInstanceId")
			local eggId = IncubatorServiceServer:getPlacedEggId(model)
			if typeof(incubatorId) == "string" and eggId then
				active[incubatorId] = eggId
			end
		end
	end
	InventoryServiceServer:repairIncubations(player, active)
	TankServiceServer:restoreContents(player)
	if repaired then
		InventoryServiceServer:refreshTools(player)
	end
end

local function assignWaiting()
	while #waiting > 0 do
		local freePlot: PlotServer.PlotServer? = nil
		for index = 1, 6 do
			local plot = plots[index]
			if plot and not plot:getOwner() then
				freePlot = plot
				break
			end
		end
		if not freePlot then
			return
		end

		local player = table.remove(waiting, 1)
		waitingSet[player] = nil
		if player.Parent == Players and not playerPlots[player] and freePlot:claim(player) then
			playerPlots[player] = freePlot
			task.spawn(restorePlayer, player, freePlot)
		end
	end
end

local function playerAdded(player: Player)
	if playerPlots[player] or waitingSet[player] then
		return
	end
	table.insert(waiting, player)
	waitingSet[player] = true
	assignWaiting()
end

local function playerRemoving(player: Player)
	lastTravel[player] = nil
	buyingExtraSlot[player] = nil
	if waitingSet[player] then
		local position = table.find(waiting, player)
		if position then
			table.remove(waiting, position)
		end
		waitingSet[player] = nil
	end

	local plot = playerPlots[player]
	if plot then
		playerPlots[player] = nil
		EggConveyorServiceServer:stop(plot.model)
		TankServiceServer:clearPlacedForPlayer(player)
		IncubatorServiceServer:clearPlacedForPlayer(player)
		plot:release()
		assignWaiting()
	end
end

function PlotServiceServer:init()
	if initialized then
		return
	end

	local template = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Plot") :: Model
	local folder = Workspace:FindFirstChild("SpawnedPlots")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "SpawnedPlots"
		folder.Parent = Workspace
	end
	if not folder:IsA("Folder") then
		warn("SpawnedPlots must be a Folder")
		return
	end

	for _, tagged in CollectionService:GetTagged("PlotSpawn") do
		if not tagged:IsA("BasePart") then
			warn("Skipping PlotSpawn that is not a BasePart")
			continue
		end
		local index = tagged:GetAttribute("Index")
		if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 6 then
			warn("Skipping PlotSpawn with invalid Index")
			continue
		end
		if plots[index] then
			warn("Skipping duplicate PlotSpawn Index", index)
			continue
		end
		local plot = PlotServer.new(index, tagged, template, folder)
		if plot then
			plots[index] = plot
		end
	end
	for index = 1, 6 do
		if not plots[index] then
			warn("Missing PlotSpawn Index", index)
		end
	end

	Networker.server.new("PlotPlacement", self, { self.place, self.pickup, self.travel, self.buyExtraSlot })
	initialized = true
	Players.PlayerAdded:Connect(playerAdded)
	Players.PlayerRemoving:Connect(playerRemoving)
	for _, player in Players:GetPlayers() do
		playerAdded(player)
	end
end

function PlotServiceServer:getPlot(player: Player): PlotServer.PlotServer?
	return playerPlots[player]
end

function PlotServiceServer:buyExtraSlot(player: Player)
	if buyingExtraSlot[player] or player.Parent ~= Players then
		return
	end
	buyingExtraSlot[player] = true
	local ok, err = pcall(function()
		local data = Data.Service:waitForData(player)
		local plot = playerPlots[player]
		if not data or player.Parent ~= Players or not plot or plot:getOwner() ~= player then
			return
		end
		local sign = plot.model:FindFirstChild("ExtraSlotSign")
		local panel = if sign then sign:FindFirstChild("FrontPanel") else nil
		if not panel or not panel:IsA("BasePart") then
			return
		end
		local count = PlotExtraSlots.normalizeCount(data.extraSlotsPurchased())
		if not plot:unlockThrough(count) then
			return
		end
		local price = PlotExtraSlots.getPrice(count)
		local money = data.money()
		if not price or typeof(money) ~= "number" or money ~= money or money < price then
			return
		end
		if not plot:unlockNextSlot() then
			return
		end
		data.money(money - price)
		data.extraSlotsPurchased(count + 1)
	end)
	buyingExtraSlot[player] = nil
	if not ok then
		warn("Extra slot purchase failed for", player.Name, err)
	end
end

function PlotServiceServer:travel(player: Player, destination: any)
	if destination ~= "Home" and destination ~= "Shop" then
		return
	end
	local plot = playerPlots[player]
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not plot or plot:getOwner() ~= player or not character or not humanoid or humanoid.Health <= 0
		or not root or not root:IsA("BasePart") then
		return
	end
	local now = os.clock()
	if now - (lastTravel[player] or -math.huge) < 1 then
		return
	end
	if destination == "Home" then
		lastTravel[player] = now
		plot:teleportCharacter(player, character)
		return
	end

	local stand = Workspace:FindFirstChild("ShopStand")
	local noob = if stand then stand:FindFirstChild("Noob") else nil
	local torso = if noob then noob:FindFirstChild("Torso") else nil
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local front = torso.Position + torso.CFrame.LookVector * 5
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	local hit = Workspace:Raycast(front + Vector3.new(0, 10, 0), Vector3.new(0, -50, 0), rayParams)
	if not hit or hit.Normal.Y < 0.7 then
		return
	end
	lastTravel[player] = now
	local target = hit.Position + Vector3.new(0, 3.5, 0)
	character:PivotTo(CFrame.lookAt(target, Vector3.new(torso.Position.X, target.Y, torso.Position.Z)))
end
function PlotServiceServer:place(player: Player, instanceId: any, slotId: any)
	if typeof(instanceId) ~= "string" or typeof(slotId) ~= "string" then
		return
	end
	local plot = playerPlots[player]
	local slot = if plot then plot:getSlot(slotId) else nil
	if not plot or plot:getOwner() ~= player or not slot or plot:getPlaced(slotId) or not inRange(player, slot) then
		return
	end
	local data = Data[player]
	if not data then
		return
	end
	local inventory = data.inventory() :: SavedInventory
	local item = inventory[instanceId]
	if typeof(item) ~= "table" or typeof(item.itemId) ~= "string" or item.placedSlotId ~= nil
		or item.incubatorInstanceId ~= nil or item.tankInstanceId ~= nil then
		return
	end
	if not equippedTool(player, instanceId, item.itemId) then
		return
	end
	for _, other in inventory do
		if typeof(other) == "table" and other.placedSlotId == slotId then
			return
		end
	end

	local model = makePlacedModel(item.itemId, instanceId, slot)
	if not model then
		return
	end
	if not plot:addPlaced(slotId, model) then
		model:Destroy()
		return
	end
	local tankId = string.match(item.itemId, "^Tank%.([%w_]+)$")
	if tankId and not TankServiceServer:registerPlaced(player, plot.model, model, instanceId) then
		plot:removePlaced(slotId)
		return
	end

	local updatedItem = table.clone(item)
	updatedItem.placedSlotId = slotId
	data.inventory[instanceId](updatedItem)
	if item.itemId == "Incubator" then
		IncubatorServiceServer:registerPlaced(player, plot.model, model, instanceId)
	end
	InventoryServiceServer:refreshTools(player)
end

function PlotServiceServer:pickup(player: Player, slotId: any)
	if typeof(slotId) ~= "string" then
		return
	end
	local plot = playerPlots[player]
	local slot = if plot then plot:getSlot(slotId) else nil
	local model = if plot then plot:getPlaced(slotId) else nil
	if not plot or plot:getOwner() ~= player or not slot or not model or not inRange(player, slot) then
		return
	end
	local instanceId = model:GetAttribute("ItemInstanceId")
	if typeof(instanceId) ~= "string" then
		return
	end
	local data = Data[player]
	if not data then
		return
	end
	local inventory = data.inventory() :: SavedInventory
	local hammerId = InventoryConfig.hammerInstanceId(player.UserId)
	local hammer = inventory[hammerId]
	local hotbar = data.hotbar() :: { string }
	if not hammer or hammer.itemId ~= InventoryConfig.hammerItemId
		or hotbar[InventoryConfig.hammerSlot] ~= hammerId
		or not equippedTool(player, hammerId, InventoryConfig.hammerItemId) then
		return
	end
	local item = inventory[instanceId]
	if typeof(item) ~= "table" or item.placedSlotId ~= slotId then
		return
	end
	if item.itemId == "Incubator" then
		if IncubatorServiceServer:isOccupied(model) then
			return
		end
		for _, other in inventory do
			if typeof(other) == "table" and other.incubatorInstanceId == instanceId then
				return
			end
		end
		IncubatorServiceServer:unregisterPlaced(model)
	end
	if string.match(item.itemId, "^Tank%.([%w_]+)$") then
		if TankServiceServer:isOccupied(model) then
			return
		end
		for _, other in inventory do
			if typeof(other) == "table" and other.tankInstanceId == instanceId then
				return
			end
		end
		TankServiceServer:unregisterPlaced(model)
	end

	clearPlacement(data, instanceId, item)
	plot:removePlaced(slotId)
	for index = InventoryConfig.hammerSlot + 1, InventoryConfig.hotbarSize do
		if hotbar[index] == InventoryConfig.emptySlot then
			local updatedHotbar = table.clone(hotbar)
			updatedHotbar[index] = instanceId
			data.hotbar(updatedHotbar)
			break
		end
	end
	InventoryServiceServer:refreshTools(player)
end

return PlotServiceServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="593">
        <Properties>
          <string name="Name">Shop</string>
        </Properties>
        <Item class="ModuleScript" referent="594">
          <Properties>
            <string name="Name">ShopServiceServer</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Data = require(ReplicatedStorage.Source.Game.Data).server
local Networker = require(ReplicatedStorage.Packages.Networker)
local Tanks = require(ReplicatedStorage.Source.Features.Tanks.Modules.Tanks)
local InventoryServiceServer = require(ServerScriptService.Features.Inventory.InventoryServiceServer)
local ShopConfig = require(ReplicatedStorage.Source.Features.Shop.ShopConfig)
local ShopStock = require(ReplicatedStorage.Source.Features.Shop.Modules.ShopStock)

local ShopServiceServer = {}
local initialized = false
local networker = nil
local stockByPlayer: { [Player]: ShopStock.Stock } = {}
local buying: { [Player]: boolean } = {}
local rng = Random.new()
local interval = ShopConfig.restockIntervalSeconds
local nextRefreshAt = math.floor(Workspace:GetServerTimeNow() / interval + 1) * interval

local function sendStock(player: Player, restocked: boolean?)
	local stock = stockByPlayer[player]
	if networker and stock and player.Parent == Players then
		networker:fire(player, "updateStock", table.clone(stock), nextRefreshAt, restocked == true)
	end
end

local function rollStock(player: Player, restocked: boolean?)
	stockByPlayer[player] = ShopStock.roll(ShopConfig.items, rng)
	sendStock(player, restocked)
end

local function confirmPurchase(player: Player, requestId: any, instanceId: string?)
	if not instanceId or typeof(requestId) ~= "string" or #requestId > 64
		or not networker or player.Parent ~= Players then
		return
	end
	local slotIndex = InventoryServiceServer:getHotbarSlot(player, instanceId) or 0
	networker:fire(player, "showPurchasedItem", requestId, slotIndex)
end

local function showNotEnoughMoney(player: Player, requestId: any)
	if networker and player.Parent == Players and typeof(requestId) == "string" and #requestId <= 64 then
		networker:fire(player, "showNotEnoughMoney", requestId)
	end
end

local function purchase(player: Player, itemId: string, inventoryId: string, requestId: any)
	if player.Parent ~= Players or buying[player] then
		return
	end
	local price = ShopConfig.getPrice(itemId)
	if not price then
		return
	end

	buying[player] = true
	local ok, instanceId = pcall(function()
		local data = Data.Service:waitForData(player)
		if not data or player.Parent ~= Players then
			return nil
		end
		local stock = stockByPlayer[player]
		local balance = data.money()
		if not stock or (stock[itemId] or 0) <= 0 then
			return nil
		end
		if typeof(balance) ~= "number" or balance ~= balance or balance < price then
			if typeof(balance) == "number" and balance < price then
				showNotEnoughMoney(player, requestId)
			end
			return nil
		end

		local grantedId = InventoryServiceServer:grantItem(player, inventoryId, function()
			local currentBalance = data.money()
			return player.Parent == Players and stockByPlayer[player] == stock
				and (stock[itemId] or 0) > 0 and typeof(currentBalance) == "number"
				and currentBalance >= price
		end)
		if not grantedId then
			local currentBalance = data.money()
			if typeof(currentBalance) == "number" and currentBalance < price then
				showNotEnoughMoney(player, requestId)
			end
			return nil
		end
		data.money(function(currentBalance: number)
			return currentBalance - price
		end)
		stock[itemId] -= 1
		sendStock(player)
		return grantedId
	end)
	buying[player] = nil
	if not ok then
		warn(`Shop purchase failed for {player.Name}: {instanceId}`)
	elseif instanceId then
		confirmPurchase(player, requestId, instanceId)
	end
end

function ShopServiceServer:init()
	if initialized then
		return
	end
	initialized = true

	networker = Networker.server.new("ShopService", self, { self.buyTank, self.buyIncubator, self.ready })
	Players.PlayerAdded:Connect(function(player)
		rollStock(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		stockByPlayer[player] = nil
		buying[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		rollStock(player)
	end

	task.spawn(function()
		while true do
			task.wait(math.max(0, nextRefreshAt - Workspace:GetServerTimeNow()))
			nextRefreshAt += interval
			for _, player in Players:GetPlayers() do
				rollStock(player, true)
			end
		end
	end)
end

function ShopServiceServer:ready(player: Player)
	if player.Parent ~= Players then
		return
	end
	if not stockByPlayer[player] then
		rollStock(player)
	else
		sendStock(player)
	end
end

function ShopServiceServer:buyTank(player: Player, tankId: any, requestId: any)
	if typeof(tankId) ~= "string" or not Tanks.get(tankId) then
		return
	end
	purchase(player, tankId, `Tank.{tankId}`, requestId)
end

function ShopServiceServer:buyIncubator(player: Player, requestId: any)
	purchase(player, "Incubator", "Incubator", requestId)
end

return ShopServiceServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="595">
        <Properties>
          <string name="Name">Tanks</string>
        </Properties>
        <Item class="Folder" referent="596">
          <Properties>
            <string name="Name">Classes</string>
          </Properties>
          <Item class="ModuleScript" referent="597">
            <Properties>
              <string name="Name">TankServer</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local CrabRigBuilder = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabRigBuilder)
local DecorConfig = require(ReplicatedStorage.Source.Features.DecorShop.DecorConfig)
local DecorPlacement = require(ReplicatedStorage.Source.Features.Tanks.Modules.TankDecorationPlacement)

local TankServer = {}
TankServer.__index = TankServer

export type TankServer = typeof(setmetatable({} :: {
	owner: Player,
	plotModel: Model,
	instanceId: string,
	tankId: string,
	model: Model,
	floor: BasePart,
	capacity: number,
	prompt: ProximityPrompt,
	visualFolder: Folder,
	decorFolder: Folder,
	decorations: { [number]: { instanceId: string, decorId: string, model: Model, x: number, z: number, width: number, depth: number } },
	moneyPad: Model?,
	baseIncomePerSecond: number,
	incomePerSecond: number,
	displayedEarnings: number,
	lastIncomeUpdate: number,
	wasOnMoneyPad: boolean,
	crabIds: { string },
	visuals: { [string]: BasePart },
	triggerConnection: RBXScriptConnection?,
	destroyed: boolean,
}, TankServer))

local function positions(count: number, floor: BasePart): { Vector2 }
	if count == 1 then
		return { Vector2.zero }
	end
	if count == 2 then
		local x = floor.Size.X * 0.23
		return { Vector2.new(-x, 0), Vector2.new(x, 0) }
	end
	local x = floor.Size.X * 0.23
	local z = floor.Size.Z * 0.2
	if count == 3 then
		return {
			Vector2.new(-x, z),
			Vector2.new(x, z),
			Vector2.new(0, -z),
		}
	end
	return {
		Vector2.new(-x, z),
		Vector2.new(x, z),
		Vector2.new(-x, -z),
		Vector2.new(x, -z),
	}
end

local function maxFootprint(self: TankServer): number
	if self.capacity == 1 then
		return math.min(2.5, self.floor.Size.X * 0.65, self.floor.Size.Z * 0.65)
	elseif self.capacity == 2 then
		return math.min(2, self.floor.Size.X * 0.38, self.floor.Size.Z * 0.65)
	end
	return math.min(2, self.floor.Size.X * 0.3, self.floor.Size.Z * 0.3)
end

local function placeMoneyPad(plotModel: Model, model: Model): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local template = if assets then assets:FindFirstChild("MoneyPad") else nil
	local slots = plotModel:FindFirstChild("PlacementSlots")
	local slotId = model:GetAttribute("SlotId")
	if not template or not template:IsA("Model") or not slots or typeof(slotId) ~= "string" then
		warn("Money pad template or tank slot missing:", model:GetFullName())
		return nil
	end
	local side = string.match(slotId, "^(Left)") or string.match(slotId, "^(Right)")
	if not side then return nil end
	local own = slots:FindFirstChild(side .. "1")
	local opposite = slots:FindFirstChild((if side == "Left" then "Right" else "Left") .. "1")
	local slot = slots:FindFirstChild(slotId)
	if not own or not own:IsA("BasePart") or not opposite or not opposite:IsA("BasePart")
		or not slot or not slot:IsA("BasePart") then return nil end
	local inward = opposite.Position - own.Position
	inward = Vector3.new(inward.X, 0, inward.Z).Unit
	local box, size = model:GetBoundingBox()
	local halfDepth = (math.abs(box.RightVector:Dot(inward)) * size.X
		+ math.abs(box.LookVector:Dot(inward)) * size.Z) / 2
	local pad = template:Clone()
	local padPivot = pad:GetPivot()
	local bottom = math.huge
	local padRadius = 0
	for _, part in pad:GetDescendants() do
		if part:IsA("BasePart") then
			local frame = part.CFrame
			local partSize = part.Size
			local halfY = (math.abs(frame.RightVector.Y) * partSize.X
				+ math.abs(frame.UpVector.Y) * partSize.Y
				+ math.abs(frame.LookVector.Y) * partSize.Z) / 2
			bottom = math.min(bottom, part.Position.Y - halfY)
			padRadius = math.max(padRadius, partSize.Y / 2, partSize.Z / 2)
		end
	end
	if bottom == math.huge then
		pad:Destroy()
		return nil
	end
	local pivotToBottom = padPivot.Position.Y - bottom
	local surfaceY = slot.Position.Y + slot.Size.Y / 2
	local target = box.Position + inward * (halfDepth + padRadius + 0.5)
	pad:PivotTo(CFrame.new(target.X, surfaceY + pivotToBottom, target.Z) * padPivot.Rotation)
	for _, descendant in pad:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = true
			descendant.CanTouch = false
		end
	end
	local green = pad:FindFirstChild("GreenInnerCircle")
	if green and green:IsA("BasePart") then
		local collectionSound = Instance.new("Sound")
		collectionSound.Name = "CollectionSound"
		collectionSound.SoundId = "rbxassetid://4612383453"
		collectionSound.Volume = 1
		collectionSound.RollOffMaxDistance = 35
		collectionSound.Parent = green
	end
	pad.Name = "MoneyPad"
	pad.Parent = model
	return pad
end

function TankServer.new(owner: Player, plotModel: Model, instanceId: string, tankId: string, model: Model, capacity: number, onPlace: (Player) -> ()): TankServer?
	local floor = model:FindFirstChild("InsideFloor", true)
	if not floor or not floor:IsA("BasePart") then
		warn("Placed tank needs InsideFloor:", model:GetFullName())
		return nil
	end

	local visualFolder = Instance.new("Folder")
	visualFolder.Name = "ContainedCrabs"
	visualFolder.Parent = model
	local decorFolder = Instance.new("Folder")
	decorFolder.Name = "ContainedDecorations"
	decorFolder.Parent = model

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PlaceCrabPrompt"
	prompt.ActionText = "Place Crab"
	prompt.ObjectText = "Tank"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = floor

	model:SetAttribute("TankCapacity", capacity)
	model:SetAttribute("ContainedCrabCount", 0)
	model:SetAttribute("IncomePerSecond", 0)
	model:SetAttribute("TankIncomeBoostPercent", 0)
	model:SetAttribute("MoneyPadBaseAmount", 0)
	model:SetAttribute("MoneyPadCollectionSerial", 0)
	local now = Workspace:GetServerTimeNow()
	model:SetAttribute("MoneyPadUpdatedAt", now)
	local moneyPad = placeMoneyPad(plotModel, model)

	local self = setmetatable({
		owner = owner,
		plotModel = plotModel,
		instanceId = instanceId,
		tankId = tankId,
		model = model,
		floor = floor,
		capacity = capacity,
		prompt = prompt,
		visualFolder = visualFolder,
		decorFolder = decorFolder,
		decorations = {},
		moneyPad = moneyPad,
		baseIncomePerSecond = 0,
		incomePerSecond = 0,
		displayedEarnings = 0,
		lastIncomeUpdate = now,
		wasOnMoneyPad = false,
		crabIds = {} :: { string },
		visuals = {} :: { [string]: BasePart },
		triggerConnection = nil :: RBXScriptConnection?,
		destroyed = false,
	}, TankServer) :: TankServer

	self.triggerConnection = prompt.Triggered:Connect(onPlace)
	return self
end

local function settleIncome(self: TankServer)
	local now = Workspace:GetServerTimeNow()
	self.displayedEarnings += self.incomePerSecond * math.max(0, now - self.lastIncomeUpdate)
	self.lastIncomeUpdate = now
	self.model:SetAttribute("MoneyPadBaseAmount", self.displayedEarnings)
	self.model:SetAttribute("MoneyPadUpdatedAt", now)
end

local function refreshIncome(self: TankServer)
	local decorIds: { string } = {}
	for _, placed in self.decorations do
		table.insert(decorIds, placed.decorId)
	end
	local boostPercent = DecorConfig.getTankBoostPercent(decorIds)
	self.incomePerSecond = self.baseIncomePerSecond * (1 + boostPercent / 100)
	self.model:SetAttribute("IncomePerSecond", self.incomePerSecond)
	self.model:SetAttribute("TankIncomeBoostPercent", boostPercent)
end

function TankServer.canAdd(self: TankServer): boolean
	return not self.destroyed and #self.crabIds < self.capacity
end

function TankServer.isOccupied(self: TankServer): boolean
	return #self.crabIds > 0 or next(self.decorations) ~= nil
end

function TankServer.addDecoration(self: TankServer, slot: number, instanceId: string, decorId: string, x: number, z: number, rotation: number): boolean
	if self.destroyed or not DecorPlacement.isRotation(rotation) or slot % 1 ~= 0
		or slot < 1 or slot > DecorPlacement.slotCount or self.decorations[slot]
		or not DecorConfig.get(decorId) then
		return false
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local templates = if assets then assets:FindFirstChild("Decorations") else nil
	local template = if templates then templates:FindFirstChild(decorId) else nil
	if not template or not template:IsA("Model") then
		return false
	end
	local model = template:Clone()
	local size = DecorPlacement.prepare(model, self.floor)
	if not size or not DecorPlacement.fits(self.floor, size, x, z, rotation) then
		model:Destroy()
		return false
	end
	local width, depth = DecorPlacement.footprint(size, rotation)
	for _, placed in self.decorations do
		if DecorPlacement.overlaps(x, z, width, depth, placed.x, placed.z, placed.width, placed.depth) then
			model:Destroy()
			return false
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		end
	end
	model.Name = "ContainedDecoration"
	model:SetAttribute("ItemInstanceId", instanceId)
	model:SetAttribute("DecorId", decorId)
	model:SetAttribute("DecorSlot", slot)
	model:SetAttribute("DecorX", x)
	model:SetAttribute("DecorZ", z)
	model:SetAttribute("DecorWidth", width)
	model:SetAttribute("DecorDepth", depth)
	model:PivotTo(DecorPlacement.pivotOnFloor(model, self.floor, x, z, rotation))
	model.Parent = self.decorFolder
	settleIncome(self)
	self.decorations[slot] = { instanceId = instanceId, decorId = decorId, model = model, x = x, z = z, width = width, depth = depth }
	refreshIncome(self)
	return true
end

function TankServer.removeDecoration(self: TankServer, slot: number, instanceId: string): boolean
	local placed = self.decorations[slot]
	if self.destroyed or not placed or placed.instanceId ~= instanceId then
		return false
	end
	settleIncome(self)
	self.decorations[slot] = nil
	placed.model:Destroy()
	refreshIncome(self)
	return true
end

function TankServer.enteredMoneyPad(self: TankServer): boolean
	local onPad = false
	local pad = self.moneyPad
	local green = if pad then pad:FindFirstChild("GreenInnerCircle") else nil
	local character = self.owner.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not self.destroyed and green and green:IsA("BasePart")
		and root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		local offset = root.Position - green.Position
		local radius = math.min(green.Size.Y, green.Size.Z) / 2 + 0.3
		onPad = Vector2.new(offset.X, offset.Z).Magnitude <= radius
			and offset.Y >= 0 and offset.Y <= 4.5
	end
	local entered = onPad and not self.wasOnMoneyPad
	self.wasOnMoneyPad = onPad
	return entered
end

function TankServer.collectableAmount(self: TankServer): (number, number)
	local now = Workspace:GetServerTimeNow()
	local completedSeconds = math.max(0, math.floor(now - self.lastIncomeUpdate))
	return self.displayedEarnings + self.incomePerSecond * completedSeconds, now
end

function TankServer.resetMoneyPad(self: TankServer, now: number)
	self.displayedEarnings = 0
	self.lastIncomeUpdate = now
	self.model:SetAttribute("MoneyPadBaseAmount", 0)
	self.model:SetAttribute("MoneyPadUpdatedAt", now)
end

function TankServer.relayout(self: TankServer)
	local slots = positions(#self.crabIds, self.floor)
	for index, crabInstanceId in self.crabIds do
		local anchor = self.visuals[crabInstanceId]
		local position = slots[index]
		local pivotToBottom = anchor:GetAttribute("PivotToBottom")
		if typeof(pivotToBottom) == "number" then
			anchor.CFrame = self.floor.CFrame * CFrame.new(
				position.X,
				self.floor.Size.Y / 2 + pivotToBottom,
				position.Y
			)
		end
	end
end

function TankServer.addCrab(self: TankServer, crabInstanceId: string, crabId: string, weightGrams: number?): boolean
	if not self:canAdd() or self.visuals[crabInstanceId] then
		return false
	end

	local definition = Crabs.get(crabId)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local crabs = if assets then assets:FindFirstChild("Crabs") else nil
	local template = if definition and crabs then crabs:FindFirstChild(definition.modelName) else nil
	if not template or not template:IsA("Model") then
		warn("Missing crab model for tank:", crabId)
		return false
	end

	local sample = template:Clone()
	if not CrabRigBuilder.rig(sample) then
		sample:Destroy()
		return false
	end
	local _, size = sample:GetBoundingBox()
	if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
		sample:Destroy()
		return false
	end
	local footprint = maxFootprint(self)
	local scale = math.min(footprint / size.X, 2 / size.Y, footprint / size.Z)
	sample:ScaleTo(sample:GetScale() * scale * CrabWeights.scale(weightGrams))
	local boxCFrame, boxSize = sample:GetBoundingBox()
	local pivotToBottom = sample:GetPivot().Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	local displayScale = sample:GetScale()
	sample:Destroy()

	local anchor = Instance.new("Part")
	anchor.Name = "ContainedCrabAnchor"
	anchor.Size = Vector3.new(0.05, 0.05, 0.05)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor:SetAttribute("ItemInstanceId", crabInstanceId)
	anchor:SetAttribute("CrabId", crabId)
	anchor:SetAttribute("DisplayScale", displayScale)
	anchor:SetAttribute("WeightGrams", CrabWeights.normalize(weightGrams))
	anchor:SetAttribute("PivotToBottom", pivotToBottom)
	anchor.Parent = self.visualFolder

	self.visuals[crabInstanceId] = anchor
	table.insert(self.crabIds, crabInstanceId)
	self:relayout()
	self.model:SetAttribute("ContainedCrabCount", #self.crabIds)
	settleIncome(self)
	self.baseIncomePerSecond += CrabWeights.income(definition.incomePerSecond, weightGrams)
	refreshIncome(self)
	self.prompt.Enabled = self:canAdd()
	return true
end

function TankServer.removeCrab(self: TankServer, crabInstanceId: string, crabId: string): boolean
	local anchor = self.visuals[crabInstanceId]
	local index = table.find(self.crabIds, crabInstanceId)
	local definition = Crabs.get(crabId)
	if self.destroyed or not anchor or not index or not definition or anchor:GetAttribute("CrabId") ~= crabId then
		return false
	end

	settleIncome(self)
	self.baseIncomePerSecond = math.max(0, self.baseIncomePerSecond - CrabWeights.income(definition.incomePerSecond, anchor:GetAttribute("WeightGrams")))

	self.visuals[crabInstanceId] = nil
	table.remove(self.crabIds, index)
	anchor:Destroy()
	self:relayout()
	self.model:SetAttribute("ContainedCrabCount", #self.crabIds)
	refreshIncome(self)
	self.prompt.Enabled = self:canAdd()
	return true
end

function TankServer.destroy(self: TankServer)
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self.triggerConnection then
		self.triggerConnection:Disconnect()
		self.triggerConnection = nil
	end
	self.prompt:Destroy()
	if self.moneyPad then
		self.moneyPad:Destroy()
		self.moneyPad = nil
	end
	self.visualFolder:Destroy()
	self.decorFolder:Destroy()
	table.clear(self.visuals)
	table.clear(self.crabIds)
end

return TankServer
