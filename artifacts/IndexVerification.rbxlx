    </Properties>
    <Item class="Folder" referent="564">
      <Properties>
        <string name="Name">Core</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="565">
      <Properties>
        <string name="Name">Features</string>
      </Properties>
      <Item class="Folder" referent="566">
        <Properties>
          <string name="Name">Crabs</string>
