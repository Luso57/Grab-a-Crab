              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="486">
              <Properties>
                <string name="Name">EggBillboard</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Rarities = require(ReplicatedStorage.Source.Game.Items.Rarities)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local create = Vide.create

local EggBillboard = {}

local function makeLine(name: string, value: string, color: Color3, order: number): TextLabel
    local label = create "TextLabel" {
        Name = name,
        LayoutOrder = order,
        Size = UDim2.fromScale(1, 1 / 3),
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = color,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        TextStrokeTransparency = 0,
        TextScaled = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Center,
        Font = Enum.Font.BuilderSansExtraBold,
    }
    local stroke = create "UIStroke" {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
        Color = Color3.new(0, 0, 0),
        Thickness = 1.5,
    }
    stroke.Parent = label
    return label
end

function EggBillboard.create(driver: BasePart, topOffset: number, eggName: string, rarity: Rarities.Rarity, price: number): BillboardGui
    local billboard = create "BillboardGui" {
        Name = "EggInfoBillboard",
        Adornee = driver,
        Size = UDim2.fromScale(7.6, 3),
        SizeOffset = Vector2.new(0, 0.5),
        StudsOffsetWorldSpace = Vector3.new(0, topOffset + 0.15, 0),
        MaxDistance = 50,
        AlwaysOnTop = true,
        LightInfluence = 0,
    }
    local container = create "Frame" {
        Name = "Lines",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
    }
    container.Parent = billboard
    local layout = create "UIListLayout" {
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }
    layout.Parent = container
    local rarityLine = makeLine("Rarity", rarity, Rarities.getColor(rarity), 1)
    rarityLine.Parent = container
    local nameLine = makeLine("EggName", eggName, Color3.new(1, 1, 1), 2)
    nameLine.Parent = container
    local priceLine = makeLine("Price", if price == 0 then "FREE" else "$" .. CompactNumber.format(price), Color3.fromRGB(75, 235, 100), 3)
    priceLine.Parent = container
    return billboard
end

return EggBillboard
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="487">
          <Properties>
            <string name="Name">EggConveyor</string>
          </Properties>
          <Item class="ModuleScript" referent="488">
            <Properties>
              <string name="Name">EggConveyorServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Networker = require(ReplicatedStorage.Packages.Networker)
local Data = require(ReplicatedStorage.Source.Game.Data).client
local LuckSign = require(ReplicatedStorage.Source.Features.EggConveyor.UI.LuckSign)
local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local EggBillboard = require(ReplicatedStorage.Source.Features.Egg.UI.EggBillboard)
local EggMoneyWarning = require(ReplicatedStorage.Source.Features.EggConveyor.UI.EggMoneyWarning)
local PlotServiceClient = require(ReplicatedStorage.Source.Features.Plots.PlotServiceClient)

local EggConveyorServiceClient = {}
local initialized = false
local mounted: { [Model]: { cleanup: () -> (), destroying: RBXScriptConnection } } = {}
local mountedSigns: { [Model]: () -> () } = {}
local showMoneyWarning: (() -> ())? = nil
local purchaseSound: Sound? = nil

local function unmountEgg(model: Model)
    local binding = mounted[model]
    if not binding then
        return
    end
    mounted[model] = nil
    binding.destroying:Disconnect()
    binding.cleanup()
end

local function mountEgg(instance: Instance)
    if not instance:IsA("Model") or mounted[instance] then
        return
    end
    local activeFolder = instance.Parent
    if not activeFolder or activeFolder.Name ~= "ActiveEggs"
        or not activeFolder.Parent or activeFolder.Parent.Name ~= "EggConveyor" then
        return
    end
    local eggId = instance:GetAttribute("EggId")
    local crabId = instance:GetAttribute("CrabId")
    if typeof(eggId) ~= "string" or typeof(crabId) ~= "string" then
        return
    end
    local egg = Eggs.get(eggId)
    local crab = Crabs.get(crabId)
    local driver = instance:FindFirstChild("ConveyorDriver")
    if not egg or not crab or Eggs.getCrabId(eggId) ~= crabId or not driver or not driver:IsA("BasePart") then
        return
    end
    local boxCFrame, boxSize = instance:GetBoundingBox()
    local topOffset = boxCFrame.Position.Y + boxSize.Y / 2 - driver.Position.Y
    local cleanup = Vide.mount(function()
        return EggBillboard.create(driver, topOffset, egg.name, crab.rarity, egg.price)
    end, instance)
    local destroying = instance.Destroying:Connect(function()
        unmountEgg(instance)
    end)
    mounted[instance] = { cleanup = cleanup, destroying = destroying }
end

function EggConveyorServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local spawnedPlots = Workspace:WaitForChild("SpawnedPlots")
	spawnedPlots.DescendantAdded:Connect(mountEgg)
	spawnedPlots.DescendantRemoving:Connect(function(instance)
		if instance:IsA("Model") then
			unmountEgg(instance)
		end
	end)
	for _, instance in spawnedPlots:GetDescendants() do
		mountEgg(instance)
	end

	local networker = Networker.client.new("EggConveyor", self)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	local sound = Instance.new("Sound")
	sound.Name = "EggPurchaseSound"
	sound.SoundId = "rbxassetid://4612383453"
	sound.Volume = 1
	sound.Parent = playerGui
	purchaseSound = sound
	showMoneyWarning = EggMoneyWarning.mount(playerGui)
	local balance = Vide.source(Data.money())
	Data.money.Changed(function(value: number)
		balance(value)
	end)
	local function unmountSign(instance: Instance)
		if instance:IsA("Model") and mountedSigns[instance] then
			mountedSigns[instance]()
			mountedSigns[instance] = nil
		end
	end
	local function mountSign(instance: Instance)
		if not instance:IsA("Model") or mountedSigns[instance] then
			return
		end
		local cleanup = LuckSign.mount(instance, playerGui, balance, function()
			networker:fire("buyUpgrade")
		end)
		if cleanup then
			mountedSigns[instance] = cleanup
		end
	end
	spawnedPlots.ChildAdded:Connect(mountSign)
	spawnedPlots.ChildRemoved:Connect(unmountSign)
	for _, plot in spawnedPlots:GetChildren() do
		mountSign(plot)
	end
	task.spawn(function()
		if not game:IsLoaded() then
			game.Loaded:Wait()
		end
		local player = Players.LocalPlayer
		while player.Parent == Players do
			local plot = PlotServiceClient:getLocalPlot()
			local character = player.Character
			if plot and character and character:FindFirstChild("HumanoidRootPart") then
				networker:fire("ready")
				return
			end
			task.wait(0.1)
		end
	end)
end

function EggConveyorServiceClient:showNotEnoughMoney()
	local show = showMoneyWarning
	if show then
		show()
	end
end

function EggConveyorServiceClient:eggPurchased()
	local sound = purchaseSound
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

return EggConveyorServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="489">
            <Properties>
              <string name="Name">Modules</string>
            </Properties>
            <Item class="ModuleScript" referent="490">
              <Properties>
                <string name="Name">LuckConfig</string>
                <string name="Source"><![CDATA[--!strict

local rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

-- Each row is a percentage distribution. Locked rarities have zero chance.
-- New rarities enter at a small chance
-- and become more common with further luck purchases.
local keyframes = {
	{ luck = 0, odds = { 85, 15, 0, 0, 0, 0 } },
	{ luck = 90, odds = { 70, 30, 0, 0, 0, 0 } },
	{ luck = 100, odds = { 69.5, 30, 0.5, 0, 0, 0 } },
	{ luck = 190, odds = { 50, 35, 15, 0, 0, 0 } },
	{ luck = 200, odds = { 49.8, 34.8, 15, 0.4, 0, 0 } },
	{ luck = 290, odds = { 35, 32, 25, 8, 0, 0 } },
	{ luck = 300, odds = { 34.9, 31.9, 25, 8, 0.2, 0 } },
	{ luck = 390, odds = { 25, 28, 25, 18, 4, 0 } },
	{ luck = 400, odds = { 24.95, 27.95, 25, 18, 4, 0.1 } },
	{ luck = 500, odds = { 20, 25, 25, 20, 9, 1 } },
}

local FIRST_UPGRADE_PRICE = 10000

local LuckConfig = {
	LUCK_PER_UPGRADE = 10,
	MAX_LUCK = 500,
}

function LuckConfig.normalizeLuck(value: any): number
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return 0
	end
	return math.clamp(math.floor(value / LuckConfig.LUCK_PER_UPGRADE) * LuckConfig.LUCK_PER_UPGRADE, 0, LuckConfig.MAX_LUCK)
end

function LuckConfig.getUpgradePrice(luck: number): number?
	local normalized = LuckConfig.normalizeLuck(luck)
	if normalized >= LuckConfig.MAX_LUCK then
		return nil
	end
	local purchases = normalized / LuckConfig.LUCK_PER_UPGRADE
	local price = FIRST_UPGRADE_PRICE * (1 + 0.1 * purchases) ^ 4
	return math.floor(price + 0.5)
end

export type RarityWeight = { rarity: string, weight: number }

function LuckConfig.getWeights(luck: number): { RarityWeight }
	local normalized = LuckConfig.normalizeLuck(luck)
	local lower = keyframes[1]
	local upper = keyframes[#keyframes]
	for index = 2, #keyframes do
		if normalized <= keyframes[index].luck then
			upper = keyframes[index]
			lower = keyframes[index - 1]
			break
		end
	end

	local progress = (normalized - lower.luck) / (upper.luck - lower.luck)
	local weights: { RarityWeight } = {}
	for index, rarity in rarities do
		local chance = lower.odds[index] + (upper.odds[index] - lower.odds[index]) * progress
		table.insert(weights, { rarity = rarity, weight = chance })
	end
	return weights
end

return LuckConfig
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="491">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="492">
              <Properties>
                <string name="Name">EggMoneyWarning</string>
                <string name="Source">--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create

local EggMoneyWarning = {}

function EggMoneyWarning.mount(playerGui: PlayerGui): () -&gt; ()
	local banner: Frame = nil :: any
	local label: TextLabel = nil :: any
	local stroke: UIStroke = nil :: any
	local sound: Sound = nil :: any

	Vide.mount(function()
		stroke = create "UIStroke" {
			Color = Color3.fromRGB(42, 0, 0),
			Thickness = 3,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}
		label = create "TextLabel" {
			Name = "Message",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = "NOT ENOUGH MONEY",
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			TextScaled = true,
			Font = Enum.Font.BuilderSansExtraBold,
			ZIndex = 2,
		}
		stroke.Parent = label
		create "UITextSizeConstraint" {
			MaxTextSize = 30,
		}.Parent = label
		banner = create "Frame" {
			Name = "Banner",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 1 / 3),
			Size = UDim2.new(0.78, 0, 0, 48),
			BackgroundColor3 = Color3.fromRGB(218, 38, 38),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
		}
		create "UIGradient" {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(139, 14, 18)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 73, 73)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(139, 14, 18)),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.16, 0),
				NumberSequenceKeypoint.new(0.84, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}.Parent = banner
		label.Parent = banner
		sound = create "Sound" {
			Name = "EggMoneySound",
			SoundId = "rbxassetid://550209561",
			Volume = 1,
		}
		local gui = create "ScreenGui" {
			Name = "EggMoneyWarning",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 51,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
		banner.Parent = gui
		sound.Parent = gui
		return gui
	end, playerGui)

	local version = 0
	return function()
		version += 1
		local currentVersion = version
		banner.Visible = true
		banner.BackgroundTransparency = 1
		label.TextTransparency = 1
		stroke.Transparency = 1
		sound.TimePosition = 0
		sound:Play()

		TweenService:Create(banner, TweenInfo.new(0.25), { BackgroundTransparency = 0.3 }):Play()
		TweenService:Create(label, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 0 }):Play()

		task.delay(1.5, function()
			if version ~= currentVersion then
				return
			end
			TweenService:Create(banner, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			local fade = TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 })
			fade.Completed:Once(function()
				if version == currentVersion then
					banner.Visible = false
				end
			end)
			fade:Play()
		end)
	end
end

return EggMoneyWarning</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="493">
              <Properties>
                <string name="Name">LuckSign</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local LuckConfig = require(ReplicatedStorage.Source.Features.EggConveyor.Modules.LuckConfig)

local create = Vide.create
local LuckSign = {}
local CLOVER_IMAGE = "rbxassetid://84144870802466"

function LuckSign.mount(plotModel: Model, playerGui: PlayerGui, balance: () -> number, onBuy: () -> ()): (() -> ())?
    local sign = plotModel:FindFirstChild("MoreLuckSign")
    local panel = if sign then sign:FindFirstChild("FrontPanel") else nil
    if not panel or not panel:IsA("BasePart") then
        return nil
    end

    local luck = Vide.source(LuckConfig.normalizeLuck(plotModel:GetAttribute("ConveyorLuck")))
    local owner = Vide.source(plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId)
    local luckConnection = plotModel:GetAttributeChangedSignal("ConveyorLuck"):Connect(function()
        luck(LuckConfig.normalizeLuck(plotModel:GetAttribute("ConveyorLuck")))
    end)
    local ownerConnection = plotModel:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
        owner(plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId)
    end)

    local cleanup = Vide.mount(function()
    local luckText = Vide.derive(function()
        return "LUCK " .. tostring(luck()) .. "%"
    end)
    local oddsText = Vide.derive(function()
        local weights = LuckConfig.getWeights(luck())
        return string.format(
            "C %.1f%%  U %.1f%%  R %.1f%%\nE %.1f%%  L %.1f%%  M %.1f%%",
            weights[1].weight, weights[2].weight, weights[3].weight,
            weights[4].weight, weights[5].weight, weights[6].weight
        )
    end)
    local buyText = Vide.derive(function()
        local price = LuckConfig.getUpgradePrice(luck())
        if not price then
            return "MAX LUCK"
        end
        return "BUY $" .. CompactNumber.format(price)
    end)
    local canBuy = Vide.derive(function()
        local price = LuckConfig.getUpgradePrice(luck())
        return owner() and price ~= nil and balance() >= (price or math.huge)
    end)
    local buttonColor = Vide.derive(function()
        local price = LuckConfig.getUpgradePrice(luck())
        if not owner() or not price then
            return Color3.fromRGB(115, 115, 115)
        end
        return if balance() < price then Color3.fromRGB(220, 48, 48) else Color3.fromRGB(32, 205, 75)
    end)
    local buttonStrokeColor = Vide.derive(function()
        local price = LuckConfig.getUpgradePrice(luck())
        if not owner() or not price then
            return Color3.fromRGB(65, 65, 65)
        end
        return if balance() < price then Color3.fromRGB(105, 15, 15) else Color3.fromRGB(9, 65, 33)
    end)
    local buySound = create "Sound" {
        Name = "BuyClickSound",
        SoundId = "rbxassetid://4612383453",
        Volume = 1,
    }
        return create "SurfaceGui" {
            Name = "MoreLuckUpgrade",
            Adornee = panel,
            Face = Enum.NormalId.Front,
            SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
            PixelsPerStud = 80,
            LightInfluence = 0,
            AlwaysOnTop = false,
            Active = true,
            ToolPunchThroughDistance = 20,
            ResetOnSpawn = false,
            create "Frame" {
                Name = "Content",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                create "TextLabel" {
                    Name = "Title",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.1),
                    Size = UDim2.fromScale(0.94, 0.14),
                    BackgroundTransparency = 1,
                    Text = "MORE LUCK",
                    Font = Enum.Font.BuilderSansExtraBold,
                    TextColor3 = Color3.new(1, 1, 1),
                    TextScaled = true,
                    create "UIStroke" {
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
                        Color = Color3.new(0, 0, 0),
                        Thickness = 3,
                    },
                },
                create "ImageLabel" {
                    Name = "CloverImage",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.36),
                    Size = UDim2.fromScale(0.72, 0.32),
                    BackgroundTransparency = 1,
                    Image = CLOVER_IMAGE,
                    ScaleType = Enum.ScaleType.Fit,
                },
                create "TextLabel" {
                    Name = "LuckPercent",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.6),
                    Size = UDim2.fromScale(0.9, 0.13),
                    BackgroundTransparency = 1,
                    Text = luckText,
                    Font = Enum.Font.BuilderSansExtraBold,
                    TextColor3 = Color3.fromRGB(0, 238, 30),
                    TextScaled = true,
                    create "UIStroke" {
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
                        Color = Color3.new(0, 0, 0),
                        Thickness = 4,
                    },
                },
                create "TextLabel" {
                    Name = "RarityOdds",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.75),
                    Size = UDim2.fromScale(0.96, 0.15),
                    BackgroundTransparency = 1,
                    Text = oddsText,
                    Font = Enum.Font.BuilderSansBold,
                    TextColor3 = Color3.new(1, 1, 1),
                    TextScaled = true,
                    TextWrapped = true,
                    create "UIStroke" {
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
                        Color = Color3.new(0, 0, 0),
                        Thickness = 2,
                    },
                },
                create "TextButton" {
                    Name = "BuyUpgrade",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.91),
                    Size = UDim2.fromScale(0.7, 0.14),
                    BackgroundColor3 = buttonColor,
                    BorderSizePixel = 0,
                    AutoButtonColor = canBuy,
                    Active = canBuy,
                    Text = buyText,
                    Font = Enum.Font.BuilderSansExtraBold,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextStrokeColor3 = Color3.fromRGB(34, 23, 12),
                    TextStrokeTransparency = 0.35,
                    TextScaled = true,
                    Activated = function()
                        if canBuy() then
                            onBuy()
                            buySound.TimePosition = 0
                            buySound:Play()
                        end
                    end,
                    buySound,
                    create "UICorner" { CornerRadius = UDim.new(0.16, 0) },
                    create "UIStroke" { Color = buttonStrokeColor, Thickness = 4 },
                },
            },
        }
    end, playerGui)

    local function removeLegacyLettering(child: Instance)
        if child.Name == "Lettering" and child:IsA("SurfaceGui") then
            child:Destroy()
        end
    end
    local letteringConnection = panel.ChildAdded:Connect(removeLegacyLettering)
    local lettering = panel:FindFirstChild("Lettering")
    if lettering then
        removeLegacyLettering(lettering)
    end

    return function()
        letteringConnection:Disconnect()
        luckConnection:Disconnect()
        ownerConnection:Disconnect()
        cleanup()
    end
end

return LuckSign
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="494">
          <Properties>
            <string name="Name">Incubators</string>
          </Properties>
          <Item class="ModuleScript" referent="495">
            <Properties>
              <string name="Name">IncubatorServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Networker = require(ReplicatedStorage.Packages.Networker)

local IncubatorCountdown = require(script.Parent.UI.IncubatorCountdown)
local HatchReveal = require(script.Parent.UI.HatchReveal)
local InventoryServiceClient = require(ReplicatedStorage.Source.Features.Inventory.InventoryServiceClient)

local IncubatorServiceClient = {}
local initialized = false
local active: { [Model]: () -> () } = {}
local showReveal: ((string, number, string?, CFrame?, number?, Vector3?, string?) -> ())? = nil
local lockedPromptDistances: { [ProximityPrompt]: number } = {}
local promptLockConnection: RBXScriptConnection? = nil

local function lockIncubatorPrompt(instance: Instance)
	if not instance:IsA("ProximityPrompt")
		or (instance.Name ~= "PlaceEggPrompt" and instance.Name ~= "HatchEggPrompt")
		or lockedPromptDistances[instance] ~= nil then
		return
	end
	lockedPromptDistances[instance] = instance.MaxActivationDistance
	instance.MaxActivationDistance = 0
end

local function setIncubatorPromptsLocked(locked: boolean)
	if locked then
		if promptLockConnection then
			return
		end
		local spawnedPlots = Workspace:FindFirstChild("SpawnedPlots")
		if not spawnedPlots then
			return
		end
		promptLockConnection = spawnedPlots.DescendantAdded:Connect(lockIncubatorPrompt)
		for _, descendant in spawnedPlots:GetDescendants() do
			lockIncubatorPrompt(descendant)
		end
	else
		if promptLockConnection then
			promptLockConnection:Disconnect()
			promptLockConnection = nil
		end
		for prompt, distance in lockedPromptDistances do
			if prompt.Parent then
				prompt.MaxActivationDistance = distance
			end
		end
		table.clear(lockedPromptDistances)
	end
end

local function addEgg(instance: Instance)
	if not instance:IsA("Model") or instance.Name ~= "IncubatingEgg" or active[instance] then
		return
	end
	local incubator = instance.Parent
	if not incubator or not incubator:IsA("Model") then
		return
	end
	active[instance] = IncubatorCountdown.attach(instance, incubator)
end

local function removeEgg(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local cleanup = active[instance]
	if cleanup then
		active[instance] = nil
		cleanup()
	end
end

function IncubatorServiceClient:showHatch(
	crabId: string,
	weightGrams: number,
	eggId: string?,
	eggPivot: CFrame?,
	eggScale: number?,
	viewDirection: Vector3?,
	instanceId: string?
)
	if typeof(crabId) == "string" and typeof(weightGrams) == "number" and showReveal then
		local hatchedInstanceId = if typeof(instanceId) == "string" then instanceId else nil
		if typeof(eggId) == "string" and typeof(eggPivot) == "CFrame"
			and typeof(eggScale) == "number" and eggScale > 0 then
			showReveal(crabId, weightGrams, eggId, eggPivot, eggScale, if typeof(viewDirection) == "Vector3" then viewDirection else nil, hatchedInstanceId)
		else
			showReveal(crabId, weightGrams, nil, nil, nil, nil, hatchedInstanceId)
		end
	end
end

function IncubatorServiceClient:init()
	if initialized then
		return
	end
	initialized = true
	showReveal = HatchReveal.mount(Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui, setIncubatorPromptsLocked, function(instanceId)
		InventoryServiceClient:equipHatchedCrab(instanceId)
	end)
	Networker.client.new("IncubatorService", self)
	local spawnedPlots = Workspace:WaitForChild("SpawnedPlots")
	spawnedPlots.DescendantAdded:Connect(addEgg)
	spawnedPlots.DescendantRemoving:Connect(removeEgg)
	for _, instance in spawnedPlots:GetDescendants() do
		addEgg(instance)
	end
end

return IncubatorServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="496">
            <Properties>
              <string name="Name">Modules</string>
            </Properties>
            <Item class="ModuleScript" referent="497">
              <Properties>
                <string name="Name">Incubators</string>
                <string name="Source"><![CDATA[--!strict

export type IncubatorDefinition = {
	name: string,
	modelName: string,
}

local definitions: { [string]: IncubatorDefinition } = {
	Incubator = { name = "Incubator", modelName = "Incubator" },
}

local Incubators = {}

function Incubators.get(incubatorId: string): IncubatorDefinition?
	return definitions[incubatorId]
end

return Incubators
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="498">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="499">
              <Properties>
                <string name="Name">HatchReveal</string>
                <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local uiAssets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)

local create = Vide.create
local HatchReveal = {}

local REVEAL_SECONDS = 3
local DISMISS_READY_SECONDS = 0.5
local CRAB_ROTATION_SECONDS = 3.5
local STARTING_ROTATION_MULTIPLIER = 10
local SPIN_DECAY_SECONDS = 0.6
local BURST_ROTATION_SECONDS = 5
local START_VISUAL_SCALE = 0.42
local CAMERA_REFERENCE_WEIGHT_GRAMS = 25
local CAMERA_PADDING = 1.85
local MIN_CAMERA_PADDING = 1.06
local EGG_ZOOM_SECONDS = 0.6
local EGG_SHAKE_SECONDS = 1.2
local SHAKE_SOUND_DELAY_SECONDS = 0.515
local FLASH_IN_SECONDS = 0.16
local FLASH_HOLD_SECONDS = 0.1
local FLASH_OUT_SECONDS = 0.2
local COUNT_SOUND_LENGTH_SECONDS = 5
local REVEAL_SOUND_SECONDS = 1
local REVEAL_SOUND_LENGTH_SECONDS = 2

local function textStroke(parent: TextLabel, thickness: number)
    local stroke = create "UIStroke" {
        Color = Color3.new(0, 0, 0),
        Thickness = thickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }
    stroke.Parent = parent
end

function HatchReveal.mount(playerGui: PlayerGui, setPromptsLocked: (boolean) -> (), onDismiss: (string) -> ()): (string, number, string?, CFrame?, number?, Vector3?, string?) -> ()
    local shakeSound = Instance.new("Sound")
    shakeSound.Name = "HatchShakeSound"
    shakeSound.SoundId = "rbxassetid://" .. uiAssets.HatchShakeSound
    shakeSound.Looped = true
    shakeSound.Volume = 1
    shakeSound.Parent = playerGui

    local countSound = Instance.new("Sound")
    countSound.Name = "HatchCountSound"
    countSound.SoundId = "rbxassetid://" .. uiAssets.HatchCountSound
    countSound.PlaybackSpeed = COUNT_SOUND_LENGTH_SECONDS / REVEAL_SECONDS
    countSound.Volume = 4
    countSound.Parent = playerGui

    local revealSound = Instance.new("Sound")
    revealSound.Name = "HatchRevealSound"
    revealSound.SoundId = "rbxassetid://" .. uiAssets.HatchRevealSound
    revealSound.PlaybackSpeed = REVEAL_SOUND_LENGTH_SECONDS / REVEAL_SOUND_SECONDS
    revealSound.Volume = 1
    revealSound.Parent = playerGui

    local visible = Vide.source(false)
    local revealVisible = Vide.source(false)
    local flashVisible = Vide.source(false)
    local flashTransparency = Vide.source(1)
    local crabName = Vide.source("")
    local gramText = Vide.source("0.00g")
    local incomeText = Vide.source("")
    local clickHintVisible = Vide.source(false)
    local viewport: ViewportFrame = nil :: any
    local burstImage: ImageLabel = nil :: any
    local readyToDismiss = false
    local dismiss = function() end

    Vide.mount(function()
    burstImage = create "ImageLabel" {
        Name = "HatchBurst",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.72, 0.72),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Image = "rbxassetid://" .. uiAssets.HatchBurst,
        ScaleType = Enum.ScaleType.Fit,
        Rotation = 0,
        ZIndex = 2,
    }
    local burstAspect = create "UIAspectRatioConstraint" {
        AspectRatio = 1,
        DominantAxis = Enum.DominantAxis.Width,
    }
    burstAspect.Parent = burstImage
    local burstSize = create "UISizeConstraint" {
        MaxSize = Vector2.new(560, 560),
    }
    burstSize.Parent = burstImage

    viewport = create "ViewportFrame" {
        Name = "CrabViewport",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.94, 0.78),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(210, 230, 220),
        LightColor = Color3.new(1, 1, 1),
        LightDirection = Vector3.new(-1, -1, -1),
        ZIndex = 3,
    }

    local nameLabel = create "TextLabel" {
        Name = "CrabName",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.16),
        Size = UDim2.fromScale(0.9, 0.095),
        BackgroundTransparency = 1,
        Text = crabName,
        TextColor3 = Color3.new(1, 1, 1),
        TextScaled = true,
        Font = Enum.Font.BuilderSansExtraBold,
        ZIndex = 4,
    }
    textStroke(nameLabel, 3)

    local gramsLabel = create "TextLabel" {
        Name = "Weight",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.26),
        Size = UDim2.fromScale(0.55, 0.09),
        BackgroundTransparency = 1,
        Text = gramText,
        TextColor3 = Color3.new(1, 1, 1),
        TextScaled = true,
        Font = Enum.Font.BuilderSansExtraBold,
        ZIndex = 4,
    }
    textStroke(gramsLabel, 3)

    local incomeRow = create "Frame" {
        Name = "IncomeRow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.83),
        Size = UDim2.fromOffset(0, 94),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex = 4,
    }
    local incomeLayout = create "UIListLayout" {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }
    incomeLayout.Parent = incomeRow
    local coinIcon = create "ImageLabel" {
        Name = "CoinIcon",
        LayoutOrder = 1,
        Size = UDim2.fromOffset(82, 82),
        BackgroundTransparency = 1,
        Image = "rbxassetid://" .. uiAssets.SandDollar,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 4,
    }
    coinIcon.Parent = incomeRow
    local incomeLabel = create "TextLabel" {
        Name = "Income",
        LayoutOrder = 2,
        Size = UDim2.fromOffset(0, 94),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Text = incomeText,
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 70,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.BuilderSansExtraBold,
        ZIndex = 4,
    }
    textStroke(incomeLabel, 4)
    incomeLabel.Parent = incomeRow

    local dismissButton = create "TextButton" {
        Name = "Dismiss",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Activated = function()
            dismiss()
        end,
    }
    local clickHint = create "TextLabel" {
        Name = "ContinueHint",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.94),
        Size = UDim2.fromScale(0.7, 0.045),
        BackgroundTransparency = 1,
        Text = "Click anywhere to continue",
        TextColor3 = Color3.new(1, 1, 1),
        TextScaled = true,
        Font = Enum.Font.BuilderSansBold,
        Visible = clickHintVisible,
        ZIndex = 6,
    }
    textStroke(clickHint, 2)

    local dimBackground = create "Frame" {
        Name = "DimBackground",
        Visible = revealVisible,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.42,
        BorderSizePixel = 0,
        ZIndex = 1,
    }
    burstImage.Parent = dimBackground
    viewport.Parent = dimBackground
    nameLabel.Parent = dimBackground
    gramsLabel.Parent = dimBackground
    incomeRow.Parent = dimBackground
    dismissButton.Parent = dimBackground
    clickHint.Parent = dimBackground

    local whiteFlash = create "Frame" {
        Name = "WhiteFlash",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = flashTransparency,
        BorderSizePixel = 0,
        Visible = flashVisible,
        ZIndex = 10,
    }
    local screen = create "ScreenGui" {
        Name = "HatchReveal",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
        Enabled = visible,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }
    dimBackground.Parent = screen
    whiteFlash.Parent = screen
    return screen
    end, playerGui)

    local runNumber = 0
    local activeInstanceId: string? = nil
    local connection: RBXScriptConnection? = nil
    local introConnection: RBXScriptConnection? = nil
    local world: WorldModel? = nil
    local camera: Camera? = nil
    local introEgg: Model? = nil
    local introCamera: Camera? = nil
    local previousCameraType: Enum.CameraType? = nil
    local previousCameraCFrame: CFrame? = nil
    local previousFieldOfView: number? = nil

    local function restoreIntro()
        local activeCamera = introCamera
        if activeCamera and activeCamera.Parent and Workspace.CurrentCamera == activeCamera then
            if previousCameraCFrame then
                activeCamera.CFrame = previousCameraCFrame
            end
            if previousFieldOfView then
                activeCamera.FieldOfView = previousFieldOfView
            end
            if previousCameraType then
                activeCamera.CameraType = previousCameraType
            end
        end
        introCamera = nil
        previousCameraType = nil
        previousCameraCFrame = nil
        previousFieldOfView = nil
        if introEgg then
            introEgg:Destroy()
            introEgg = nil
        end
    end

    local function cancel()
        runNumber += 1
        local instanceId = activeInstanceId
        activeInstanceId = nil
        shakeSound:Stop()
        countSound:Stop()
        revealSound:Stop()
        readyToDismiss = false
        clickHintVisible(false)
        burstImage.Rotation = 0
        if introConnection then
            introConnection:Disconnect()
            introConnection = nil
        end
        if connection then
            connection:Disconnect()
            connection = nil
        end
        restoreIntro()
        if world then
            world:Destroy()
            world = nil
        end
        if camera then
            camera:Destroy()
            camera = nil
            viewport.CurrentCamera = nil
        end
        flashTransparency(1)
        flashVisible(false)
        revealVisible(false)
        visible(false)
        setPromptsLocked(false)
        if instanceId then
            onDismiss(instanceId)
        end
    end

    dismiss = function()
        if readyToDismiss then
            cancel()
        end
    end

    Players.LocalPlayer.CharacterRemoving:Connect(cancel)

    local function startCrabReveal(crabId: string, weightGrams: number)
        local definition = Crabs.get(crabId)
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local models = if assets then assets:FindFirstChild("Crabs") else nil
        local template = if definition and models then models:FindFirstChild(definition.modelName) else nil
        if not definition or not template or not template:IsA("Model") then
            cancel()
            return
        end

        local model = template:Clone()
        local initialHeight = model:GetExtentsSize().Y
        if initialHeight <= 0 then
            model:Destroy()
            cancel()
            return
        end
        local normalizedScale = model:GetScale() * 2 / initialHeight
        for _, descendant in model:GetDescendants() do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
            elseif descendant:IsA("Script") or descendant:IsA("LocalScript")
                or descendant:IsA("ProximityPrompt") or descendant:IsA("Sound") then
                descendant:Destroy()
            end
        end

        world = Instance.new("WorldModel")
        world.Name = "HatchCrabWorld"
        world.Parent = viewport
        model.Parent = world
        local currentCamera = Instance.new("Camera")
        currentCamera.FieldOfView = 35
        currentCamera.Parent = viewport
        camera = currentCamera
        viewport.CurrentCamera = currentCamera

        local finalWeight = CrabWeights.normalize(weightGrams)
        local finalIncome = CrabWeights.income(definition.incomePerSecond, finalWeight)
        local finalScale = normalizedScale * CrabWeights.scale(finalWeight)
        model:ScaleTo(finalScale)
        local _, finalSize = model:GetBoundingBox()
        local referenceRatio = CrabWeights.scale(CAMERA_REFERENCE_WEIGHT_GRAMS) / CrabWeights.scale(finalWeight)
        local heavyCrabPadding = math.max(MIN_CAMERA_PADDING, 1.35 - 0.1 * math.log(finalWeight / 10) / math.log(10))
        local framingFactor = math.max(referenceRatio, heavyCrabPadding / CAMERA_PADDING)
        local framingSize = finalSize * framingFactor
        model:ScaleTo(finalScale * START_VISUAL_SCALE)

        crabName(definition.name)
        gramText("0.00g")
        incomeText("0/s")
        revealVisible(true)
        visible(true)
        countSound.TimePosition = 0
        countSound:Play()

        local steadyRotationRate = 2 * math.pi / CRAB_ROTATION_SECONDS
        local startingRotationRate = steadyRotationRate * STARTING_ROTATION_MULTIPLIER
        local thisRun = runNumber
        local elapsed = 0
        local revealComplete = false
        connection = RunService.RenderStepped:Connect(function(dt)
            if thisRun ~= runNumber then
                return
            end
            elapsed += dt
            local angle = -(steadyRotationRate * elapsed
                + (startingRotationRate - steadyRotationRate) * SPIN_DECAY_SECONDS
                    * (1 - math.exp(-elapsed / SPIN_DECAY_SECONDS)))
            local growProgress = math.clamp(elapsed / REVEAL_SECONDS, 0, 1)
            local growth = 1 - (1 - growProgress) ^ 3
            if not revealComplete then
                local displayedWeight = finalWeight * growth
                gramText(string.format("%.2fg", displayedWeight))
                local visualScale = START_VISUAL_SCALE + (1 - START_VISUAL_SCALE) * growth
                model:ScaleTo(finalScale * visualScale)
                local animatedIncome = finalIncome * growth
                incomeText(CompactNumber.format(animatedIncome, 2) .. "/s")
                local box = model:GetBoundingBox()
                model:PivotTo(CFrame.new(-box.Position) * model:GetPivot())
            end
            burstImage.Rotation = (-elapsed / BURST_ROTATION_SECONDS * 360) % 360
            local viewportSize = viewport.AbsoluteSize
            local aspectRatio = if viewportSize.Y > 0 then math.max(0.1, viewportSize.X / viewportSize.Y) else 1
            local horizontalSpan = math.sqrt(framingSize.X ^ 2 + framingSize.Z ^ 2)
            local fitSize = math.max(framingSize.Y, horizontalSpan / aspectRatio)
            local cameraDistance = math.max(5, fitSize / (2 * math.tan(math.rad(currentCamera.FieldOfView / 2))) * CAMERA_PADDING)
            local cameraPosition = Vector3.new(math.sin(angle) * cameraDistance, framingSize.Y * 0.1, math.cos(angle) * cameraDistance)
            currentCamera.CFrame = CFrame.lookAt(cameraPosition, Vector3.zero)
            if elapsed >= DISMISS_READY_SECONDS and not readyToDismiss then
                readyToDismiss = true
                clickHintVisible(true)
            end
            if elapsed >= REVEAL_SECONDS and not revealComplete then
                countSound:Stop()
                gramText(string.format("%.2fg", finalWeight))
                incomeText(CompactNumber.format(finalIncome, 2) .. "/s")
                revealComplete = true
            end
        end)
    end

    return function(crabId: string, weightGrams: number, eggId: string?, eggPivot: CFrame?, eggScale: number?, viewDirection: Vector3?, instanceId: string?)
        cancel()
        activeInstanceId = instanceId
        setPromptsLocked(true)
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local eggs = if assets then assets:FindFirstChild("Eggs") else nil
        local eggTemplate = if eggId and eggs then eggs:FindFirstChild(eggId) else nil
        local sceneCamera = Workspace.CurrentCamera
        if not eggTemplate or not eggTemplate:IsA("Model") or not eggPivot
            or not eggScale or eggScale <= 0 or not sceneCamera then
            startCrabReveal(crabId, weightGrams)
            return
        end

        local preview = eggTemplate:Clone()
        for _, descendant in preview:GetDescendants() do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
            elseif descendant:IsA("Script") or descendant:IsA("LocalScript")
                or descendant:IsA("ProximityPrompt") or descendant:IsA("Sound") then
                descendant:Destroy()
            end
        end
        preview.Name = "HatchPreviewEgg"
        preview:ScaleTo(eggScale)
        preview:PivotTo(eggPivot)
        preview.Parent = Workspace
        introEgg = preview

        local boxCFrame = preview:GetBoundingBox()
        local eggCenter = boxCFrame.Position
        local padSide = if viewDirection and viewDirection.Magnitude > 0.01 then viewDirection else eggPivot.LookVector
        local horizontal = Vector3.new(padSide.X, 0, padSide.Z)
        if horizontal.Magnitude < 0.01 then
            horizontal = Vector3.new(0, 0, -1)
        end
        local startPosition = eggCenter + horizontal.Unit * 8 + Vector3.new(0, 2.5, 0)
        local closePosition = eggCenter + horizontal.Unit * 3.8 + Vector3.new(0, 0.8, 0)
        local startCFrame = CFrame.lookAt(startPosition, eggCenter)
        local closeCFrame = CFrame.lookAt(closePosition, eggCenter)
        introCamera = sceneCamera
        previousCameraType = sceneCamera.CameraType
        previousCameraCFrame = sceneCamera.CFrame
        previousFieldOfView = sceneCamera.FieldOfView
        sceneCamera.CameraType = Enum.CameraType.Scriptable
        sceneCamera.CFrame = startCFrame

        flashTransparency(1)
        flashVisible(true)
        visible(true)
        local thisRun = runNumber
        local elapsed = 0
        local startedReveal = false
        local startedShakeSound = false
        local startedRevealSound = false
        local shakeEnd = EGG_ZOOM_SECONDS + EGG_SHAKE_SECONDS
        local flashPeak = shakeEnd + FLASH_IN_SECONDS
        local fadeStart = flashPeak + FLASH_HOLD_SECONDS
        local finishTime = fadeStart + FLASH_OUT_SECONDS

        introConnection = RunService.RenderStepped:Connect(function(dt)
            if thisRun ~= runNumber then
                return
            end
            elapsed += dt
            if not startedShakeSound and elapsed >= SHAKE_SOUND_DELAY_SECONDS and elapsed < shakeEnd then
                startedShakeSound = true
                shakeSound.TimePosition = 0
                shakeSound:Play()
            end
            if elapsed < EGG_ZOOM_SECONDS then
                local fraction = math.clamp(elapsed / EGG_ZOOM_SECONDS, 0, 1)
                local eased = (2 ^ (5 * fraction) - 1) / 31
                sceneCamera.CFrame = startCFrame:Lerp(closeCFrame, eased)
            elseif elapsed < flashPeak then
                sceneCamera.CFrame = closeCFrame
            end
            if elapsed < shakeEnd then
                local tilt: number
                if elapsed < EGG_ZOOM_SECONDS then
                    local beatDuration = EGG_ZOOM_SECONDS / 2
                    local beatIndex = math.floor(elapsed / beatDuration)
                    local beatProgress = (elapsed % beatDuration) / beatDuration
                    local activeProgress = math.clamp(beatProgress / 0.7, 0, 1)
                    local direction = if beatIndex == 0 then -1 else 1
                    tilt = direction * math.rad(7) * math.sin(math.pi * activeProgress)
                else
                    local progress = math.clamp((elapsed - EGG_ZOOM_SECONDS) / EGG_SHAKE_SECONDS, 0, 1)
                    local cycles = 8 * (4 ^ progress - 1) / 3
                    tilt = math.rad(5 + 11 * progress) * math.sin(2 * math.pi * cycles)
                end
                preview:PivotTo(
                    CFrame.new(eggPivot.Position)
                    * CFrame.fromAxisAngle(closeCFrame.LookVector, tilt)
                    * eggPivot.Rotation
                )
            end

            if elapsed >= shakeEnd and not startedReveal then
                shakeSound:Stop()
                if not startedRevealSound then
                    startedRevealSound = true
                    revealSound.TimePosition = 0
                    revealSound:Play()
                    task.delay(REVEAL_SOUND_SECONDS, function()
                        if thisRun == runNumber then
                            revealSound:Stop()
                        end
                    end)
                end
                preview:PivotTo(eggPivot)
                flashTransparency(1 - math.clamp((elapsed - shakeEnd) / FLASH_IN_SECONDS, 0, 1))
            end
            if elapsed >= flashPeak and not startedReveal then
                startedReveal = true
                flashTransparency(0)
                restoreIntro()
                startCrabReveal(crabId, weightGrams)
                if thisRun ~= runNumber then
                    return
                end
            end
            if startedReveal and elapsed >= fadeStart then
                flashTransparency(math.clamp((elapsed - fadeStart) / FLASH_OUT_SECONDS, 0, 1))
            end
            if elapsed >= finishTime then
                flashVisible(false)
                if introConnection then
                    introConnection:Disconnect()
                    introConnection = nil
                end
            end
        end)
    end
end

return HatchReveal
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="500">
              <Properties>
                <string name="Name">IncubatorCountdown</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local IncubatorCountdown = {}

function IncubatorCountdown.attach(egg: Model, incubator: Model): () -> ()
	local countdown = Vide.source("")
	local destroyed = false
	local billboard: BillboardGui? = nil
	local unmount: (() -> ())? = nil
	local driverConnection: RBXScriptConnection? = nil

	local function mountCountdown()
		if destroyed or unmount or egg.Parent ~= incubator then
			return
		end
		local driver = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart", true)
		if not driver or not driver:IsA("BasePart") then
			return
		end
		if driverConnection then
			driverConnection:Disconnect()
			driverConnection = nil
		end
		local box, size = egg:GetBoundingBox()
		local topOffset = box.Position.Y + size.Y / 2 - driver.Position.Y + 0.95
		unmount = Vide.mount(function()
			local gui = create "BillboardGui" {
				Name = "IncubatorCountdown",
				Adornee = driver,
				Size = UDim2.fromScale(3.8, 1.1),
				StudsOffsetWorldSpace = function()
					return Vector3.new(0, topOffset + (if countdown() == "READY" then 0.25 else 0), 0)
				end,
				MaxDistance = 40,
				AlwaysOnTop = true,
				LightInfluence = 0,
			}
			local label = create "TextLabel" {
				Name = "TimeRemaining",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = countdown,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0,
				TextScaled = true,
				Font = Enum.Font.BuilderSansExtraBold,
				Visible = function()
					return countdown() ~= ""
				end,
			}
			label.Parent = gui
			create "UIStroke" {
				ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
				Color = Color3.new(0, 0, 0),
				Thickness = 1.5,
			}.Parent = label
			create "UITextSizeConstraint" { MaxTextSize = 36 }.Parent = label
			billboard = gui
			return gui
		end, playerGui)

		task.spawn(function()
			while not destroyed and egg.Parent == incubator do
				local hatchAt = incubator:GetAttribute("IncubatingHatchAtUnixMs")
				local nextText = ""
				if typeof(hatchAt) == "number" then
					local remaining = math.max(0, math.ceil((hatchAt - DateTime.now().UnixTimestampMillis) / 1000))
					nextText = if remaining == 0 then "READY"
						else string.format("%d:%02d", math.floor(remaining / 60), remaining % 60)
				end
				if countdown() ~= nextText then
					countdown(nextText)
				end
				task.wait(0.1)
			end
		end)
	end

	driverConnection = egg.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			mountCountdown()
		end
	end)
	mountCountdown()

	return function()
		if destroyed then
			return
		end
		destroyed = true
		if driverConnection then
			driverConnection:Disconnect()
			driverConnection = nil
		end
		if unmount then
			unmount()
		end
		if billboard then
			billboard:Destroy()
		end
	end
end

return IncubatorCountdown
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="501">
          <Properties>
            <string name="Name">Index</string>
          </Properties>
          <Item class="ModuleScript" referent="502">
            <Properties>
              <string name="Name">IndexServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Data = require(ReplicatedStorage.Source.Game.Data).client
local IndexButton = require(script.Parent.UI.IndexButton)
local IndexRoot = require(script.Parent.UI.IndexRoot)

local IndexServiceClient = {}
local initialized = false

function IndexServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	local isOpen = Vide.source(false)
	local discovered = Vide.source(Data.discoveredCrabs())
	Data.discoveredCrabs.Changed(function(value: { [string]: boolean })
		discovered(value)
	end)

	IndexButton.mount(playerGui, function()
		isOpen(not isOpen())
	end)
	Vide.mount(function()
		return IndexRoot({
			isOpen = isOpen,
			discovered = discovered,
			onClose = function()
				isOpen(false)
			end,
		})
	end, playerGui)
end

return IndexServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="503">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="504">
              <Properties>
                <string name="Name">IndexButton</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)

local create = Vide.create
local IndexButton = {}
local BUTTON_SIZE = 80
local CENTER_OFFSET = 44

function IndexButton.mount(playerGui: PlayerGui, onActivated: () -> ())
	local hoverScale = create "UIScale" { Scale = 1 }
	local hoverTween: Tween? = nil
	local function setHovered(hovered: boolean)
		if hoverTween then
			hoverTween:Cancel()
		end
		hoverTween = TweenService:Create(hoverScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = if hovered then 1.08 else 1,
		})
		hoverTween:Play()
	end

	local button = create "ImageButton" {
		Name = "IndexButton",
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
		Position = UDim2.new(1, -16, 0.5, CENTER_OFFSET),
		BackgroundColor3 = Color3.fromRGB(12, 12, 17),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Image = "",
		AutoButtonColor = false,
		MouseEnter = function()
			setHovered(true)
		end,
		MouseLeave = function()
			setHovered(false)
		end,
		Activated = onActivated,
	}
	hoverScale.Parent = button
	create "UICorner" { CornerRadius = UDim.new(0, 3) }.Parent = button
	create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Color3.new(0, 0, 0),
		Thickness = 4,
	}.Parent = button

	create "ImageLabel" {
		Name = "IndexIcon",
		Position = UDim2.fromScale(0.05, 0.05),
		Size = UDim2.fromScale(0.9, 0.72),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.IndexButtonIcon,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 2,
	}.Parent = button

	local title = create "TextLabel" {
		Name = "IndexLabel",
		Position = UDim2.fromScale(0.02, 0.76),
		Size = UDim2.fromScale(0.96, 0.24),
		BackgroundTransparency = 1,
		Text = "Index",
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		Font = Enum.Font.BuilderSansExtraBold,
		ZIndex = 3,
	}
	create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Color = Color3.new(0, 0, 0),
		Thickness = 2,
	}.Parent = title
	create "UITextSizeConstraint" { MaxTextSize = 20 }.Parent = title
	title.Parent = button

	local screen = create "ScreenGui" {
		Name = "IndexButtonGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}
	button.Parent = screen
	Vide.mount(function()
		return screen
	end, playerGui)

	local viewportConnection: RBXScriptConnection? = nil
	local function layout()
		local camera = Workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local scale = math.clamp(math.min(viewport.X / 1000, viewport.Y / 650), 0.7, 1)
		button.Size = UDim2.fromOffset(math.round(BUTTON_SIZE * scale), math.round(BUTTON_SIZE * scale))
		button.Position = UDim2.new(1, -math.round(16 * scale), 0.5, math.round(CENTER_OFFSET * scale))
	end
	local function watchCamera()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		local camera = Workspace.CurrentCamera
		viewportConnection = if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) else nil
		layout()
	end
	local cameraConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	screen.Destroying:Connect(function()
		cameraConnection:Disconnect()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		if hoverTween then
			hoverTween:Cancel()
		end
	end)
	watchCamera()
end

return IndexButton
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="505">
              <Properties>
                <string name="Name">IndexRoot</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local Rarities = require(ReplicatedStorage.Source.Game.Items.Rarities)

local create = Vide.create
local source = Vide.source
local image = function(id: number): string
	return "rbxassetid://" .. id
end

export type Props = {
	isOpen: () -> boolean,
	discovered: () -> { [string]: boolean },
	onClose: () -> (),
}

local function label(name: string, value: any, position: UDim2, size: UDim2, maxSize: number, color: any?): TextLabel
	local text = create "TextLabel" {
		Name = name,
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		Text = value,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextScaled = true,
		TextWrapped = true,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		Font = Enum.Font.BuilderSansExtraBold,
		ZIndex = 5,
	} :: TextLabel
	create "UITextSizeConstraint" { MaxTextSize = maxSize }.Parent = text
	return text
end

local function IndexRoot(props: Props): Instance
	local ids = Crabs.getOrderedIds()
	local selectedId = source(ids[1])
	local visible = source(false)
	local discoveredCount = Vide.derive(function()
		local known = props.discovered()
		local count = 0
		for _, crabId in ids do
			if known[crabId] == true then
				count += 1
			end
		end
		return count
	end)
	local stageTarget = Vide.derive(function()
		local count = discoveredCount()
		return if count < 5 then 5 elseif count < 15 then 15 else #ids
	end)
	local stageStart = Vide.derive(function()
		local count = discoveredCount()
		return if count < 5 then 0 elseif count < 15 then 5 else 15
	end)
	local isSelectedKnown = Vide.derive(function()
		return props.discovered()[selectedId()] == true
	end)
	local selectedDefinition = Vide.derive(function()
		return Crabs.get(selectedId())
	end)

	local screen = create "ScreenGui" {
		Name = "IndexMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 30,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = visible,
	} :: ScreenGui
	local closeSound = create "Sound" { SoundId = "rbxassetid://132948338000932", Volume = 1 }
	closeSound.Parent = screen

	local panel = create "ImageLabel" {
		Name = "IndexPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 1.6),
		Size = UDim2.fromOffset(850, 458),
		BackgroundTransparency = 1,
		Image = image(assets.IndexBackground),
		ImageColor3 = Color3.fromRGB(165, 105, 48),
		ScaleType = Enum.ScaleType.Stretch,
	} :: ImageLabel
	panel.Parent = screen

	local sign = create "ImageLabel" {
		Name = "IndexSign",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.08, 0.05),
		Size = UDim2.fromScale(0.34, 0.23),
		BackgroundTransparency = 1,
		Image = image(assets.WoodenPlankShop),
		ScaleType = Enum.ScaleType.Fit,
		Rotation = 8,
		ZIndex = 3,
	} :: ImageLabel
	local title = label("Title", "INDEX", UDim2.fromScale(0.09, 0.12), UDim2.fromScale(0.82, 0.74), 52)
	title.Rotation = -8
	title.Parent = sign
	sign.Parent = panel

	local close = create "ImageButton" {
		Name = "Close",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromScale(0.075, 0.14),
		BackgroundTransparency = 1,
		Image = image(assets.ExitButton),
		ScaleType = Enum.ScaleType.Fit,
		AutoButtonColor = false,
		ZIndex = 8,
		Activated = function()
			props.onClose()
		end,
	} :: ImageButton
	close.Parent = panel

	local gridBackground = create "ImageLabel" {
		Name = "CrabCollection",
		Position = UDim2.fromScale(0.08, 0.14),
		Size = UDim2.fromScale(0.55, 0.70),
		BackgroundColor3 = Color3.fromRGB(245, 180, 62),
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Image = "",
		ZIndex = 2,
	} :: ImageLabel
	create "UICorner" { CornerRadius = UDim.new(0, 6) }.Parent = gridBackground
	create "UIStroke" { Color = Color3.fromRGB(38, 20, 0), Thickness = 3 }.Parent = gridBackground
	gridBackground.Parent = panel

	local list = create "ScrollingFrame" {
		Name = "CrabList",
		Position = UDim2.fromScale(0.035, 0.04),
		Size = UDim2.fromScale(0.93, 0.92),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Color3.fromRGB(96, 52, 13),
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 3,
	} :: ScrollingFrame
	local grid = create "UIGridLayout" {
		CellPadding = UDim2.fromOffset(6, 6),
		CellSize = UDim2.fromOffset(74, 76),
		SortOrder = Enum.SortOrder.LayoutOrder,
	} :: UIGridLayout
	grid.Parent = list
	list.Parent = gridBackground

	for order, crabId in ids do
		local definition = Crabs.get(crabId)
		if not definition then
			continue
		end
		local card = create "ImageButton" {
			Name = crabId,
			LayoutOrder = order,
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Image = image(assets.IndexMiniCard),
			ScaleType = Enum.ScaleType.Stretch,
			AutoButtonColor = false,
			ZIndex = 4,
			Activated = function()
				selectedId(crabId)
				closeSound.TimePosition = 0
				closeSound:Play()
			end,
		} :: ImageButton
		local selection = create "Frame" {
			Name = "SelectionBorder",
			Position = UDim2.fromOffset(3, 3),
			Size = UDim2.new(1, -6, 1, -6),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Active = false,
			Visible = function()
				return selectedId() == crabId
			end,
			ZIndex = 7,
		} :: Frame
		create "UICorner" { CornerRadius = UDim.new(0, 5) }.Parent = selection
		create "UIStroke" {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(1, 1, 1),
			Thickness = 4,
		}.Parent = selection
		selection.Parent = card
		create "ImageLabel" {
			Name = "CrabImage",
			Position = UDim2.fromScale(-0.19, 0.17),
			Size = UDim2.fromScale(1.38, 1.00),
			BackgroundTransparency = 1,
			Image = image(definition.imageId),
			ImageColor3 = function()
				return if props.discovered()[crabId] then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
			end,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 5,
		}.Parent = card
		label("CardName", function()
			return if props.discovered()[crabId] then definition.name else "???"
		end, UDim2.fromScale(0.03, 0.015), UDim2.fromScale(0.94, 0.29), 20).Parent = card
		card.Parent = list
	end

	local showcase = create "ImageLabel" {
		Name = "Showcase",
		Position = UDim2.fromScale(0.69, 0.10),
		Size = UDim2.fromScale(0.24, 0.50),
		BackgroundTransparency = 1,
		Image = image(assets.IndexShowcaseCard),
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = 3,
	} :: ImageLabel
	create "ImageLabel" {
		Name = "SelectedCrab",
		Position = UDim2.fromScale(-0.35, 0.12),
		Size = UDim2.fromScale(1.70, 0.70),
		BackgroundTransparency = 1,
		Image = function()
			local definition = selectedDefinition()
			return if definition then image(definition.imageId) else ""
		end,
		ImageColor3 = function()
			return if isSelectedKnown() then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 4,
	}.Parent = showcase
	label("CrabName", function()
		local definition = selectedDefinition()
		return if isSelectedKnown() and definition then definition.name else "????"
	end, UDim2.fromScale(0.06, 0.03), UDim2.fromScale(0.88, 0.16), 19).Parent = showcase
	label("Rarity", function()
		local definition = selectedDefinition()
		return if definition then definition.rarity else ""
	end, UDim2.fromScale(0.04, 0.62), UDim2.fromScale(0.92, 0.12), 18, function()
		local definition = selectedDefinition()
		return if definition then Rarities.getColor(definition.rarity) else Color3.new(1, 1, 1)
	end).Parent = showcase
	label("IncomeHeading", "BASE INCOME", UDim2.fromScale(0.05, 0.75), UDim2.fromScale(0.90, 0.11), 16).Parent = showcase
	label("Income", function()
		local definition = selectedDefinition()
		return if isSelectedKnown() and definition then CompactNumber.formatIncomeRate(definition.incomePerSecond) .. "/s" else "????"
	end, UDim2.fromScale(0.05, 0.86), UDim2.fromScale(0.90, 0.12), 19).Parent = showcase
	showcase.Parent = panel

	local rewards = create "ImageLabel" {
		Name = "Rewards",
		Position = UDim2.fromScale(0.69, 0.64),
		Size = UDim2.fromScale(0.24, 0.31),
		BackgroundTransparency = 1,
		Image = image(assets.IndexRewardCard),
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = 3,
	} :: ImageLabel
	for index, iconId in { assets.IndexClover, assets.SandDollar } do
		local rewardSlot = create "ImageLabel" {
			Name = if index == 1 then "CloverReward" else "CoinReward",
			Position = UDim2.fromScale(if index == 1 then 0.13 else 0.56, 0.09),
			Size = UDim2.fromScale(0.32, 0.45),
			BackgroundTransparency = 1,
			Image = image(assets.IndexMiniCard),
			ScaleType = Enum.ScaleType.Stretch,
			ZIndex = 4,
		} :: ImageLabel
		create "ImageLabel" {
			Name = "RewardIcon",
			Position = UDim2.fromScale(0.15, 0.12),
			Size = UDim2.fromScale(0.70, 0.76),
			BackgroundTransparency = 1,
			Image = image(iconId),
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 5,
		}.Parent = rewardSlot
		rewardSlot.Parent = rewards
	end
	local claim = create "Frame" {
		Name = "ClaimUnavailable",
		Position = UDim2.fromScale(0.19, 0.63),
		Size = UDim2.fromScale(0.62, 0.27),
		BackgroundColor3 = Color3.fromRGB(103, 105, 107),
		BorderSizePixel = 0,
		ZIndex = 4,
	} :: Frame
	create "UICorner" { CornerRadius = UDim.new(0, 4) }.Parent = claim
	create "UIStroke" { Color = Color3.fromRGB(35, 35, 35), Thickness = 2 }.Parent = claim
	label("ClaimText", "CLAIM", UDim2.fromScale(0.05, 0.06), UDim2.fromScale(0.90, 0.87), 17, Color3.fromRGB(210, 210, 210)).Parent = claim
	claim.Parent = rewards
	rewards.Parent = panel

	local progress = create "ImageLabel" {
		Name = "IndexProgress",
		Position = UDim2.fromScale(0.08, 0.87),
		Size = UDim2.fromScale(0.55, 0.11),
		BackgroundTransparency = 1,
		Image = image(assets.IndexProgressPill),
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = 3,
	} :: ImageLabel
	local track = create "Frame" {
		Name = "ProgressTrack",
		Position = UDim2.fromScale(0.12, 0.20),
		Size = UDim2.fromScale(0.83, 0.62),
		BackgroundColor3 = Color3.fromRGB(24, 30, 37),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 4,
	} :: Frame
	create "UICorner" { CornerRadius = UDim.new(1, 0) }.Parent = track
	local fill = create "Frame" {
		Name = "ProgressFill",
		Size = function()
			local start = stageStart()
			return UDim2.fromScale(math.clamp((discoveredCount() - start) / (stageTarget() - start), 0, 1), 1)
		end,
		BackgroundColor3 = Color3.fromRGB(0, 200, 255),
		BorderSizePixel = 0,
		ZIndex = 5,
	} :: Frame
	create "UICorner" { CornerRadius = UDim.new(1, 0) }.Parent = fill
	create "UIGradient" {
		Color = ColorSequence.new(Color3.fromRGB(0, 220, 255), Color3.fromRGB(0, 84, 235)),
		Rotation = 0,
	}.Parent = fill
	fill.Parent = track
	track.Parent = progress
	create "ImageLabel" {
		Name = "BookIcon",
		Position = UDim2.fromScale(-0.03, -0.12),
		Size = UDim2.fromScale(0.15, 1.24),
		BackgroundTransparency = 1,
		Image = image(assets.IndexButtonIcon),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 6,
	}.Parent = progress
	label("ProgressText", function()
		return string.format("%d/%d", discoveredCount(), stageTarget())
	end, UDim2.fromScale(0.30, 0.08), UDim2.fromScale(0.40, 0.84), 23).Parent = progress
	progress.Parent = panel

	local function resize()
		local camera = Workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local portrait = viewport.Y > viewport.X
		local width = math.min(850, viewport.X * (if portrait then 0.94 else 0.86))
		local height = math.min(458, viewport.Y * (if portrait then 0.72 else 0.74))
		panel.Size = UDim2.fromOffset(math.floor(width), math.floor(height))
		if portrait then
			gridBackground.Position = UDim2.fromScale(0.06, 0.13)
			gridBackground.Size = UDim2.fromScale(0.88, 0.45)
			showcase.Position = UDim2.fromScale(0.06, 0.60)
			showcase.Size = UDim2.fromScale(0.42, 0.25)
			rewards.Position = UDim2.fromScale(0.52, 0.60)
			rewards.Size = UDim2.fromScale(0.42, 0.25)
			progress.Position = UDim2.fromScale(0.08, 0.87)
			progress.Size = UDim2.fromScale(0.84, 0.10)
		else
			gridBackground.Position = UDim2.fromScale(0.08, 0.14)
			gridBackground.Size = UDim2.fromScale(0.55, 0.70)
			showcase.Position = UDim2.fromScale(0.69, 0.10)
			showcase.Size = UDim2.fromScale(0.24, 0.50)
			rewards.Position = UDim2.fromScale(0.69, 0.64)
			rewards.Size = UDim2.fromScale(0.24, 0.31)
			progress.Position = UDim2.fromScale(0.08, 0.87)
			progress.Size = UDim2.fromScale(0.55, 0.11)
		end
		local columns = if portrait then 4 else 5
		local cellWidth = math.floor((width * gridBackground.Size.X.Scale * 0.93 - (columns - 1) * 6 - 6) / columns)
		grid.CellSize = UDim2.fromOffset(cellWidth, math.floor(cellWidth * 1.03))
	end
	local viewportConnection: RBXScriptConnection? = nil
	local function watchCamera()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		local camera = Workspace.CurrentCamera
		viewportConnection = if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) else nil
		resize()
	end
	local cameraConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	screen.Destroying:Connect(function()
		cameraConnection:Disconnect()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
	end)
	watchCamera()

	local shownPosition = UDim2.fromScale(0.5, 0.53)
	local hiddenPosition = UDim2.fromScale(0.5, 1.6)
	local panelTween: Tween? = nil
	local animationVersion = 0
	local wasOpen = false
	Vide.effect(function()
		local shouldOpen = props.isOpen()
		if shouldOpen == wasOpen then
			return
		end
		wasOpen = shouldOpen
		animationVersion += 1
		local version = animationVersion
		if panelTween then
			panelTween:Cancel()
		end
		if shouldOpen then
			for _, crabId in ids do
				if props.discovered()[crabId] then
					selectedId(crabId)
					break
				end
			end
			visible(true)
			panelTween = TweenService:Create(panel, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = shownPosition })
			panelTween:Play()
		else
			closeSound:Play()
			panelTween = TweenService:Create(panel, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = hiddenPosition })
			panelTween.Completed:Once(function(state)
				if state == Enum.PlaybackState.Completed and animationVersion == version then
					visible(false)
				end
			end)
			panelTween:Play()
		end
	end)
	return screen
end

return IndexRoot
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="506">
          <Properties>
            <string name="Name">Inventory</string>
          </Properties>
          <Item class="ModuleScript" referent="507">
            <Properties>
              <string name="Name">InventoryConfig</string>
              <string name="Source"><![CDATA[--!strict

return {
	hotbarSize = 9,
	emptySlot = "NULL",
	maxItems = 100,
	hammerItemId = "Hammer",
	hammerSlot = 1,
	hammerInstanceId = function(userId: number): string
		return "StarterHammer:" .. userId
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="508">
            <Properties>
              <string name="Name">InventoryServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Data = require(ReplicatedStorage.Source.Game.Data).client
local InventoryConfig = require(script.Parent.InventoryConfig)
local ItemCatalog = require(ReplicatedStorage.Source.Game.Items.ItemCatalog)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local Networker = require(ReplicatedStorage.Packages.Networker)
local HotbarRoot = require(script.Parent.UI.HotbarRoot)
local InventoryRoot = require(script.Parent.UI.InventoryRoot)

type SavedItem = { itemId: string, placedSlotId: string?, incubatorInstanceId: string?, tankInstanceId: string?, weightGrams: number? }
type SavedInventory = { [string]: SavedItem }
type DragState = {
	instanceId: string,
	sourceSlot: number?,
	input: InputObject,
	startPosition: Vector2,
	card: ImageButton,
	ghost: ImageButton?,
	active: boolean,
}

local InventoryServiceClient = {}
local initialized = false
local player = Players.LocalPlayer
local backpack: Backpack? = nil
local character: Model? = nil
local backpackConnections: { RBXScriptConnection } = {}
local characterConnections: { RBXScriptConnection } = {}
local selectedInventoryId: string? = nil
local sendSlotMove: ((string, number) -> ())? = nil
local sendSlotRemove: ((string) -> ())? = nil
local sendHatchClaim: ((string) -> ())? = nil
local dragState: DragState? = nil
local dragLayer: ScreenGui? = nil
local suppressedId: string? = nil
local suppressUntil = 0
local renderPending = false

local keyToIndex = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

local function disconnectAll(connections: { RBXScriptConnection })
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function findTool(instanceId: string): Tool?
	local function findIn(container: Instance?): Tool?
		if not container then
			return nil
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("ItemInstanceId") == instanceId then
				return child
			end
		end
		return nil
	end
	return findIn(backpack) or findIn(character)
end

local cardImages: { [string]: number } = {
	Common = assets.CommonInventoryCard,
	Uncommon = assets.UncommonInventoryCard,
	Epic = assets.EpicInventoryCard,
	Legendary = assets.LegendaryInventoryCard,
	Mythic = assets.MythicInventoryCard,
}

local function getDisplay(itemId: string): (string, string, string?)
	local definition = ItemCatalog.get(itemId)
	if definition then
		local cardId = if definition.rarity then cardImages[definition.rarity] else nil
		return definition.shortName, `rbxassetid://{definition.imageId}`, if cardId then `rbxassetid://{cardId}` else nil
	end
	return itemId, "", nil
end

local function isHotbarEligible(itemId: string): boolean
	local definition = ItemCatalog.get(itemId)
	return definition ~= nil and definition.hotbarEligible ~= false
end

local function getWeightText(item: SavedItem): string?
	return if string.match(item.itemId, "^Crab%.[%w_]+$") then CrabWeights.format(item.weightGrams) else nil
end

local function isAvailable(item: SavedItem?): boolean
	return typeof(item) == "table" and typeof(item.itemId) == "string"
		and item.placedSlotId == nil and item.incubatorInstanceId == nil and item.tankInstanceId == nil
end

local function render()
	local inventory = Data.inventory() :: SavedInventory
	local hotbar = Data.hotbar() :: { string }
	local stackIds: { [string]: { string } } = {}
	for instanceId, item in inventory do
		if isAvailable(item) and ItemCatalog.isStackable(item.itemId) then
			local ids = stackIds[item.itemId]
			if not ids then
				ids = {}
				stackIds[item.itemId] = ids
			end
			table.insert(ids, instanceId)
		end
	end
	for _, ids in stackIds do
		table.sort(ids)
	end
	local assigned: { [string]: boolean } = {}
	local assignedStackables: { [string]: boolean } = {}
	local views: { HotbarRoot.SlotView } = {}

	for index = 1, InventoryConfig.hotbarSize do
		local instanceId = hotbar[index]
		local item = if typeof(instanceId) == "string" then inventory[instanceId] else nil
		local displayName = ""
		local image = ""
		local cardImage: string? = nil
		local weightText: string? = nil
		local count: number? = nil
		local selected = false
		local hasItem = false
		if isAvailable(item) and (not stackIds[item.itemId] or not assignedStackables[item.itemId]) then
			assigned[instanceId] = true
			displayName, image, cardImage = getDisplay(item.itemId)
			weightText = getWeightText(item)
			local ids = stackIds[item.itemId]
			if ids then
				assignedStackables[item.itemId] = true
				count = #ids
			end
			local tool = findTool(instanceId)
			selected = tool ~= nil and character ~= nil and tool.Parent == character
			hasItem = true
		end
		if hasItem or selectedInventoryId ~= nil or (dragState ~= nil and dragState.active) then
			table.insert(views, {
				index = index,
				instanceId = if hasItem then instanceId else nil,
				displayName = displayName,
				image = image,
				cardImage = cardImage,
				weightText = weightText,
				count = count,
				selected = selected,
			})
		end
	end

	local extras: { InventoryRoot.EntryView } = {}
	for instanceId, item in inventory do
		if not assigned[instanceId] and isAvailable(item) and not ItemCatalog.isStackable(item.itemId) then
			local displayName, image, cardImage = getDisplay(item.itemId)
			table.insert(extras, {
				instanceId = instanceId,
				itemId = item.itemId,
				displayName = displayName,
				image = image,
				cardImage = cardImage,
				weightText = getWeightText(item),
				count = 1,
			})
		end
	end
	for itemId, ids in stackIds do
		if not assignedStackables[itemId] then
			local instanceId = if selectedInventoryId and table.find(ids, selectedInventoryId) then selectedInventoryId else ids[1]
			local displayName, image, cardImage = getDisplay(itemId)
			table.insert(extras, {
				instanceId = instanceId,
				itemId = itemId,
				displayName = displayName,
				image = image,
				cardImage = cardImage,
				count = #ids,
			})
		end
	end
	table.sort(extras, function(left, right)
		if left.displayName == right.displayName then
			if left.itemId ~= right.itemId then
				return left.itemId < right.itemId
			end
			return left.instanceId < right.instanceId
		end
		return left.displayName < right.displayName
	end)

	local selectedItem = if selectedInventoryId then inventory[selectedInventoryId] else nil
	if selectedInventoryId and (assigned[selectedInventoryId] or not isAvailable(selectedItem)
		or (ItemCatalog.isStackable(selectedItem.itemId) and assignedStackables[selectedItem.itemId])) then
		selectedInventoryId = nil
		render()
		return
	end
	HotbarRoot.render(views)
	InventoryRoot.render(extras, selectedInventoryId)
end

local function scheduleRender()
	if renderPending then
		return
	end
	renderPending = true
	task.defer(function()
		renderPending = false
		render()
	end)
end

local function bindBackpack(newBackpack: Backpack?)
	if backpack == newBackpack then
		return
	end
	disconnectAll(backpackConnections)
	backpack = newBackpack
	if backpack then
		table.insert(backpackConnections, backpack.ChildAdded:Connect(scheduleRender))
		table.insert(backpackConnections, backpack.ChildRemoved:Connect(scheduleRender))
	end
	scheduleRender()
end

local function bindCharacter(newCharacter: Model?)
	if character == newCharacter then
		return
	end
	disconnectAll(characterConnections)
	character = newCharacter
	if character then
		table.insert(characterConnections, character.ChildAdded:Connect(scheduleRender))
		table.insert(characterConnections, character.ChildRemoved:Connect(scheduleRender))
	end
	scheduleRender()
end

local function positionOf(input: InputObject): Vector2
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseMovement then
		return UserInputService:GetMouseLocation()
	end
	return Vector2.new(input.Position.X, input.Position.Y)
end

local function beginDrag(instanceId: string, sourceSlot: number?, input: InputObject, card: ImageButton)
	local item = (Data.inventory() :: SavedInventory)[instanceId]
	if sourceSlot == InventoryConfig.hammerSlot or not item or not isHotbarEligible(item.itemId) then
		return
	end
	if dragState then
		return
	end
	dragState = {
		instanceId = instanceId,
		sourceSlot = sourceSlot,
		input = input,
		startPosition = positionOf(input),
		card = card,
		ghost = nil,
		active = false,
	}
end

local function updateDrag(input: InputObject)
	local state = dragState
	if not state then
		return
	end
	if state.input.UserInputType == Enum.UserInputType.Touch then
		if input ~= state.input then
			return
		end
	elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local position = positionOf(input)
	if not state.active then
		if (position - state.startPosition).Magnitude < 8 then
			return
		end
		state.active = true
		selectedInventoryId = nil
		local layer = dragLayer
		if layer then
			local ghost = state.card:Clone()
			ghost.Name = "DraggedItem"
			ghost.AnchorPoint = Vector2.new(0.5, 0.5)
			ghost.Position = UDim2.fromOffset(position.X, position.Y)
			ghost.Active = false
			ghost.Selectable = false
			ghost.ZIndex = 100
			ghost.Parent = layer
			state.ghost = ghost
		end
		render()
	end
	if state.ghost then
		state.ghost.Position = UDim2.fromOffset(position.X, position.Y)
	end
end

local function finishDrag(input: InputObject)
	local state = dragState
	if not state then
		return
	end
	if state.input.UserInputType == Enum.UserInputType.Touch then
		if input ~= state.input then
			return
		end
	elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	dragState = nil
	if not state.active then
		return
	end

	suppressedId = state.instanceId
	suppressUntil = os.clock() + 0.2
	-- GuiObject.AbsolutePosition and InputObject.Position use the same inset-adjusted
	-- coordinates. GetMouseLocation is for positioning the drag ghost on its ScreenGui.
	local position = Vector2.new(input.Position.X, input.Position.Y)
	local targetSlot = HotbarRoot.getSlotAt(position)
	if targetSlot and targetSlot ~= InventoryConfig.hammerSlot and targetSlot ~= state.sourceSlot then
		local move = sendSlotMove
		if move then
			move(state.instanceId, targetSlot)
		end
	elseif state.sourceSlot and InventoryRoot.isDropPosition(position) then
		local remove = sendSlotRemove
		if remove then
			remove(state.instanceId)
		end
	end
	if state.ghost then
		state.ghost:Destroy()
	end
	scheduleRender()
end

local function suppressClick(instanceId: string): boolean
	return suppressedId == instanceId and os.clock() < suppressUntil
end
local function selectSlot(index: number)
	if selectedInventoryId and index ~= InventoryConfig.hammerSlot then
		local move = sendSlotMove
		if move then
			move(selectedInventoryId, index)
		end
		selectedInventoryId = nil
		scheduleRender()
		return
	end

	local hotbar = Data.hotbar() :: { string }
	local instanceId = hotbar[index]
	if typeof(instanceId) ~= "string" or instanceId == InventoryConfig.emptySlot then
		return
	end
	if suppressClick(instanceId) then
		return
	end
	local tool = findTool(instanceId)
	local currentCharacter = player.Character
	local humanoid = if currentCharacter then currentCharacter:FindFirstChildOfClass("Humanoid") else nil
	if not tool or not currentCharacter or not humanoid or humanoid.Health <= 0 then
		return
	end
	if tool.Parent == currentCharacter then
		humanoid:UnequipTools()
	elseif tool.Parent == backpack then
		humanoid:EquipTool(tool)
	end
end

function InventoryServiceClient:equipHatchedCrab(instanceId: string)
	if sendHatchClaim then
		sendHatchClaim(instanceId)
	end
	local hatchCharacter = player.Character
	if not hatchCharacter then
		return
	end
	task.spawn(function()
		local deadline = os.clock() + 3
		repeat
			if player.Character ~= hatchCharacter then
				return
			end
			local item = (Data.inventory() :: SavedInventory)[instanceId]
			local hotbar = Data.hotbar() :: { string }
			if item and string.match(item.itemId, "^Crab%.[%w_]+$")
				and table.find(hotbar, instanceId) then
				local tool = findTool(instanceId)
				local humanoid = hatchCharacter:FindFirstChildOfClass("Humanoid")
				if tool and humanoid and humanoid.Health > 0 then
					if tool.Parent == backpack then
						humanoid:EquipTool(tool)
					end
					return
				end
			end
			task.wait(0.05)
		until os.clock() >= deadline
	end)
end

function InventoryServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local networker = Networker.client.new("InventoryService", self)
	sendSlotMove = function(instanceId, slotIndex)
		networker:fire("setHotbarSlot", instanceId, slotIndex)
	end
	sendSlotRemove = function(instanceId)
		networker:fire("removeHotbarSlot", instanceId)
	end
	sendHatchClaim = function(instanceId)
		networker:fire("claimHatchedCrab", instanceId)
	end

	local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
	local dragGui = Instance.new("ScreenGui")
	dragGui.Name = "InventoryDragLayer"
	dragGui.ResetOnSpawn = false
	dragGui.IgnoreGuiInset = true
	dragGui.DisplayOrder = 100
	dragGui.Parent = playerGui
	dragLayer = dragGui
	HotbarRoot.mount(playerGui, selectSlot, function(instanceId, slotIndex, input, card)
		beginDrag(instanceId, slotIndex, input, card)
	end)
	InventoryRoot.mount(playerGui, function(instanceId)
		if suppressClick(instanceId) then
			return
		end
		local item = (Data.inventory() :: SavedInventory)[instanceId]
		if not item or not isHotbarEligible(item.itemId) then
			return
		end
		selectedInventoryId = if selectedInventoryId == instanceId then nil else instanceId
		scheduleRender()
	end, function()
		selectedInventoryId = nil
		scheduleRender()
	end, function(instanceId, input, card)
		beginDrag(instanceId, nil, input, card)
	end)

	bindBackpack(player:FindFirstChildOfClass("Backpack") :: Backpack?)
	bindCharacter(player.Character)
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			bindBackpack(child)
		end
	end)
	player.ChildRemoved:Connect(function(child)
		if child == backpack then
			bindBackpack(nil)
		end
	end)
	player.CharacterAdded:Connect(bindCharacter)
	player.CharacterRemoving:Connect(function(oldCharacter)
		if oldCharacter == character then
			bindCharacter(nil)
		end
	end)

	Data.inventory.Changed(scheduleRender)
	Data.hotbar.Changed(scheduleRender)
	scheduleRender()

	UserInputService.InputChanged:Connect(updateDrag)
	UserInputService.InputEnded:Connect(finishDrag)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.I then
			InventoryRoot.toggle()
			return
		end
		local index = keyToIndex[input.KeyCode]
		if index then
			selectSlot(index)
		end
	end)

	task.spawn(function()
		for _ = 1, 20 do
			local success = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			end)
			if success then
				return
			end
			task.wait(0.25)
		end
		warn("Could not hide the default Backpack bar")
	end)
end

return InventoryServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="509">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="510">
              <Properties>
                <string name="Name">HotbarRoot</string>
                <string name="Source"><![CDATA[--!strict

local HotbarSlot = require(script.Parent.HotbarSlot)

export type SlotView = {
	index: number,
	instanceId: string?,
	displayName: string,
	image: string,
	cardImage: string?,
	weightText: string?,
	count: number?,
	selected: boolean,
}

local SLOT_SIZE = 64
local SLOT_GAP = 5

local HotbarRoot = {}
local scrollFrame: ScrollingFrame? = nil
local row: Frame? = nil
local selectSlot: ((number) -> ())? = nil
local startDrag: ((string, number, InputObject, ImageButton) -> ())? = nil
local slotCount = 0

local function updateLayout()
	local scroll = scrollFrame
	local content = row
	if not scroll or not content then
		return
	end

	local rowWidth = if slotCount > 0 then slotCount * SLOT_SIZE + (slotCount - 1) * SLOT_GAP else 0
	content.Size = UDim2.fromOffset(rowWidth, SLOT_SIZE)
	if rowWidth <= scroll.AbsoluteSize.X then
		content.AnchorPoint = Vector2.new(0.5, 0)
		content.Position = UDim2.fromScale(0.5, 0)
	else
		content.AnchorPoint = Vector2.new(0, 0)
		content.Position = UDim2.fromOffset(0, 0)
	end
	scroll.CanvasSize = UDim2.fromOffset(math.max(rowWidth, scroll.AbsoluteSize.X), SLOT_SIZE)
	scroll.Visible = slotCount > 0
end

function HotbarRoot.mount(playerGui: PlayerGui, onSelect: (number) -> (), onDragStart: (string, number, InputObject, ImageButton) -> ()): ScreenGui
	if scrollFrame then
		local existing = scrollFrame:FindFirstAncestorOfClass("ScreenGui")
		if existing then
			return existing
		end
	end
	selectSlot = onSelect
	startDrag = onDragStart

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "InventoryHotbar"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.DisplayOrder = 10

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Slots"
	scroll.AnchorPoint = Vector2.new(0.5, 1)
	scroll.Position = UDim2.new(0.5, 0, 1, -10)
	scroll.Size = UDim2.new(0.86, 0, 0, SLOT_SIZE)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 0
	scroll.ScrollingDirection = Enum.ScrollingDirection.X
	scroll.ScrollingEnabled = true
	scroll.Active = true
	scroll.ClipsDescendants = true
	scroll.Parent = screenGui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(800, SLOT_SIZE)
	sizeConstraint.Parent = scroll

	local content = Instance.new("Frame")
	content.Name = "SlotRow"
	content.BackgroundTransparency = 1
	content.Size = UDim2.fromOffset(0, SLOT_SIZE)
	content.Parent = scroll

	scrollFrame = scroll
	row = content
	scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
	screenGui.Parent = playerGui
	updateLayout()
	return screenGui
end

function HotbarRoot.render(slots: { SlotView })
	local content = row
	local onSelect = selectSlot
	local onDragStart = startDrag
	if not content or not onSelect then
		return
	end

	for _, child in content:GetChildren() do
		child:Destroy()
	end

	slotCount = #slots
	for visualIndex, slot in slots do
		local slotIndex = slot.index
		local button = HotbarSlot.create({
			index = slotIndex,
			size = SLOT_SIZE,
			displayName = slot.displayName,
			image = slot.image,
			cardImage = slot.cardImage,
			weightText = slot.weightText,
			weightAtTopRight = true,
			countText = if slot.count then "x" .. tostring(slot.count) else nil,
			selected = slot.selected,
			onPointerDown = if slot.instanceId and onDragStart then function(input, card)
				onDragStart(slot.instanceId :: string, slotIndex, input, card)
			end else nil,
			onActivated = function()
				onSelect(slotIndex)
			end,
		})
		button:SetAttribute("SlotIndex", slotIndex)
		button.Position = UDim2.fromOffset((visualIndex - 1) * (SLOT_SIZE + SLOT_GAP), 0)
		button.Parent = content
	end
	updateLayout()
end

function HotbarRoot.getSlotAt(position: Vector2): number?
	local content = row
	if not content then
		return nil
	end
	for _, child in content:GetChildren() do
		if child:IsA("ImageButton") then
			local topLeft = child.AbsolutePosition
			local size = child.AbsoluteSize
			if position.X >= topLeft.X and position.X <= topLeft.X + size.X and position.Y >= topLeft.Y and position.Y <= topLeft.Y + size.Y then
				return child:GetAttribute("SlotIndex") :: number?
			end
		end
	end
	return nil
end
return HotbarRoot
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="511">
              <Properties>
                <string name="Name">HotbarSlot</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)

export type Props = {
	index: number,
	displayName: string,
	image: string,
	cardImage: string?,
	weightText: string?,
	weightAtTopRight: boolean?,
	countText: string?,
	selected: boolean,
	onActivated: () -> (),
	onPointerDown: ((InputObject, ImageButton) -> ())?,
	showNumber: boolean?,
	topText: string?,
	bottomText: string?,
	size: number?,
}

local function textLabel(name: string, value: string, position: UDim2, size: UDim2, maxTextSize: number, alignment: Enum.TextXAlignment): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Text = value
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.BuilderSansExtraBold
	label.TextScaled = true
	label.TextXAlignment = alignment
	label.ZIndex = 3

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 2
	stroke.Parent = label

	return label
end

local HotbarSlot = {}

function HotbarSlot.create(props: Props): ImageButton
	local button = Instance.new("ImageButton")
	button.Name = `Slot_{props.index}`
	button.Size = UDim2.fromOffset(props.size or 80, props.size or 80)
	button.BackgroundTransparency = 1
	button.Image = props.cardImage or `rbxassetid://{assets.InventoryCard}`
	button.ScaleType = Enum.ScaleType.Fit
	button.AutoButtonColor = false
	button.LayoutOrder = props.index
	button.ZIndex = 1

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = button

	local selectedStroke = Instance.new("UIStroke")
	selectedStroke.Name = "SelectedStroke"
	selectedStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	selectedStroke.Color = Color3.fromRGB(255, 215, 68)
	selectedStroke.Thickness = 2
	selectedStroke.Transparency = if props.selected then 0 else 1
	selectedStroke.Parent = button

	local image = Instance.new("ImageLabel")
	image.Name = "ItemImage"
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.Position = UDim2.fromScale(0.5, 0.45)
	image.Size = UDim2.fromScale(0.72, 0.7)
	image.BackgroundTransparency = 1
	image.Image = props.image
	image.ScaleType = Enum.ScaleType.Fit
	image.ZIndex = 2
	image.Parent = button

	if props.showNumber ~= false then
		local number = textLabel("SlotNumber", tostring(props.index), UDim2.fromScale(0.08, 0.02), UDim2.fromScale(0.28, 0.28), 20, Enum.TextXAlignment.Left)
		number.Parent = button
	end
	if props.topText then
		local top = textLabel("TopText", props.topText, UDim2.fromScale(0.06, 0.02), UDim2.fromScale(0.88, 0.24), 17, Enum.TextXAlignment.Center)
		top.TextTruncate = Enum.TextTruncate.AtEnd
		top.Parent = button
	end

	local title = textLabel("ItemName", props.bottomText or props.displayName, UDim2.fromScale(0.07, 0.73), UDim2.fromScale(0.86, 0.24), 18, Enum.TextXAlignment.Right)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Parent = button

	if props.weightText then
		local topRight = props.weightAtTopRight == true
		local position = if topRight then UDim2.fromScale(0.39, 0.02) else UDim2.fromScale(0.07, 0.73)
		local size = if topRight then UDim2.fromScale(0.54, 0.28) else UDim2.fromScale(0.62, 0.24)
		local alignment = if topRight then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local weight = textLabel("CrabWeight", props.weightText, position, size, 14, alignment)
		weight.Parent = button
	end
	if props.countText then
		local count = textLabel("StackCount", props.countText, UDim2.fromScale(0.45, 0.02), UDim2.fromScale(0.48, 0.28), 14, Enum.TextXAlignment.Right)
		count.Parent = button
	end

	if props.onPointerDown then
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				props.onPointerDown(input, button)
			end
		end)
	end
	button.Activated:Connect(props.onActivated)
	return button
end

return HotbarSlot
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="512">
              <Properties>
                <string name="Name">InventoryRoot</string>
                <string name="Source"><![CDATA[--!strict

local HotbarSlot = require(script.Parent.HotbarSlot)

export type EntryView = {
	instanceId: string,
	itemId: string,
	displayName: string,
	image: string,
	cardImage: string?,
	weightText: string?,
	count: number,
}

local InventoryRoot = {}
local panel: Frame? = nil
local toggleButton: TextButton? = nil
local list: ScrollingFrame? = nil
local searchBox: TextBox? = nil
local onSelect: ((string) -> ())? = nil
local startDrag: ((string, InputObject, ImageButton) -> ())? = nil
local onPanelClosed: (() -> ())? = nil
local toggleSound: Sound? = nil
local currentEntries: { EntryView } = {}
local currentSelectedId: string? = nil

local function addStroke(parent: Instance, thickness: number)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = thickness
	stroke.Parent = parent
end

local function setOpen(open: boolean)
	if panel then
		if panel.Visible == open then
			return
		end
		local sound = toggleSound
		if sound then
			sound.TimePosition = 0
			sound:Play()
		end
		panel.Visible = open
		if toggleButton then
			toggleButton.Visible = not open
		end
		if not open and onPanelClosed then
			onPanelClosed()
		end
	end
end

function InventoryRoot.mount(playerGui: PlayerGui, onItemSelected: (string) -> (), onClosed: () -> (), onDragStart: (string, InputObject, ImageButton) -> ())
	if panel and panel.Parent then
		return
	end
	onSelect = onItemSelected
	startDrag = onDragStart
	onPanelClosed = onClosed

	local screen = Instance.new("ScreenGui")
	screen.Name = "InventoryPanel"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 11
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local sound = Instance.new("Sound")
	sound.Name = "BackpackToggleSound"
	sound.SoundId = "rbxassetid://132948338000932"
	sound.Volume = 1
	sound.Parent = screen
	toggleSound = sound

	local toggle = Instance.new("TextButton")
	toggle.Name = "InventoryToggle"
	toggleButton = toggle
	toggle.AnchorPoint = Vector2.new(0.5, 1)
	toggle.Position = UDim2.new(0.5, 0, 1, -87)
	toggle.Size = UDim2.fromOffset(190, 50)
	toggle.BackgroundColor3 = Color3.fromRGB(85, 85, 85)
	toggle.BackgroundTransparency = 0.5
	toggle.BorderSizePixel = 0
	toggle.Font = Enum.Font.BuilderSansExtraBold
	toggle.Text = "Open Backpack"
	toggle.TextColor3 = Color3.new(1, 1, 1)
	toggle.TextScaled = true
	toggle.TextStrokeColor3 = Color3.new(0, 0, 0)
	toggle.TextStrokeTransparency = 0
	toggle.Parent = screen
	addStroke(toggle, 3)

	local toggleTextSize = Instance.new("UITextSizeConstraint")
	toggleTextSize.MaxTextSize = 23
	toggleTextSize.Parent = toggle

	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.59)
	frame.Size = UDim2.fromScale(0.58, 0.42)
	frame.BackgroundColor3 = Color3.fromRGB(22, 27, 25)
	frame.BackgroundTransparency = 0.17
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = screen
	panel = frame
	addStroke(frame, 4)

	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(1100, 600)
	limit.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0.02, 0, 0, 10)
	title.Size = UDim2.new(0.4, 0, 0, 48)
	title.Font = Enum.Font.BuilderSansExtraBold
	title.Text = "Backpack"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextStrokeColor3 = Color3.new(0, 0, 0)
	title.TextStrokeTransparency = 0
	title.Parent = frame
	local titleLimit = Instance.new("UITextSizeConstraint")
	titleLimit.MaxTextSize = 44
	titleLimit.Parent = title

	local search = Instance.new("TextBox")
	search.Name = "Search"
	search.AnchorPoint = Vector2.new(1, 0)
	search.Position = UDim2.new(0.9, 0, 0, 17)
	search.Size = UDim2.new(0.29, 0, 0, 42)
	search.BackgroundColor3 = Color3.fromRGB(220, 225, 225)
	search.BackgroundTransparency = 0.68
	search.BorderSizePixel = 0
	search.ClearTextOnFocus = false
	search.Font = Enum.Font.BuilderSansBold
	search.PlaceholderText = "Search"
	search.PlaceholderColor3 = Color3.fromRGB(225, 230, 225)
	search.Text = ""
	search.TextColor3 = Color3.new(1, 1, 1)
	search.TextSize = 25
	search.TextXAlignment = Enum.TextXAlignment.Left
	search.Parent = frame
	searchBox = search
	local searchCorner = Instance.new("UICorner")
	searchCorner.CornerRadius = UDim.new(0, 7)
	searchCorner.Parent = search
	local searchPadding = Instance.new("UIPadding")
	searchPadding.PaddingLeft = UDim.new(0, 10)
	searchPadding.Parent = search

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(0.98, 0, 0, 10)
	close.Size = UDim2.fromOffset(50, 50)
	close.BackgroundTransparency = 1
	close.Font = Enum.Font.BuilderSansExtraBold
	close.Text = "X"
	close.TextColor3 = Color3.new(1, 1, 1)
	close.TextScaled = true
	close.TextStrokeColor3 = Color3.new(0, 0, 0)
	close.TextStrokeTransparency = 0
	close.Parent = frame
	local closeLimit = Instance.new("UITextSizeConstraint")
	closeLimit.MaxTextSize = 45
	closeLimit.Parent = close
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Items"
	scroll.Position = UDim2.fromOffset(22, 98)
	scroll.Size = UDim2.new(1, -44, 1, -116)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = frame
	list = scroll

	local grid = Instance.new("UIGridLayout")
	grid.Name = "CardGrid"
	grid.CellSize = UDim2.fromOffset(80, 80)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll

	toggle.Activated:Connect(function()
		setOpen(not frame.Visible)
	end)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		InventoryRoot.render(currentEntries, currentSelectedId)
	end)
	screen.Parent = playerGui
end

function InventoryRoot.toggle()
	if panel then
		setOpen(not panel.Visible)
	end
end

function InventoryRoot.render(entries: { EntryView }, selectedId: string?)
	currentEntries = entries
	currentSelectedId = selectedId
	local scroll = list
	local selectItem = onSelect
	if not scroll or not selectItem then
		return
	end

	for _, child in scroll:GetChildren() do
		if child:IsA("GuiButton") or child.Name == "Empty" then
			child:Destroy()
		end
	end

	local query = if searchBox then string.lower(string.gsub(searchBox.Text, "^%s*(.-)%s*$", "%1")) else ""
	local shown = 0
	for _, entry in entries do
		if query == "" or string.find(string.lower(entry.displayName), query, 1, true) or string.find(string.lower(entry.itemId), query, 1, true) then
			shown += 1
			local instanceId = entry.instanceId
			local card = HotbarSlot.create({
				index = shown,
				displayName = entry.displayName,
				image = entry.image,
				cardImage = entry.cardImage,
				weightText = entry.weightText,
				selected = selectedId == instanceId,
				showNumber = false,
				topText = entry.displayName,
				bottomText = "x" .. tostring(entry.count),
				onPointerDown = if startDrag then function(input, draggedCard)
					startDrag(instanceId, input, draggedCard)
				end else nil,
				onActivated = function()
					selectItem(instanceId)
				end,
			})
			card.Name = instanceId
			card.LayoutOrder = shown
			card.Parent = scroll
		end
	end

	if shown == 0 then
		local empty = Instance.new("TextLabel")
		empty.Name = "Empty"
		empty.Size = UDim2.fromOffset(250, 80)
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.BuilderSansBold
		empty.Text = if query == "" then "No extra items" else "No matching items"
		empty.TextColor3 = Color3.fromRGB(225, 225, 225)
		empty.TextSize = 23
		empty.Parent = scroll
	end
end

function InventoryRoot.isDropPosition(position: Vector2): boolean
	local scroll = list
	if not panel or not panel.Visible or not scroll then
		return false
	end
	local topLeft = scroll.AbsolutePosition
	local size = scroll.AbsoluteSize
	return position.X >= topLeft.X and position.X <= topLeft.X + size.X
		and position.Y >= topLeft.Y and position.Y <= topLeft.Y + size.Y
end
return InventoryRoot
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="513">
          <Properties>
            <string name="Name">Money</string>
          </Properties>
          <Item class="ModuleScript" referent="514">
            <Properties>
              <string name="Name">MoneyServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Data = require(ReplicatedStorage.Source.Game.Data).client
local Vide = require(ReplicatedStorage.Packages.Vide)
local MoneyHud = require(script.Parent.UI.MoneyHud)

local MoneyServiceClient = {}
local initialized = false
local playCollection: (() -> ())? = nil

function MoneyServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local initialBalance = Data.money()
	local balance = Vide.source(initialBalance)
	local countingDown = Vide.source(false)
	local displayedBalance = initialBalance
	local savedBalance = initialBalance
	local startBalance = initialBalance
	local targetBalance = initialBalance
	local startTime = 0
	local animationConnection: RBXScriptConnection? = nil
	local function updateCountdown(now: number)
		local progress = math.clamp(now - startTime, 0, 1)
		displayedBalance = startBalance + (targetBalance - startBalance) * progress
		balance(displayedBalance)
		if progress >= 1 then
			if animationConnection then
				animationConnection:Disconnect()
				animationConnection = nil
			end
			countingDown(false)
		end
	end
	Vide.mount(function()
		local gui, play = MoneyHud({ balance = balance, countingDown = countingDown })
		playCollection = play
		return gui
	end, Players.LocalPlayer:WaitForChild("PlayerGui"))

	Data.money.Changed(function(value: number)
		local now = os.clock()
		if animationConnection then
			updateCountdown(now)
		end
		local previousSavedBalance = savedBalance
		savedBalance = value
		if value < previousSavedBalance then
			startBalance = displayedBalance
			targetBalance = value
			startTime = now
			countingDown(true)
			if not animationConnection then
				animationConnection = RunService.RenderStepped:Connect(function()
					updateCountdown(os.clock())
				end)
			end
		elseif animationConnection then
			local increase = value - previousSavedBalance
			startBalance += increase
			targetBalance = value
			displayedBalance += increase
			balance(displayedBalance)
		else
			displayedBalance = value
			balance(value)
		end
	end)
	local currentBalance = Data.money()
	if currentBalance ~= savedBalance then
		savedBalance = currentBalance
		displayedBalance = currentBalance
		balance(currentBalance)
	end
end

function MoneyServiceClient:playCollection()
	local play = playCollection
	if play then
		play()
	end
end

return MoneyServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="515">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="516">
              <Properties>
                <string name="Name">MoneyHud</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local create = Vide.create
local random = Random.new()

export type Props = {
	balance: () -> number,
	countingDown: () -> boolean,
}

local function MoneyHud(props: Props): (ScreenGui, () -> ())
	local gui = create "ScreenGui" {
		Name = "MoneyHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 25,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}

	local row = create "Frame" {
		Name = "BalanceRow",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 20, 0.5, 0),
		Size = UDim2.fromOffset(400, 76),
		BackgroundTransparency = 1,
	}
	row.Parent = gui

	create "UIListLayout" {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 0),
	}.Parent = row

	local pulseScale = create "UIScale" { Scale = 1 }
	pulseScale.Parent = row

	local coinIcon = create "ImageLabel" {
		Name = "CoinIcon",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(64, 64),
		Image = "rbxassetid://" .. assets.SandDollar,
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
	}
	coinIcon.Parent = row

	local amount = create "TextLabel" {
		Name = "Balance",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 70),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		Text = function()
			return CompactNumber.format(props.balance(), if props.countingDown() then 3 else nil)
		end,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextSize = 50,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.BuilderSansExtraBold,
	}
	amount.Parent = row
	create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}.Parent = amount

	local effectLayer = create "Frame" {
		Name = "CollectionCoins",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
	}
	effectLayer.Parent = gui

	local pulseTween: Tween? = nil
	local function pulseBalance()
		if pulseTween then
			pulseTween:Cancel()
		end
		pulseScale.Scale = 1
		local expand = TweenService:Create(pulseScale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1.2,
		})
		pulseTween = expand
		expand.Completed:Once(function(state)
			if state ~= Enum.PlaybackState.Completed then
				return
			end
			local shrink = TweenService:Create(pulseScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Scale = 1,
			})
			pulseTween = shrink
			shrink:Play()
		end)
		expand:Play()
	end

	local function playCollection()
		local screenSize = effectLayer.AbsoluteSize
		if screenSize.X <= 0 or screenSize.Y <= 0 then
			return
		end
		local center = screenSize / 2
		local target = coinIcon.AbsolutePosition + coinIcon.AbsoluteSize / 2 - effectLayer.AbsolutePosition
		local count = random:NextInteger(7, 10)
		local remaining = count
		for index = 1, count do
			local angle = random:NextNumber(0, math.pi * 2)
			local radius = random:NextNumber(25, math.min(165, screenSize.X * 0.16))
			local start = center + Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius * 0.7)
			local size = random:NextInteger(40, 56)
			local coin = create "ImageLabel" {
				Name = "FlyingCoin",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(start.X, start.Y),
				Size = UDim2.fromOffset(0, 0),
				BackgroundTransparency = 1,
				Image = "rbxassetid://" .. assets.SandDollar,
				ScaleType = Enum.ScaleType.Fit,
				Rotation = random:NextInteger(-25, 25),
				ZIndex = 21,
			}
			coin.Parent = effectLayer
			TweenService:Create(coin, TweenInfo.new(0.13, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.fromOffset(size, size),
			}):Play()
			task.delay(0.17 + (index - 1) * 0.035, function()
				if not coin.Parent then
					return
				end
				local fly = TweenService:Create(coin, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = UDim2.fromOffset(target.X, target.Y),
					Size = UDim2.fromOffset(25, 25),
					Rotation = 0,
				})
				fly.Completed:Once(function(state)
					coin:Destroy()
					if state == Enum.PlaybackState.Completed then
						remaining -= 1
						if remaining == 0 then
							pulseBalance()
						end
					end
				end)
				fly:Play()
			end)
		end
	end

	return gui, playCollection
end

return MoneyHud
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="517">
          <Properties>
            <string name="Name">Plots</string>
          </Properties>
          <Item class="Folder" referent="518">
            <Properties>
              <string name="Name">Classes</string>
            </Properties>
            <Item class="ModuleScript" referent="519">
              <Properties>
                <string name="Name">PlotClient</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local PlotClient = {}
PlotClient.__index = PlotClient

export type PlotClient = typeof(setmetatable({} :: {
	index: number,
	model: Model,
	ownerUserId: number,
	ownerChangedConnection: RBXScriptConnection?,
}, PlotClient))

function PlotClient.new(model: Model): PlotClient
	local index = model:GetAttribute("Index") :: number

	local ownerUserId = model:GetAttribute("OwnerUserId")
	local self = setmetatable({
		index = index,
		model = model,
		ownerUserId = if type(ownerUserId) == "number" then ownerUserId else 0,
		ownerChangedConnection = nil :: RBXScriptConnection?,
	}, PlotClient) :: PlotClient

	self.ownerChangedConnection = model:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		local owner = model:GetAttribute("OwnerUserId")
		self.ownerUserId = if type(owner) == "number" then owner else 0
	end)

	return self
end

function PlotClient.isLocal(self: PlotClient): boolean
	return self.ownerUserId == Players.LocalPlayer.UserId
end

function PlotClient.destroy(self: PlotClient)
	if self.ownerChangedConnection then
		self.ownerChangedConnection:Disconnect()
		self.ownerChangedConnection = nil
	end
end

return PlotClient
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="520">
            <Properties>
              <string name="Name">Modules</string>
            </Properties>
            <Item class="ModuleScript" referent="521">
              <Properties>
                <string name="Name">PlotExtraSlots</string>
                <string name="Source"><![CDATA[--!strict

local SLOT_ORDER = { "Left1", "Right1", "Left2", "Right2", "Left3", "Right3" }
local FLOOR_NAMES = { "PlotSecondFloor", "PlotThirdFloor", "PlotFourthFloor" }
local SLOTS_PER_FLOOR = #SLOT_ORDER

local PlotExtraSlots = {}

PlotExtraSlots.maxCount = #FLOOR_NAMES * SLOTS_PER_FLOOR
PlotExtraSlots.floorNames = FLOOR_NAMES

local purchaseNumbers: { [string]: number } = {}
for floorIndex = 1, #FLOOR_NAMES do
	for slotIndex, baseId in SLOT_ORDER do
		purchaseNumbers[baseId .. "_F" .. (floorIndex + 1)] = (floorIndex - 1) * SLOTS_PER_FLOOR + slotIndex
	end
end

function PlotExtraSlots.normalizeCount(value: any): number
	if typeof(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, PlotExtraSlots.maxCount)
end

function PlotExtraSlots.getPrice(purchasedCount: number): number?
	local count = PlotExtraSlots.normalizeCount(purchasedCount)
	if count >= PlotExtraSlots.maxCount then
		return nil
	end
	return math.floor(2500 * 1.966 ^ count + 0.5)
end

function PlotExtraSlots.getSlotInfo(purchaseNumber: number): (number?, string?, string?)
	if purchaseNumber % 1 ~= 0 or purchaseNumber < 1 or purchaseNumber > PlotExtraSlots.maxCount then
		return nil, nil, nil
	end
	local floorNumber = math.floor((purchaseNumber - 1) / SLOTS_PER_FLOOR) + 2
	local baseId = SLOT_ORDER[(purchaseNumber - 1) % SLOTS_PER_FLOOR + 1]
	return floorNumber, baseId, baseId .. "_F" .. floorNumber
end

function PlotExtraSlots.getPurchaseNumber(slotId: string): number?
	return purchaseNumbers[slotId]
end

return PlotExtraSlots
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="522">
            <Properties>
              <string name="Name">PlotServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Data = require(ReplicatedStorage.Source.Game.Data).client
local InventoryConfig = require(ReplicatedStorage.Source.Features.Inventory.InventoryConfig)
local Eggs = require(ReplicatedStorage.Source.Features.Egg.Modules.Eggs)
local Networker = require(ReplicatedStorage.Packages.Networker)
local PlotClient = require(script.Parent.Classes.PlotClient)
local Tanks = require(ReplicatedStorage.Source.Features.Tanks.Modules.Tanks)
local ExtraSlotSign = require(script.Parent.UI.ExtraSlotSign)
local TravelBar = require(script.Parent.UI.TravelBar)

local MAX_INTERACTION_DISTANCE = 10

local PlotServiceClient = {}
local initialized = false
local plots: { [number]: PlotClient.PlotClient } = {}
local indicators: { [string]: Model } = {}
local indicatorFolder: Folder? = nil
local activePlot: PlotClient.PlotClient? = nil
local prompt: ProximityPrompt? = nil
local promptSlotId: string? = nil
local promptMode: string? = nil
local sendPlace: ((string, string) -> ())? = nil
local sendPickup: ((string) -> ())? = nil
local mountedSigns: { [Model]: () -> () } = {}

local function addPlot(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local index = instance:GetAttribute("Index")
	if type(index) ~= "number" then
		return
	end
	local existing = plots[index]
	if existing then
		if existing.model == instance then
			return
		end
		existing:destroy()
	end
	plots[index] = PlotClient.new(instance)
end

local function removePlot(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local index = instance:GetAttribute("Index")
	if type(index) ~= "number" then
		return
	end
	local plot = plots[index]
	if plot and plot.model == instance then
		plot:destroy()
		plots[index] = nil
	end
end

local function getLocalPlot(): PlotClient.PlotClient?
	for _, plot in plots do
		if plot:isLocal() then
			return plot
		end
	end
	return nil
end

local function getEquippedItem(): (string?, string?)
	local character = Players.LocalPlayer.Character
	if not character then
		return nil, nil
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			local instanceId = child:GetAttribute("ItemInstanceId")
			local itemId = child:GetAttribute("ItemId")
			local tankId = if typeof(itemId) == "string" then string.match(itemId, "^Tank%.([%w_]+)$") else nil
			if typeof(instanceId) == "string" and typeof(itemId) == "string"
				and (itemId == "Incubator" or (tankId ~= nil and Tanks.get(tankId) ~= nil)) then
				return instanceId, itemId
			end
		end
	end
	return nil, nil
end

local function isHammerEquipped(): boolean
	local character = Players.LocalPlayer.Character
	if not character then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ItemId") == InventoryConfig.hammerItemId then
			return true
		end
	end
	return false
end

local function isEggEquipped(): boolean
	local character = Players.LocalPlayer.Character
	if not character then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			local itemId = child:GetAttribute("ItemId")
			local eggId = if typeof(itemId) == "string" then string.match(itemId, "^Egg%.([%w_]+)$") else nil
			if eggId and Eggs.get(eggId) and typeof(child:GetAttribute("ItemInstanceId")) == "string" then
				return true
			end
		end
	end
	return false
end

local function updateEggPrompts()
	local eggEquipped = isEggEquipped()
	for _, plot in plots do
		local placedItems = plot.model:FindFirstChild("PlacedItems")
		if not placedItems then
			continue
		end
		for _, model in placedItems:GetChildren() do
			if model:IsA("Model") and model:GetAttribute("ItemId") == "Incubator" then
				local eggPrompt = model:FindFirstChild("PlaceEggPrompt", true)
				if eggPrompt and eggPrompt:IsA("ProximityPrompt") then
					eggPrompt.Enabled = plot:isLocal() and eggEquipped and model:GetAttribute("IncubatingEggId") == nil
				end
			end
		end
	end
end

local function addDash(parent: Model, cframe: CFrame, size: Vector3)
	local dash = Instance.new("Part")
	dash.Name = "Dash"
	dash.Size = size
	dash.CFrame = cframe
	dash.Anchored = true
	dash.CanCollide = false
	dash.CanTouch = false
	dash.CanQuery = false
	dash.CastShadow = false
	dash.Material = Enum.Material.Neon
	dash.Color = Color3.new(1, 1, 1)
	dash.Parent = parent
end

local function makeOutline(slot: BasePart): Model
	local outline = Instance.new("Model")
	outline.Name = slot.Name .. "_Outline"
	local halfX = slot.Size.X / 2
	local halfZ = slot.Size.Z / 2
	local y = slot.Size.Y / 2 + 0.1
	for index = 1, 4 do
		local x = -halfX + (index - 0.5) * slot.Size.X / 4
		local z = -halfZ + (index - 0.5) * slot.Size.Z / 4
		local xLength = slot.Size.X / 7
		local zLength = slot.Size.Z / 7
		addDash(outline, slot.CFrame * CFrame.new(x, y, -halfZ), Vector3.new(xLength, 0.08, 0.16))
		addDash(outline, slot.CFrame * CFrame.new(x, y, halfZ), Vector3.new(xLength, 0.08, 0.16))
		addDash(outline, slot.CFrame * CFrame.new(-halfX, y, z), Vector3.new(0.16, 0.08, zLength))
		addDash(outline, slot.CFrame * CFrame.new(halfX, y, z), Vector3.new(0.16, 0.08, zLength))
	end
	outline.Parent = indicatorFolder
	return outline
end

local function clearIndicators()
	for slotId, outline in indicators do
		outline:Destroy()
		indicators[slotId] = nil
	end
end

local function getOccupied(plot: PlotClient.PlotClient): { [string]: Model }
	local occupied: { [string]: Model } = {}
	local folder = plot.model:FindFirstChild("PlacedItems")
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("Model") then
				local slotId = child:GetAttribute("SlotId")
				if typeof(slotId) == "string" then
					occupied[slotId] = child
				end
			end
		end
	end
	return occupied
end

local function updateInteraction()
	updateEggPrompts()
	local plot = getLocalPlot()
	if plot ~= activePlot then
		clearIndicators()
		activePlot = plot
	end
	local currentPrompt = prompt
	if not plot or not currentPrompt then
		if currentPrompt then
			currentPrompt.Parent = nil
		end
		promptSlotId = nil
		promptMode = nil
		return
	end

	local slots = plot.model:FindFirstChild("PlacementSlots")
	if not slots then
		return
	end
	local itemInstanceId, itemId = getEquippedItem()
	local hammerEquipped = isHammerEquipped()
	local occupied = getOccupied(plot)
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local closestSlot: BasePart? = nil
	local closestId: string? = nil
	local closestDistance = math.huge

	for _, slot in slots:GetChildren() do
		if not slot:IsA("BasePart") then
			continue
		end
		local slotId = slot.Name
		local placed = occupied[slotId]
		if itemInstanceId and not placed then
			if not indicators[slotId] then
				indicators[slotId] = makeOutline(slot)
			end
		elseif indicators[slotId] then
			indicators[slotId]:Destroy()
			indicators[slotId] = nil
		end

		if root and root:IsA("BasePart") and ((itemInstanceId and not placed) or (hammerEquipped and placed and placed:GetAttribute("IncubatingEggId") == nil and (placed:GetAttribute("ContainedCrabCount") or 0) == 0)) then
			local distance = (root.Position - slot.Position).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closestSlot = slot
				closestId = slotId
			end
		end
	end

	if not closestSlot or closestDistance > MAX_INTERACTION_DISTANCE then
		currentPrompt.Parent = nil
		promptSlotId = nil
		promptMode = nil
		return
	end
	local mode = if itemInstanceId then "place" else "pickup"
	promptSlotId = closestId
	promptMode = mode
	currentPrompt.ActionText = if mode == "place" then "Place" else "Pick Up"
	currentPrompt.ObjectText = if mode == "place" then (itemId :: string) else (occupied[closestId :: string]:GetAttribute("ItemId") :: string? or "Item")
	if currentPrompt.Parent ~= closestSlot then
		currentPrompt.Parent = closestSlot
	end
	currentPrompt.Enabled = true
end

function PlotServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local networker = Networker.client.new("PlotPlacement", self)
	sendPlace = function(instanceId, slotId)
		networker:fire("place", instanceId, slotId)
	end
	sendPickup = function(slotId)
		networker:fire("pickup", slotId)
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	TravelBar.mount(playerGui, function(destination: string)
		networker:fire("travel", destination)
	end)
	local balance = Vide.source(Data.money())
	Data.money.Changed(function(value: number)
		balance(value)
	end)

	local folder = Instance.new("Folder")
	folder.Name = "LocalPlacementIndicators"
	folder.Parent = Workspace
	indicatorFolder = folder

	local placePrompt = Instance.new("ProximityPrompt")
	placePrompt.Name = "PlacementPrompt"
	placePrompt.KeyboardKeyCode = Enum.KeyCode.E
	placePrompt.ActionText = "Place"
	placePrompt.ObjectText = "Item"
	placePrompt.HoldDuration = 0
	placePrompt.MaxActivationDistance = MAX_INTERACTION_DISTANCE
	placePrompt.RequiresLineOfSight = false
	placePrompt.Triggered:Connect(function()
		local slotId = promptSlotId
		if not slotId then
			return
		end
		if promptMode == "place" then
			local instanceId = getEquippedItem()
			if instanceId and sendPlace then
				sendPlace(instanceId, slotId)
			end
		elseif promptMode == "pickup" and isHammerEquipped() and sendPickup then
			sendPickup(slotId)
		end
	end)
	prompt = placePrompt

	local spawnedPlots = Workspace:WaitForChild("SpawnedPlots") :: Folder
	spawnedPlots.ChildAdded:Connect(addPlot)
	spawnedPlots.ChildRemoved:Connect(removePlot)
	local function mountSign(instance: Instance)
		if not instance:IsA("Model") or mountedSigns[instance] then
			return
		end
		local cleanup = ExtraSlotSign.mount(instance, playerGui, balance, function()
			networker:fire("buyExtraSlot")
		end)
		if cleanup then
			mountedSigns[instance] = cleanup
		end
	end
	local function unmountSign(instance: Instance)
		if instance:IsA("Model") and mountedSigns[instance] then
			mountedSigns[instance]()
			mountedSigns[instance] = nil
		end
	end
	spawnedPlots.ChildAdded:Connect(mountSign)
	spawnedPlots.ChildRemoved:Connect(unmountSign)
	for _, child in spawnedPlots:GetChildren() do
		addPlot(child)
		mountSign(child)
	end

	task.spawn(function()
		while initialized do
			updateInteraction()
			task.wait(0.1)
		end
	end)
end

function PlotServiceClient:getPlot(index: number): PlotClient.PlotClient?
	return plots[index]
end

function PlotServiceClient:getLocalPlot(): PlotClient.PlotClient?
	return getLocalPlot()
end

return PlotServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="523">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="524">
              <Properties>
                <string name="Name">ExtraSlotSign</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local PlotExtraSlots = require(ReplicatedStorage.Source.Features.Plots.Modules.PlotExtraSlots)

local create = Vide.create
local ExtraSlotSign = {}
local SLOT_IMAGE = "rbxassetid://85616034755765"

function ExtraSlotSign.mount(plotModel: Model, playerGui: PlayerGui, balance: () -> number, onBuy: () -> ()): (() -> ())?
	local sign = plotModel:FindFirstChild("ExtraSlotSign")
	local panel = if sign then sign:FindFirstChild("FrontPanel") else nil
	if not panel or not panel:IsA("BasePart") then
		return nil
	end

	local purchased = Vide.source(PlotExtraSlots.normalizeCount(plotModel:GetAttribute("ExtraSlotsPurchased")))
	local owner = Vide.source(plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId)
	local countConnection = plotModel:GetAttributeChangedSignal("ExtraSlotsPurchased"):Connect(function()
		purchased(PlotExtraSlots.normalizeCount(plotModel:GetAttribute("ExtraSlotsPurchased")))
	end)
	local ownerConnection = plotModel:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		owner(plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId)
	end)

	local cleanup = Vide.mount(function()
		local buttonText = Vide.derive(function()
			local price = PlotExtraSlots.getPrice(purchased())
			return if price then "BUY $" .. CompactNumber.format(price) else "MAX"
		end)
		local canBuy = Vide.derive(function()
			local price = PlotExtraSlots.getPrice(purchased())
			return owner() and price ~= nil and balance() >= (price or math.huge)
		end)
		local buttonColor = Vide.derive(function()
			local price = PlotExtraSlots.getPrice(purchased())
			if not owner() or not price then
				return Color3.fromRGB(115, 115, 115)
			end
			return if balance() < price then Color3.fromRGB(220, 48, 48) else Color3.fromRGB(0, 235, 37)
		end)
		local buttonStrokeColor = Vide.derive(function()
			local price = PlotExtraSlots.getPrice(purchased())
			if not owner() or not price then
				return Color3.fromRGB(65, 65, 65)
			end
			return if balance() < price then Color3.fromRGB(105, 15, 15) else Color3.fromRGB(9, 65, 33)
		end)
		local buySound = create "Sound" {
			Name = "BuyClickSound",
			SoundId = "rbxassetid://4612383453",
			Volume = 1,
		}
		return create "SurfaceGui" {
			Name = "ExtraSlotUpgrade",
			Adornee = panel,
			Face = Enum.NormalId.Front,
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = 80,
			LightInfluence = 0,
			AlwaysOnTop = false,
			Active = true,
			ToolPunchThroughDistance = 20,
			ResetOnSpawn = false,
			create "Frame" {
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				create "TextLabel" {
					Name = "Title",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.18),
					Size = UDim2.fromScale(0.94, 0.19),
					BackgroundTransparency = 1,
					Text = "BUY AN EXTRA SLOT",
					Font = Enum.Font.BuilderSansExtraBold,
					TextColor3 = Color3.new(1, 1, 1),
					TextScaled = true,
					create "UIStroke" {
						ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
						Color = Color3.new(0, 0, 0),
						Thickness = 3,
					},
				},
				create "ImageLabel" {
					Name = "ExtraSlotImage",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(0.78, 0.44),
					BackgroundTransparency = 1,
					Image = SLOT_IMAGE,
					ScaleType = Enum.ScaleType.Fit,
				},
				create "TextLabel" {
					Name = "QuantityBadge",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.8, 0.59),
					Size = UDim2.fromScale(0.2, 0.21),
					BackgroundTransparency = 1,
					Text = "+1",
					Font = Enum.Font.BuilderSansExtraBold,
					TextColor3 = Color3.new(1, 1, 1),
					TextScaled = true,
					create "UIStroke" {
						ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
						Color = Color3.new(0, 0, 0),
						Thickness = 3,
					},
				},
				create "TextButton" {
					Name = "BuyExtraSlotButton",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.82),
					Size = UDim2.fromScale(0.62, 0.17),
					BackgroundColor3 = buttonColor,
					BorderSizePixel = 0,
					AutoButtonColor = canBuy,
					Active = canBuy,
					Text = buttonText,
					Font = Enum.Font.BuilderSansExtraBold,
					TextColor3 = Color3.new(1, 1, 1),
					TextScaled = true,
					Activated = function()
						if canBuy() then
							onBuy()
							buySound.TimePosition = 0
							buySound:Play()
						end
					end,
					buySound,
					create "UICorner" { CornerRadius = UDim.new(0.16, 0) },
					create "UIStroke" { Color = buttonStrokeColor, Thickness = 4 },
				},
			},
		}
	end, playerGui)

	local function removeLegacyLettering(child: Instance)
		if child.Name == "Lettering" and child:IsA("SurfaceGui") then
			child:Destroy()
		end
	end
	local letteringConnection = panel.ChildAdded:Connect(removeLegacyLettering)
	local lettering = panel:FindFirstChild("Lettering")
	if lettering then
		removeLegacyLettering(lettering)
	end

	return function()
		letteringConnection:Disconnect()
		countConnection:Disconnect()
		ownerConnection:Disconnect()
		cleanup()
	end
end

return ExtraSlotSign
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="525">
              <Properties>
                <string name="Name">TravelBar</string>
                <string name="Source">--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local create = Vide.create

local TravelBar = {}
local CARD_COLOR = Color3.fromRGB(255, 176, 72)

local function card(name: string, position: UDim2, onActivated: () -&gt; ()): ImageButton
	local button = create "ImageButton" {
		Name = name,
		Position = position,
		Size = UDim2.fromOffset(196, 58),
		BackgroundTransparency = 1,
		Image = `rbxassetid://{assets.TopBarCard}`,
		ImageColor3 = CARD_COLOR,
		ScaleType = Enum.ScaleType.Stretch,
		AutoButtonColor = true,
		Activated = onActivated,
	}
	local title = create "TextLabel" {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		Size = UDim2.new(1, -16, 1, -8),
		BackgroundTransparency = 1,
		Text = string.upper(name),
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 1,
		Font = Enum.Font.BuilderSansExtraBold,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	title.Parent = button
	create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}.Parent = title
	return button
end

function TravelBar.mount(playerGui: PlayerGui, onTravel: (string) -&gt; ())
	Vide.mount(function()
		local gui = create "ScreenGui" {
			Name = "TravelBar",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 30,
		}
		local row = create "Frame" {
			Name = "Cards",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 5),
			Size = UDim2.fromOffset(408, 58),
			BackgroundTransparency = 1,
		}
		row.Parent = gui
		card("Home", UDim2.fromOffset(0, 0), function()
			onTravel("Home")
		end).Parent = row
		card("Shop", UDim2.fromOffset(212, 0), function()
			onTravel("Shop")
		end).Parent = row
		return gui
	end, playerGui)
end

return TravelBar</string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="526">
          <Properties>
            <string name="Name">Shop</string>
          </Properties>
          <Item class="Folder" referent="527">
            <Properties>
              <string name="Name">Modules</string>
            </Properties>
            <Item class="ModuleScript" referent="528">
              <Properties>
                <string name="Name">ShopStock</string>
                <string name="Source"><![CDATA[--!strict

type StockItem = {
	id: string,
	stockOdds: { number },
}

export type Stock = { [string]: number }

local ShopStock = {}

function ShopStock.roll(items: { StockItem }, rng: Random): Stock
	local stock: Stock = {}

	for _, item in items do
		local roll = rng:NextNumber(0, 100)
		local cumulative = 0
		local amount = 0
		for index, chance in item.stockOdds do
			cumulative += chance
			if roll < cumulative then
				amount = index - 1
				break
			end
		end
		stock[item.id] = amount
	end

	return stock
end

return ShopStock
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="529">
            <Properties>
              <string name="Name">ShopConfig</string>
              <string name="Source"><![CDATA[--!strict

export type ItemDefinition = {
	id: string,
	price: number,
	stockOdds: { number }, -- Percentages for 0, 1, 2, ... units.
}

local ShopConfig = {
	restockIntervalSeconds = 5 * 60,
	items = {
		{ id = "Incubator", price = 50, stockOdds = { 0, 50, 35, 15 } },
		{ id = "Small", price = 150, stockOdds = { 0, 55, 35, 10 } },
		{ id = "Medium", price = 10000, stockOdds = { 35, 50, 15 } },
		{ id = "Large", price = 100000, stockOdds = { 60, 35, 5 } },
	} :: { ItemDefinition },
}

function ShopConfig.getPrice(itemId: string): number?
	for _, item in ShopConfig.items do
		if item.id == itemId then
			return item.price
		end
	end
	return nil
end

return ShopConfig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="530">
            <Properties>
              <string name="Name">ShopServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Networker = require(ReplicatedStorage.Packages.Networker)
local Data = require(ReplicatedStorage.Source.Game.Data).client
local Tanks = require(ReplicatedStorage.Source.Features.Tanks.Modules.Tanks)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local ShopConfig = require(script.Parent.ShopConfig)
local ShopRoot = require(script.Parent.UI.ShopRoot)
local ShopPurchaseEffect = require(script.Parent.UI.ShopPurchaseEffect)
local ShopRestockNotice = require(script.Parent.UI.ShopRestockNotice)
local EggConveyorServiceClient = require(ReplicatedStorage.Source.Features.EggConveyor.EggConveyorServiceClient)

local ShopServiceClient = {}
local initialized = false
local pendingPurchases: { [string]: { imageId: number, position: Vector2 } } = {}
local playPurchase: ((number, Vector2, number?) -> ())? = nil
local showRestockNotice: (() -> ())? = nil
local lastNotifiedRestock: number? = nil
local stock = Vide.source({ Incubator = 0, Small = 0, Medium = 0, Large = 0 } :: { [string]: number })
local refreshAt = Vide.source(0)
local refreshSeconds = Vide.source(ShopConfig.restockIntervalSeconds)
local balance = Vide.source(0)

local displayItems: { ShopRoot.ItemView } = {
	{ id = "Incubator", name = "Incubator", price = ShopConfig.getPrice("Incubator"), imageId = assets.Incubator, imageScale = 1, imageOffsetX = 0.03 },
	{ id = "Small", name = "Small Tank", price = ShopConfig.getPrice("Small"), imageId = assets.SmallTank, imageScale = 1, imageOffsetX = 0.03 },
	{ id = "Medium", name = "Medium Tank", price = ShopConfig.getPrice("Medium"), imageId = assets.MediumTank, imageOffsetX = 0.01 },
	{ id = "Large", name = "Large Tank", price = ShopConfig.getPrice("Large"), imageId = assets.LargeTank },
}

function ShopServiceClient:init()
	if initialized then
		return
	end
	initialized = true

	local networker = Networker.client.new("ShopService", ShopServiceClient)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	playPurchase = ShopPurchaseEffect.mount(playerGui)
	showRestockNotice = ShopRestockNotice.mount(playerGui, "SHOP AND DECOR HAS RESTOCKED")
	local open = Vide.source(false)
	Data.money.Changed(function(value: number)
		balance(value)
	end)
	balance(Data.money())

	Vide.mount(function()
		return ShopRoot({
			items = displayItems,
			stock = function(itemId: string)
				return stock()[itemId] or 0
			end,
			isOpen = open,
			refreshSeconds = refreshSeconds,
			onClose = function()
				open(false)
			end,
			onBuy = function(itemId: string, startPosition: Vector2)
				local price = ShopConfig.getPrice(itemId)
				if not price or (stock()[itemId] or 0) <= 0 then
					return false
				end
				if balance() < price then
					EggConveyorServiceClient:showNotEnoughMoney()
					return false
				end
				local imageId: number? = nil
				for _, item in displayItems do
					if item.id == itemId then
						imageId = item.imageId
						break
					end
				end
				if not imageId then
					return false
				end
				local requestId = HttpService:GenerateGUID(false)
				local pending = { imageId = imageId, position = startPosition }
				pendingPurchases[requestId] = pending
				task.delay(5, function()
					if pendingPurchases[requestId] == pending then
						pendingPurchases[requestId] = nil
					end
				end)
				if itemId == "Incubator" then
					networker:fire("buyIncubator", requestId)
				elseif Tanks.get(itemId) then
					networker:fire("buyTank", itemId, requestId)
				else
					pendingPurchases[requestId] = nil
					return false
				end
				return true
			end,
		})
	end, playerGui)

	networker:fire("ready")
	local prompt = Workspace:WaitForChild("ShopStand"):WaitForChild("Noob"):WaitForChild("Torso"):WaitForChild("ProximityPrompt") :: ProximityPrompt
	prompt.RequiresLineOfSight = false
	prompt.Triggered:Connect(function()
		open(true)
	end)
	local standPart = prompt.Parent :: BasePart
	local closeDistance = prompt.MaxActivationDistance + 4
	task.spawn(function()
		while playerGui.Parent do
			local deadline = refreshAt()
			if deadline > 0 then
				refreshSeconds(math.max(0, math.ceil(deadline - Workspace:GetServerTimeNow())))
			end
			if open() then
				local character = Players.LocalPlayer.Character
				local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
				if not root or not root:IsA("BasePart")
					or (root.Position - standPart.Position).Magnitude > closeDistance then
					open(false)
				end
			end
			task.wait(0.2)
		end
	end)
end

function ShopServiceClient:updateStock(newStock: any, deadline: any, restocked: any)
	if typeof(newStock) ~= "table" or typeof(deadline) ~= "number" then
		return
	end
	local cleanStock = { Incubator = 0, Small = 0, Medium = 0, Large = 0 }
	for _, item in ShopConfig.items do
		local count = newStock[item.id]
		if typeof(count) == "number" and count >= 0 and count == math.floor(count) then
			cleanStock[item.id] = count
		end
	end
	stock(cleanStock)
	refreshAt(deadline)
	refreshSeconds(math.max(0, math.ceil(deadline - Workspace:GetServerTimeNow())))
	if restocked == true then
		self:showRestockNotice(deadline)
	end
end

function ShopServiceClient:showRestockNotice(deadline: number)
	if lastNotifiedRestock == deadline then
		return
	end
	lastNotifiedRestock = deadline
	local show = showRestockNotice
	if show then
		show()
	end
end

function ShopServiceClient:showNotEnoughMoney(requestId: any)
	if typeof(requestId) == "string" then
		pendingPurchases[requestId] = nil
	end
	EggConveyorServiceClient:showNotEnoughMoney()
end

function ShopServiceClient:showPurchasedItem(requestId: any, slotIndex: any)
	if typeof(requestId) ~= "string" then
		return
	end
	local pending = pendingPurchases[requestId]
	pendingPurchases[requestId] = nil
	if pending and playPurchase then
		playPurchase(pending.imageId, pending.position, if typeof(slotIndex) == "number" and slotIndex > 0 then slotIndex else nil)
	end
end

return ShopServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="531">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="532">
              <Properties>
                <string name="Name">ShopItemCard</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)

local create = Vide.create

export type Props = {
	id: string,
	name: string?,
	stock: () -> number,
	price: number?,
	boostPercent: number?,
	imageId: number?,
	imageScale: number?,
	imageOffsetX: number?,
	onBuy: (string, Vector2) -> boolean,
}

local function outlinedText(name: string, value: string | (() -> string), color: Color3, position: UDim2, size: UDim2, maxTextSize: number, strokeThickness: number?): TextLabel
	local label = create "TextLabel" {
		Name = name,
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Text = value,
		TextColor3 = color,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.BuilderSansExtraBold,
	}
	local stroke = create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = strokeThickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}
	stroke.Parent = label
	local constraint = create "UITextSizeConstraint" { MaxTextSize = maxTextSize }
	constraint.Parent = label
	return label
end

local function ShopItemCard(props: Props): ImageLabel
	local paper = create "ImageLabel" {
		Name = `ShopItem_{props.id}`,
		BackgroundTransparency = 1,
		Image = `rbxassetid://{assets.ShopPaperBanner}`,
		ScaleType = Enum.ScaleType.Stretch,
		Size = UDim2.new(1, -10, 0, 150),
	}

	if not (props.name and props.stock and props.price and props.imageId) then
		return paper
	end

	local iconBackground = create "ImageLabel" {
		Name = "ItemBackground",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.18, 0.5),
		Size = UDim2.fromScale(0.17, 0.82),
		BackgroundTransparency = 1,
		Image = `rbxassetid://{assets.ShopItemBackground}`,
		ScaleType = Enum.ScaleType.Stretch,
	}
	iconBackground.Parent = paper

	local icon = create "ImageLabel" {
		Name = "ItemImage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + (props.imageOffsetX or 0), 0.5),
		Size = UDim2.fromScale(0.82 * (props.imageScale or 1), 0.88 * (props.imageScale or 1)),
		BackgroundTransparency = 1,
		Image = `rbxassetid://{props.imageId}`,
		ScaleType = Enum.ScaleType.Crop,
	}
	icon.Parent = iconBackground

	outlinedText("ItemName", props.name, Color3.new(1, 1, 1), UDim2.fromScale(0.31, 0.02), UDim2.fromScale(0.55, 0.34), 58, 4).Parent = paper
	outlinedText("Stock", function()
		return `Stock: {props.stock()}`
	end, Color3.fromRGB(255, 255, 0), UDim2.fromScale(0.31, 0.37), UDim2.fromScale(if props.boostPercent then 0.34 else 0.48, 0.30), 52, 4).Parent = paper

	if props.boostPercent then
		local boost = outlinedText("TankIncomeBoost", `+{props.boostPercent}% Tank Income Boost`,
			Color3.fromRGB(80, 235, 88), UDim2.fromScale(0.68, 0.37), UDim2.fromScale(0.30, 0.22), 24, 3)
		boost.TextWrapped = true
		boost.TextXAlignment = Enum.TextXAlignment.Center
		boost.Parent = paper
	end
	local priceIcon = create "ImageLabel" {
		Name = "PriceIcon",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.295, 0.64),
		Size = UDim2.fromScale(0.08, 0.36),
		Image = `rbxassetid://{assets.SandDollar}`,
		ScaleType = Enum.ScaleType.Fit,
	}
	priceIcon.Parent = paper
	outlinedText("Price", CompactNumber.format(props.price :: number, if props.boostPercent then 1 else 0), Color3.new(1, 1, 1), UDim2.fromScale(0.38, 0.66), UDim2.fromScale(0.37, 0.30), 55, 4).Parent = paper

	local buyButtonPosition = UDim2.fromScale(0.83, 0.76)
	local random = Random.new()
	local confettiColors = {
		Color3.fromRGB(255, 222, 66),
		Color3.fromRGB(255, 100, 168),
		Color3.fromRGB(80, 211, 255),
		Color3.fromRGB(123, 235, 97),
		Color3.fromRGB(174, 115, 255),
	}

	local function showConfetti()
		for index = 1, 12 do
			local angle = (index - 1) * math.pi / 6 + random:NextNumber(-0.18, 0.18)
			local distance = random:NextNumber(100, 240)
			local piece = create "Frame" {
				Name = "BuyConfetti",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = buyButtonPosition,
				Size = UDim2.fromOffset(random:NextInteger(5, 7), random:NextInteger(7, 10)),
				Rotation = random:NextInteger(-35, 35),
				BackgroundColor3 = confettiColors[(index - 1) % #confettiColors + 1],
				BorderSizePixel = 0,
				ZIndex = 10,
			}
			piece.Parent = paper

			local tween = TweenService:Create(piece, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(buyButtonPosition.X.Scale, math.cos(angle) * distance, buyButtonPosition.Y.Scale, math.sin(angle) * distance),
				Size = UDim2.fromOffset(3, 5),
				Rotation = piece.Rotation + random:NextInteger(-120, 120),
				BackgroundTransparency = 1,
			})
			tween.Completed:Once(function()
				piece:Destroy()
			end)
			tween:Play()
		end
	end
	local buyScale = create "UIScale" { Scale = 1 }
	local buySound = create "Sound" {
		Name = "BuyClickSound",
		SoundId = "rbxassetid://4612383453",
		Volume = 1,
	}
	local hovered = false
	local buyTween: Tween? = nil
	local function tweenBuyScale(target: number, duration: number): Tween
		if buyTween then
			buyTween:Cancel()
		end
		local tween = TweenService:Create(buyScale, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = target,
		})
		buyTween = tween
		tween:Play()
		return tween
	end
	local buyButton = create "ImageButton" {
		Name = "BuyButton",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = buyButtonPosition,
		Size = UDim2.fromScale(0.22, 0.31),
		BackgroundTransparency = 1,
		Image = `rbxassetid://{assets.BuyButtonBackGround}`,
		ScaleType = Enum.ScaleType.Stretch,
		AutoButtonColor = false,
		MouseEnter = function()
			hovered = true
			tweenBuyScale(1.1, 0.12)
		end,
		MouseLeave = function()
			hovered = false
			tweenBuyScale(1, 0.12)
		end,
		Activated = function()
			if props.stock() <= 0 or not props.onBuy(props.id, icon.AbsolutePosition + icon.AbsoluteSize / 2) then
				return
			end
			buySound.TimePosition = 0
			buySound:Play()
			showConfetti()
			local pressTween = tweenBuyScale(0.94, 0.07)
			pressTween.Completed:Once(function(state)
				if state == Enum.PlaybackState.Completed then
					tweenBuyScale(if hovered then 1.1 else 1, 0.12)
				end
			end)
		end,
	}
	buyButton.Parent = paper
	buyScale.Parent = buyButton
	buySound.Parent = buyButton

	local buyText = outlinedText("BuyText", function()
		if props.stock() <= 0 then
			return "SOLD OUT"
		end
		return "BUY"
	end, Color3.new(1, 1, 1), UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 43)
	buyText.TextXAlignment = Enum.TextXAlignment.Center
	buyText.Parent = buyButton

	return paper
end

return ShopItemCard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="533">
              <Properties>
                <string name="Name">ShopPurchaseEffect</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create

local ShopPurchaseEffect = {}

local function centerOf(guiObject: GuiObject): Vector2
	return guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2
end

local function destination(playerGui: PlayerGui, slotIndex: number?): Vector2
	if slotIndex and slotIndex > 0 then
		local hotbar = playerGui:FindFirstChild("InventoryHotbar")
		local slots = if hotbar then hotbar:FindFirstChild("Slots") else nil
		local row = if slots then slots:FindFirstChild("SlotRow") else nil
		if row then
			for _, child in row:GetChildren() do
				if child:IsA("GuiButton") and child:GetAttribute("SlotIndex") == slotIndex then
					return centerOf(child)
				end
			end
		end
	end
	local inventory = playerGui:FindFirstChild("InventoryPanel")
	local toggle = if inventory then inventory:FindFirstChild("InventoryToggle") else nil
	if toggle and toggle:IsA("GuiObject") then
		return centerOf(toggle)
	end
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(800, 600)
	return Vector2.new(size.X / 2, size.Y - 75)
end

function ShopPurchaseEffect.mount(playerGui: PlayerGui, layerName: string?): (number, Vector2, number?) -> ()
	local layer: ScreenGui = nil :: any
	Vide.mount(function()
		layer = create "ScreenGui" {
			Name = layerName or "ShopPurchaseEffect",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 30,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
		return layer
	end, playerGui)

	return function(imageId: number, startPosition: Vector2, slotIndex: number?)
		local icon = create "ImageLabel" {
			Name = "PurchasedItem",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(startPosition.X, startPosition.Y),
			Size = UDim2.fromOffset(72, 72),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. imageId,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 2,
		}
		icon.Parent = layer

		local rise = TweenService:Create(icon, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(startPosition.X, startPosition.Y - 55),
			Size = UDim2.fromOffset(90, 90),
			Rotation = -12,
		})
		rise.Completed:Once(function(state)
			if state ~= Enum.PlaybackState.Completed or not icon.Parent then
				icon:Destroy()
				return
			end
			local target = destination(playerGui, slotIndex)
			local fall = TweenService:Create(icon, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(target.X, target.Y),
				Size = UDim2.fromOffset(35, 35),
				Rotation = 0,
			})
			fall.Completed:Once(function()
				icon:Destroy()
			end)
			fall:Play()
		end)
		rise:Play()
	end
end

return ShopPurchaseEffect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="534">
              <Properties>
                <string name="Name">ShopRestockNotice</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create

local ShopRestockNotice = {}

function ShopRestockNotice.mount(playerGui: PlayerGui, message: string?, guiName: string?): () -> ()
	local banner: Frame = nil :: any
	local label: TextLabel = nil :: any
	local stroke: UIStroke = nil :: any
	local sound: Sound = nil :: any

	Vide.mount(function()
		stroke = create "UIStroke" {
			Color = Color3.fromRGB(35, 18, 4),
			Thickness = 3,
			Transparency = 1,
		}
		label = create "TextLabel" {
			Name = "Message",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = message or "SHOP HAS RESTOCKED",
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			TextScaled = true,
			Font = Enum.Font.BuilderSansExtraBold,
			ZIndex = 2,
			stroke,
			create "UITextSizeConstraint" {
				MaxTextSize = 30,
			},
		}
		banner = create "Frame" {
			Name = "Banner",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 1 / 3),
			Size = UDim2.new(0.78, 0, 0, 48),
			BackgroundColor3 = Color3.fromRGB(232, 232, 232),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			create "UIGradient" {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(175, 175, 175)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(245, 245, 245)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(175, 175, 175)),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.16, 0),
					NumberSequenceKeypoint.new(0.84, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
			},
			label,
		}
		sound = create "Sound" {
			Name = "RestockSound",
			SoundId = "rbxassetid://123582256549202",
			Volume = 1,
		}
		return create "ScreenGui" {
			Name = guiName or "ShopRestockNotice",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 50,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			banner,
			sound,
		}
	end, playerGui)

	local version = 0
	return function()
		version += 1
		local currentVersion = version
		banner.Visible = true
		banner.BackgroundTransparency = 1
		label.TextTransparency = 1
		stroke.Transparency = 1
		sound.TimePosition = 0
		sound:Play()

		TweenService:Create(banner, TweenInfo.new(0.25), { BackgroundTransparency = 0 }):Play()
		TweenService:Create(label, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 0 }):Play()

		task.delay(3.25, function()
			if version ~= currentVersion then
				return
			end
			TweenService:Create(banner, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			local fade = TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 })
			fade.Completed:Once(function()
				if version == currentVersion then
					banner.Visible = false
				end
			end)
			fade:Play()
		end)
	end
end

return ShopRestockNotice
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="535">
              <Properties>
                <string name="Name">ShopRoot</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local ShopItemCard = require(script.Parent.ShopItemCard)

local create = Vide.create

export type ItemView = {
	id: string,
	name: string?,
	price: number?,
	boostPercent: number?,
	imageId: number?,
	imageScale: number?,
	imageOffsetX: number?,
}

export type Props = {
	items: { ItemView },
	stock: (string) -> number,
	isOpen: () -> boolean,
	refreshSeconds: (() -> number)?,
	refreshLabel: string?,
	title: string?,
	menuName: string?,
	titleMaxTextSize: number?,
	onClose: () -> (),
	onBuy: (string, Vector2) -> boolean,
}

local function ShopRoot(props: Props): Instance
	local cards: { ImageLabel } = {}
	for _, item in props.items do
		table.insert(cards, ShopItemCard({ id = item.id, name = item.name, stock = function()
			return props.stock(item.id)
		end, price = item.price, boostPercent = item.boostPercent, imageId = item.imageId, imageScale = item.imageScale, imageOffsetX = item.imageOffsetX, onBuy = props.onBuy }))
	end

	local visible = Vide.source(false)
	local openSound = create "Sound" {
		Name = "OpenSound",
		SoundId = "rbxassetid://127488139302452",
		Volume = 1,
	}
	local closeSound = create "Sound" {
		Name = "CloseSound",
		SoundId = "rbxassetid://132948338000932",
		Volume = 1,
	}
	local closeScale = create "UIScale" { Scale = 1 }
	local hoverTween: Tween? = nil
	local function setCloseScale(scale: number)
		if hoverTween then
			hoverTween:Cancel()
		end
		local tween = TweenService:Create(closeScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = scale,
		})
		hoverTween = tween
		tween:Play()
	end

	local refreshText = Vide.derive(function()
		local getRefreshSeconds = props.refreshSeconds
		if not getRefreshSeconds then
			return ""
		end
		local remaining = getRefreshSeconds()
		return string.format("%s %02d:%02d", props.refreshLabel or "Shop Refresh", math.floor(remaining / 60), remaining % 60)
	end)
	local timerLabel = create "TextLabel" {
		Name = "RefreshTimer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(0.88, 0.085),
		Size = UDim2.fromScale(0.5, 0.13),
		BackgroundTransparency = 1,
		Visible = props.refreshSeconds ~= nil,
		Text = refreshText,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.BuilderSansExtraBold,
	}
	local timerTextSize = create "UITextSizeConstraint" { MaxTextSize = 36 }
	timerTextSize.Parent = timerLabel
	local timerStroke = create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}
	timerStroke.Parent = timerLabel
	local screenGui = create "ScreenGui" {
		Name = props.menuName or "ShopMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = visible,

		openSound,
		closeSound,
		create "ImageLabel" {
			Name = "Background",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.53),
			Size = UDim2.fromScale(0.88, 0.64),
			BackgroundTransparency = 1,
			Image = `rbxassetid://{assets.ShopBackground}`,
			ScaleType = Enum.ScaleType.Stretch,

			create "UIAspectRatioConstraint" {
				AspectRatio = 1.86,
				DominantAxis = Enum.DominantAxis.Height,
			},
			create "UISizeConstraint" {
				MaxSize = Vector2.new(900, 500),
			},
			create "ImageLabel" {
				Name = "ShopSign",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.08, 0.05),
				Size = UDim2.fromScale(0.4, 0.26),
				BackgroundTransparency = 1,
				Image = `rbxassetid://{assets.WoodenPlankShop}`,
				ScaleType = Enum.ScaleType.Fit,

				create "TextLabel" {
					Name = "Title",
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 0.85),
					Position = UDim2.fromScale(0, 0.02),
					Text = props.title or "SHOP",
					TextColor3 = Color3.fromRGB(255, 255, 255),
					TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
					TextStrokeTransparency = 1,
					Font = Enum.Font.BuilderSansExtraBold,
					TextScaled = true,
					Rotation = -8,
					create "UITextSizeConstraint" { MaxTextSize = props.titleMaxTextSize or 84 },
					create "UIStroke" {
						ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
						Color = Color3.fromRGB(0, 0, 0),
						Thickness = 5,
					},
				},
			},
			timerLabel,
			create "ImageButton" {
				Name = "CloseButton",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.985, 0.04),
				Size = UDim2.fromScale(0.08, 0.15),
				BackgroundTransparency = 1,
				Image = `rbxassetid://{assets.ExitButton}`,
				ScaleType = Enum.ScaleType.Fit,
				MouseEnter = function()
				setCloseScale(1.1)
			end,
			MouseLeave = function()
				setCloseScale(1)
			end,
			Activated = function()
				setCloseScale(1)
				closeSound:Play()
				props.onClose()
			end,
			closeScale,
			},
			create "ScrollingFrame" {
				Name = "ItemList",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.56),
				Size = UDim2.fromScale(0.91, 0.81),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 7,
				ScrollBarImageColor3 = Color3.fromRGB(89, 43, 8),
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				create "UIListLayout" {
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					Padding = UDim.new(0, 12),
				},
				create "UIPadding" {
					PaddingTop = UDim.new(0, 6),
					PaddingBottom = UDim.new(0, 6),
				},
				cards,
			},
		},
	}

	local background = screenGui:FindFirstChild("Background") :: ImageLabel
	local itemList = background:FindFirstChild("ItemList") :: ScrollingFrame
	local function resizeCards()
		-- Two cards fit inside the viewport, including the gap and vertical padding.
		local cardHeight = math.max(184, math.floor((itemList.AbsoluteSize.Y - 24) / 2))
		for _, card in cards do
			card.Size = UDim2.new(1, -10, 0, cardHeight)
		end
	end
	itemList:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizeCards)
	resizeCards()
	local shownPosition = UDim2.fromScale(0.5, 0.53)
	local hiddenPosition = UDim2.fromScale(0.5, 1.6)
	local panelTween: Tween? = nil
	local animationVersion = 0
	local shown = false
	local wasOpen = false

	background.Position = hiddenPosition

	Vide.effect(function()
		local shouldOpen = props.isOpen()
		if shouldOpen == wasOpen then
			return
		end
		wasOpen = shouldOpen
		animationVersion += 1
		local version = animationVersion

		if panelTween then
			panelTween:Cancel()
		end

		if shouldOpen then
			if not shown then
				background.Position = hiddenPosition
			end
			shown = true
			visible(true)
			openSound:Play()
			local openingTween = TweenService:Create(background, TweenInfo.new(.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = shownPosition,
			})
			panelTween = openingTween
			openingTween:Play()
		elseif shown then
			local closingTween = TweenService:Create(background, TweenInfo.new(.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = hiddenPosition,
			})
			panelTween = closingTween
			closingTween.Completed:Once(function(playbackState)
				if playbackState == Enum.PlaybackState.Completed and animationVersion == version then
					shown = false
					visible(false)
				end
			end)
			closingTween:Play()
		else
			background.Position = hiddenPosition
		end
	end)

	return screenGui
end

return ShopRoot
]]></string>
