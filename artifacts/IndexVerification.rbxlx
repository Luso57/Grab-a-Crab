                  <string name="Name">func</string>
                  <string name="Source"><![CDATA[local function truthy()
	return true
end

local function noop() end

local function returned(...)
	return ...
end

return {
	truthy = truthy,
	noop = noop,
	returned = returned,
}
]]></string>
