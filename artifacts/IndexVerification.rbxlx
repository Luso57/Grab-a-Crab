            <Item class="ModuleScript" referent="538">
              <Properties>
                <string name="Name">ShopMonoButton</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)

local create = Vide.create
local ShopMonoButton = {}
local BUTTON_SIZE = 80
local CENTER_OFFSET = 44

function ShopMonoButton.mount(playerGui: PlayerGui)
	local hoverScale = create "UIScale" { Scale = 1 }
	local hoverTween: Tween? = nil
	local function setHovered(hovered: boolean)
		if hoverTween then
			hoverTween:Cancel()
		end
		hoverTween = TweenService:Create(hoverScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = if hovered then 1.08 else 1,
		})
		hoverTween:Play()
	end

	local rainbow = create "UIGradient" {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 180, 40)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 245, 55)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(65, 235, 95)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(35, 180, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(155, 65, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 70)),
		}),
		Rotation = 0,
	}
	local border = create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 4,
		Color = Color3.new(1, 1, 1),
	}
	rainbow.Parent = border

	local button = create "ImageButton" {
		Name = "ShopMonoButton",
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
		Position = UDim2.new(1, -16, 0.5, -CENTER_OFFSET),
		BackgroundColor3 = Color3.fromRGB(11, 10, 19),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Image = "",
		AutoButtonColor = false,
		MouseEnter = function()
			setHovered(true)
		end,
		MouseLeave = function()
			setHovered(false)
		end,
		Activated = function() end,
	}
	hoverScale.Parent = button
	create "UICorner" { CornerRadius = UDim.new(0, 4) }.Parent = button
	border.Parent = button

	create "ImageLabel" {
		Name = "ShopIcon",
		Position = UDim2.fromScale(0.05, 0.05),
		Size = UDim2.fromScale(0.9, 0.72),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.ShopMonoButtonIcon,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 2,
	}.Parent = button

	local title = create "TextLabel" {
		Name = "ShopLabel",
		Position = UDim2.fromScale(0.02, 0.76),
		Size = UDim2.fromScale(0.96, 0.24),
		BackgroundTransparency = 1,
		Text = "Shop",
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		Font = Enum.Font.BuilderSansExtraBold,
		ZIndex = 3,
	}
	create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Color = Color3.new(0, 0, 0),
		Thickness = 2,
	}.Parent = title
	create "UITextSizeConstraint" { MaxTextSize = 20 }.Parent = title
	title.Parent = button

	local screen = create "ScreenGui" {
		Name = "ShopMonoButtonGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}
	button.Parent = screen
	Vide.mount(function()
		return screen
	end, playerGui)

	local rainbowTween = TweenService:Create(rainbow, TweenInfo.new(12, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), {
		Rotation = 360,
	})
	rainbowTween:Play()

	local viewportConnection: RBXScriptConnection? = nil
	local function layout()
		local camera = Workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local scale = math.clamp(math.min(viewport.X / 1000, viewport.Y / 650), 0.7, 1)
		button.Size = UDim2.fromOffset(math.round(BUTTON_SIZE * scale), math.round(BUTTON_SIZE * scale))
		button.Position = UDim2.new(1, -math.round(16 * scale), 0.5, -math.round(CENTER_OFFSET * scale))
	end
	local function watchCamera()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		local camera = Workspace.CurrentCamera
		viewportConnection = if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout) else nil
		layout()
	end
	local cameraConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	screen.Destroying:Connect(function()
		cameraConnection:Disconnect()
		if viewportConnection then
			viewportConnection:Disconnect()
		end
		if hoverTween then
			hoverTween:Cancel()
		end
		rainbowTween:Cancel()
	end)
	watchCamera()
end

return ShopMonoButton
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="539">
          <Properties>
            <string name="Name">Tanks</string>
          </Properties>
          <Item class="Folder" referent="540">
            <Properties>
              <string name="Name">Classes</string>
            </Properties>
            <Item class="ModuleScript" referent="541">
              <Properties>
                <string name="Name">TankClient</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local TankCrabAnimatorClient = require(script.Parent.TankCrabAnimatorClient)
local TankCrabBillboard = require(script.Parent.Parent.UI.TankCrabBillboard)
local MoneyPadDisplay = require(script.Parent.Parent.UI.MoneyPadDisplay)

local TankClient = {}
TankClient.__index = TankClient

export type TankClient = typeof(setmetatable({} :: {
	instanceId: string,
	model: Model,
	onOpen: (Model) -> (),
	onCollect: () -> (),
	animators: { [BasePart]: TankCrabAnimatorClient.TankCrabAnimatorClient },
	destroyBillboard: () -> (),
	destroyMoneyPadDisplay: () -> (),
	openPrompt: ProximityPrompt?,
	openConnection: RBXScriptConnection?,
	collectionConnection: RBXScriptConnection?,
	pulsePart: BasePart?,
	pulseTween: Tween?,
}, TankClient))

function TankClient.new(instanceId: string, model: Model, onOpen: (Model) -> (), onCollect: () -> ()): TankClient
	local self = setmetatable({
		instanceId = instanceId,
		model = model,
		onOpen = onOpen,
		onCollect = onCollect,
		animators = {} :: { [BasePart]: TankCrabAnimatorClient.TankCrabAnimatorClient },
		destroyBillboard = TankCrabBillboard.attach(model),
		destroyMoneyPadDisplay = MoneyPadDisplay.attach(model),
		openPrompt = nil :: ProximityPrompt?,
		openConnection = nil :: RBXScriptConnection?,
		collectionConnection = nil :: RBXScriptConnection?,
		pulsePart = nil :: BasePart?,
		pulseTween = nil :: Tween?,
	}, TankClient) :: TankClient
	local lastCollectionSerial = model:GetAttribute("MoneyPadCollectionSerial")
	self.collectionConnection = model:GetAttributeChangedSignal("MoneyPadCollectionSerial"):Connect(function()
		local serial = model:GetAttribute("MoneyPadCollectionSerial")
		if typeof(serial) == "number" and typeof(lastCollectionSerial) == "number" and serial > lastCollectionSerial then
			self:playMoneyPadPulse()
			self.onCollect()
		end
		lastCollectionSerial = serial
	end)
	return self
end

function TankClient.clearMoneyPadPulse(self: TankClient)
	if self.pulseTween then
		self.pulseTween:Cancel()
		self.pulseTween = nil
	end
	if self.pulsePart then
		self.pulsePart:Destroy()
		self.pulsePart = nil
	end
end

function TankClient.playMoneyPadPulse(self: TankClient)
	self:clearMoneyPadPulse()
	local pad = self.model:FindFirstChild("MoneyPad")
	local green = if pad then pad:FindFirstChild("GreenInnerCircle") else nil
	local blue = if pad then pad:FindFirstChild("BlueOuterCircle") else nil
	if not green or not green:IsA("BasePart") or not blue or not blue:IsA("BasePart") then
		return
	end

	local pulse = green:Clone()
	pulse.Name = "MoneyPadPulse"
	pulse:ClearAllChildren()
	pulse.Anchored = true
	pulse.CanCollide = false
	pulse.CanTouch = false
	pulse.CanQuery = false
	pulse.CastShadow = false
	pulse.CFrame = green.CFrame + Vector3.new(0, 0.015, 0)
	pulse.Parent = pad
	self.pulsePart = pulse

	local expandedSize = Vector3.new(green.Size.X, math.max(green.Size.Y, blue.Size.Y - 0.04), math.max(green.Size.Z, blue.Size.Z - 0.04))
	local expand = TweenService:Create(pulse, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = expandedSize })
	self.pulseTween = expand
	expand.Completed:Once(function(state)
		if state ~= Enum.PlaybackState.Completed or self.pulsePart ~= pulse then
			return
		end
		local shrink = TweenService:Create(pulse, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = green.Size })
		self.pulseTween = shrink
		shrink.Completed:Once(function()
			if self.pulsePart == pulse then
				self:clearMoneyPadPulse()
			end
		end)
		shrink:Play()
	end)
	expand:Play()
end

function TankClient.syncCrabs(self: TankClient)
	local folder = self.model:FindFirstChild("ContainedCrabs")
	local floor = self.model:FindFirstChild("InsideFloor", true)
	if not folder or not floor or not floor:IsA("BasePart") then
		return
	end

	local present: { [BasePart]: boolean } = {}
	for _, child in folder:GetChildren() do
		if child:IsA("BasePart") and child.Name == "ContainedCrabAnchor" then
			present[child] = true
			if not self.animators[child] then
				local animator = TankCrabAnimatorClient.new(child, floor, self.model)
				if animator then
					self.animators[child] = animator
				end
			end
		end
	end

	for anchor, animator in self.animators do
		if not present[anchor] then
			animator:destroy()
			self.animators[anchor] = nil
		end
	end
end

function TankClient.update(self: TankClient, hasCrabEquipped: boolean, isPlacingDecoration: boolean)
	self:syncCrabs()
	local floor = self.model:FindFirstChild("InsideFloor", true)
	if not floor or not floor:IsA("BasePart") then
		return
	end
	if not self.openPrompt then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "OpenTankPrompt"
		prompt.ActionText = "Open"
		prompt.ObjectText = "Tank"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Enabled = false
		prompt.Parent = floor
		self.openPrompt = prompt
		self.openConnection = prompt.Triggered:Connect(function(player)
			if player == Players.LocalPlayer and prompt.Enabled then
				self.onOpen(self.model)
			end
		end)
	end

	local placedFolder = self.model.Parent
	local plotModel = if placedFolder then placedFolder.Parent else nil
	local isOwner = placedFolder ~= nil and placedFolder.Name == "PlacedItems"
		and plotModel ~= nil and plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId
	local capacity = self.model:GetAttribute("TankCapacity")
	local count = self.model:GetAttribute("ContainedCrabCount")
	local isFull = typeof(capacity) == "number" and typeof(count) == "number" and count >= capacity
	self.openPrompt.Enabled = isOwner and not isPlacingDecoration and (not hasCrabEquipped or isFull)

	local placePrompt = self.model:FindFirstChild("PlaceCrabPrompt", true)
	if placePrompt and placePrompt:IsA("ProximityPrompt") then
		placePrompt.Enabled = isOwner and hasCrabEquipped and not isPlacingDecoration
			and typeof(capacity) == "number" and typeof(count) == "number" and count < capacity
	end
end

function TankClient.step(self: TankClient, dt: number, cameraPosition: Vector3)
	for _, animator in self.animators do
		animator:step(dt, cameraPosition)
	end
end

function TankClient.correctContainment(self: TankClient, cameraPosition: Vector3)
	for _, animator in self.animators do
		animator:correctContainment(cameraPosition)
	end
end

function TankClient.destroy(self: TankClient)
	if self.collectionConnection then
		self.collectionConnection:Disconnect()
		self.collectionConnection = nil
	end
	self:clearMoneyPadPulse()
	self.destroyBillboard()
	self.destroyMoneyPadDisplay()
	if self.openConnection then
		self.openConnection:Disconnect()
		self.openConnection = nil
	end
	if self.openPrompt then
		self.openPrompt:Destroy()
		self.openPrompt = nil
	end
	local placePrompt = self.model:FindFirstChild("PlaceCrabPrompt", true)
	if placePrompt and placePrompt:IsA("ProximityPrompt") then
		placePrompt.Enabled = false
	end
	for anchor, animator in self.animators do
		animator:destroy()
		self.animators[anchor] = nil
	end
end

return TankClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="542">
              <Properties>
                <string name="Name">TankCrabAnimatorClient</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabRigBuilder = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabRigBuilder)
local Config = require(script.Parent.Parent.Modules.TankAnimationConfig)

local TankCrabAnimatorClient = {}
TankCrabAnimatorClient.__index = TankCrabAnimatorClient

export type TankCrabAnimatorClient = typeof(setmetatable({} :: {
	marker: BasePart,
	floor: BasePart,
	tankModel: Model,
	visual: Model,
	joints: { [string]: Motor6D },
	random: Random,
	state: string,
	elapsed: number,
	duration: number,
	cycle: number,
	motionTime: number,
	handstandCooldown: number,
	bottomCooldown: number,
	bottomMovesRemaining: number,
	offset: Vector3,
	fromOffset: Vector3,
	targetOffset: Vector3,
	controlOffset: Vector3,
	trickOrigin: Vector3,
	orientation: CFrame,
	fromOrientation: CFrame,
	targetOrientation: CFrame,
	trickOrientation: CFrame,
	minOffset: Vector3,
	maxOffset: Vector3,
	boxSize: Vector3,
	boundsCorners: { Vector3 },
	footCorners: { Vector3 },
	feet: { BasePart },
	floatMinOffsetY: number,
	bottomFloorOffsetY: number,
	roofHeight: number,
	farElapsed: number,
	destroyed: boolean,
}, TankCrabAnimatorClient))

local function getJoints(visual: Model): { [string]: Motor6D }
	local joints: { [string]: Motor6D } = {}
	for _, descendant in visual:GetDescendants() do
		if descendant:IsA("Motor6D") then
			local role = descendant.Name:match("^CrabRig_(.+)$")
			if role then
				joints[role] = descendant
			end
		end
	end
	return joints
end

local function appendPartCorners(corners: { Vector3 }, part: BasePart, origin: CFrame)
	local half = part.Size / 2
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local worldCorner = part.CFrame:PointToWorldSpace(Vector3.new(x * half.X, y * half.Y, z * half.Z))
				table.insert(corners, origin:PointToObjectSpace(worldCorner))
			end
		end
	end
end

local function lowestPartY(part: BasePart, floor: BasePart): number
	local half = part.Size / 2
	local lowest = math.huge
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local corner = part.CFrame:PointToWorldSpace(Vector3.new(x * half.X, y * half.Y, z * half.Z))
				lowest = math.min(lowest, floor.CFrame:PointToObjectSpace(corner).Y)
			end
		end
	end
	return lowest
end

local function seedFromId(instanceId: string): number
	local seed = 17
	for index = 1, #instanceId do
		seed = (seed * 33 + string.byte(instanceId, index)) % 2147483647
	end
	return seed
end

local function randomOrientation(random: Random): CFrame
	return CFrame.Angles(
		random:NextNumber(-math.pi, math.pi),
		random:NextNumber(-math.pi, math.pi),
		random:NextNumber(-math.pi, math.pi)
	)
end

function TankCrabAnimatorClient.new(marker: BasePart, floor: BasePart, tankModel: Model): TankCrabAnimatorClient?
	local crabId = marker:GetAttribute("CrabId")
	local instanceId = marker:GetAttribute("ItemInstanceId")
	local displayScale = marker:GetAttribute("DisplayScale")
	if typeof(crabId) ~= "string" or typeof(instanceId) ~= "string" or typeof(displayScale) ~= "number" then
		return nil
	end
	local definition = Crabs.get(crabId)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local crabs = if assets then assets:FindFirstChild("Crabs") else nil
	local template = if definition and crabs then crabs:FindFirstChild(definition.modelName) else nil
	if not template or not template:IsA("Model") then
		warn("Missing animated crab model:", crabId)
		return nil
	end

	local visual = template:Clone()
	local body = CrabRigBuilder.rig(visual)
	if not body then
		visual:Destroy()
		return nil
	end
	visual:ScaleTo(displayScale)
	visual.Name = "AnimatedCrab"
	visual:SetAttribute("ItemInstanceId", instanceId)
	visual:SetAttribute("CrabId", crabId)
	for _, descendant in visual:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = descendant == body
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
		elseif descendant:IsA("ProximityPrompt") then
			descendant:Destroy()
		end
	end
	visual:PivotTo(marker.CFrame)
	visual.Parent = marker.Parent

	local boxCFrame, boxSize = visual:GetBoundingBox()
	local joints = getJoints(visual)
	local feet: { BasePart } = {}
	local footCorners: { Vector3 } = {}
	for _, side in { "L", "R" } do
		for index = 1, 4 do
			local joint = joints[string.format("Leg_%s_%02d", side, index)]
			if joint and joint.Part1 then
				local foot = joint.Part1
				table.insert(feet, foot)
				appendPartCorners(footCorners, foot, marker.CFrame)
			end
		end
	end
	local half = boxSize / 2
	local boundsCorners: { Vector3 } = {}
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local worldCorner = boxCFrame:PointToWorldSpace(Vector3.new(x * half.X, y * half.Y, z * half.Z))
				table.insert(boundsCorners, marker.CFrame:PointToObjectSpace(worldCorner))
			end
		end
	end
	local roofHeight = math.huge
	for _, descendant in tankModel:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name:match("^RoofSlat") then
			local roofLocal = floor.CFrame:PointToObjectSpace(descendant.Position)
			roofHeight = math.min(roofHeight, roofLocal.Y - descendant.Size.Y / 2)
		end
	end
	if roofHeight == math.huge then
		roofHeight = floor.Size.Y / 2 + math.max(2.5, boxSize.Y + 0.6)
	end
	local random = Random.new(seedFromId(instanceId))
	local initialOrientation = randomOrientation(random)
	visual:PivotTo(marker.CFrame * initialOrientation)
	local driftDuration = random:NextNumber(Config.driftDurationMin, Config.driftDurationMax)
	local self = setmetatable({
		marker = marker,
		floor = floor,
		tankModel = tankModel,
		visual = visual,
		joints = joints,
		random = random,
		state = "Drift",
		elapsed = 0,
		duration = driftDuration,
		cycle = 0,
		motionTime = 0,
		handstandCooldown = random:NextNumber(Config.handstandCooldownMin, Config.handstandCooldownMax),
		bottomCooldown = random:NextNumber(Config.bottomCooldownMin, Config.bottomCooldownMax),
		bottomMovesRemaining = 0,
		offset = Vector3.zero,
		fromOffset = Vector3.zero,
		targetOffset = Vector3.zero,
		controlOffset = Vector3.zero,
		trickOrigin = Vector3.zero,
		orientation = initialOrientation,
		fromOrientation = initialOrientation,
		targetOrientation = initialOrientation,
		trickOrientation = initialOrientation,
		minOffset = Vector3.zero,
		maxOffset = Vector3.zero,
		boxSize = boxSize,
		boundsCorners = boundsCorners,
		footCorners = footCorners,
		feet = feet,
		floatMinOffsetY = 0,
		bottomFloorOffsetY = 0,
		roofHeight = roofHeight,
		farElapsed = 0,
		destroyed = false,
	}, TankCrabAnimatorClient) :: TankCrabAnimatorClient
	self:updateBounds()
	self:chooseDriftTarget()
	return self
end

local function clampOffset(self: TankCrabAnimatorClient, value: Vector3): Vector3
	return Vector3.new(
		math.clamp(value.X, self.minOffset.X, self.maxOffset.X),
		math.clamp(value.Y, self.minOffset.Y, self.maxOffset.Y),
		math.clamp(value.Z, self.minOffset.Z, self.maxOffset.Z)
	)
end

function TankCrabAnimatorClient.updateBounds(self: TankCrabAnimatorClient)
	local home = self.floor.CFrame:PointToObjectSpace(self.marker.Position)
	local minCorner = Vector3.new(math.huge, math.huge, math.huge)
	local maxCorner = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, corner in self.boundsCorners do
		local localCorner = self.floor.CFrame:VectorToObjectSpace(self.marker.CFrame:VectorToWorldSpace(corner))
		minCorner = Vector3.new(
			math.min(minCorner.X, localCorner.X),
			math.min(minCorner.Y, localCorner.Y),
			math.min(minCorner.Z, localCorner.Z)
		)
		maxCorner = Vector3.new(
			math.max(maxCorner.X, localCorner.X),
			math.max(maxCorner.Y, localCorner.Y),
			math.max(maxCorner.Z, localCorner.Z)
		)
	end
	local halfX = self.floor.Size.X / 2 - Config.edgePadding
	local halfZ = self.floor.Size.Z / 2 - Config.edgePadding
	local minX = -halfX - home.X - minCorner.X
	local maxX = halfX - home.X - maxCorner.X
	local minZ = -halfZ - home.Z - minCorner.Z
	local maxZ = halfZ - home.Z - maxCorner.Z
	local minY = self.floor.Size.Y / 2 + 0.03 - home.Y - minCorner.Y
	local maxY = self.roofHeight - Config.verticalPadding - home.Y - maxCorner.Y
	local bottomY = minY
	if #self.footCorners > 0 then
		local lowestFoot = math.huge
		local walkingRotation = CFrame.Angles(math.pi / 2, 0, 0)
		for _, corner in self.footCorners do
			local worldVector = self.marker.CFrame:VectorToWorldSpace(walkingRotation:VectorToWorldSpace(corner))
			local floorVector = self.floor.CFrame:VectorToObjectSpace(worldVector)
			lowestFoot = math.min(lowestFoot, floorVector.Y)
		end
		bottomY = self.floor.Size.Y / 2 + 0.02 - home.Y - lowestFoot
	end
	self.floatMinOffsetY = minY
	self.bottomFloorOffsetY = bottomY
	local lowestOffsetY = math.min(minY, bottomY)
	self.minOffset = Vector3.new(
		if minX <= maxX then minX else 0,
		if lowestOffsetY <= maxY then lowestOffsetY else 0,
		if minZ <= maxZ then minZ else 0
	)
	self.maxOffset = Vector3.new(
		if minX <= maxX then maxX else 0,
		if minY <= maxY then maxY else 0,
		if minZ <= maxZ then maxZ else 0
	)
end

function TankCrabAnimatorClient.chooseDriftTarget(self: TankCrabAnimatorClient)
	self.fromOffset = clampOffset(self, self.offset)
	self.fromOrientation = self.orientation
	self.targetOrientation = randomOrientation(self.random)
	local floatingMinY = math.min(self.maxOffset.Y, self.floatMinOffsetY + Config.verticalPadding)
	self.targetOffset = Vector3.new(
		self.random:NextNumber(self.minOffset.X, self.maxOffset.X),
		self.random:NextNumber(floatingMinY, self.maxOffset.Y),
		self.random:NextNumber(self.minOffset.Z, self.maxOffset.Z)
	)
	local delta = self.targetOffset - self.fromOffset
	local sideways = Vector3.new(-delta.Z, 0, delta.X)
	local bend = if sideways.Magnitude > 0.01
		then sideways.Unit * self.random:NextNumber(-0.22, 0.22) else Vector3.zero
	self.controlOffset = clampOffset(self, (self.fromOffset + self.targetOffset) / 2 + bend)
end

function TankCrabAnimatorClient.chooseBottomTarget(self: TankCrabAnimatorClient)
	self.fromOffset = clampOffset(self, self.offset)
	self.fromOrientation = self.orientation
	self.targetOffset = Vector3.new(
		self.random:NextNumber(self.minOffset.X, self.maxOffset.X),
		self.bottomFloorOffsetY,
		self.random:NextNumber(self.minOffset.Z, self.maxOffset.Z)
	)
	self.targetOrientation = CFrame.Angles(0, self.random:NextNumber(-math.pi, math.pi), 0)
		* CFrame.Angles(math.pi / 2, 0, 0)
	local delta = self.targetOffset - self.fromOffset
	local sideways = Vector3.new(-delta.Z, 0, delta.X)
	local bend = if sideways.Magnitude > 0.01
		then sideways.Unit * self.random:NextNumber(-0.16, 0.16) else Vector3.zero
	self.controlOffset = clampOffset(self, (self.fromOffset + self.targetOffset) / 2 + bend)
end

function TankCrabAnimatorClient.advanceState(self: TankCrabAnimatorClient)
	self.elapsed = 0
	if self.state == "Drift" and self.handstandCooldown <= 0 then
		self.state = "Handstand"
		self.duration = Config.handstandDuration
		self.trickOrigin = self.offset
		self.trickOrientation = self.orientation
		self.handstandCooldown = self.random:NextNumber(Config.handstandCooldownMin, Config.handstandCooldownMax)
	elseif self.state == "Drift" and self.bottomCooldown <= 0 then
		self.state = "Bottom"
		self.duration = self.random:NextNumber(Config.bottomMoveDurationMin, Config.bottomMoveDurationMax)
		self.bottomMovesRemaining = self.random:NextInteger(3, 4)
		self.bottomCooldown = self.random:NextNumber(Config.bottomCooldownMin, Config.bottomCooldownMax)
		self:chooseBottomTarget()
	elseif self.state == "Bottom" and self.bottomMovesRemaining > 1 then
		self.bottomMovesRemaining -= 1
		self.duration = self.random:NextNumber(Config.bottomMoveDurationMin, Config.bottomMoveDurationMax)
		self:chooseBottomTarget()
	else
		self.state = "Drift"
		self.duration = self.random:NextNumber(Config.driftDurationMin, Config.driftDurationMax)
		self.cycle += 1
		self:chooseDriftTarget()
	end
end

local function smoothstep(value: number): number
	return value * value * (3 - 2 * value)
end

function TankCrabAnimatorClient.step(self: TankCrabAnimatorClient, dt: number, cameraPosition: Vector3)
	if self.destroyed or not self.marker.Parent or not self.visual.Parent then
		return
	end
	local distance = (cameraPosition - self.marker.Position).Magnitude
	if distance > Config.farDistance then
		return
	end
	if distance > Config.nearDistance then
		self.farElapsed += dt
		if self.farElapsed < Config.farUpdateInterval then
			return
		end
		dt = self.farElapsed
		self.farElapsed = 0
	else
		self.farElapsed = 0
	end

	local animationDt = math.min(dt, 0.15)
	self.elapsed += animationDt
	self.motionTime += animationDt
	if self.state == "Drift" then
		self.handstandCooldown -= animationDt
		self.bottomCooldown -= animationDt
	end
	self:updateBounds()
	if self.elapsed >= self.duration then
		self:advanceState()
	end

	local progress = math.clamp(self.elapsed / self.duration, 0, 1)
	local bodyBob = 0
	if self.state == "Drift" then
		local blend = smoothstep(progress)
		local first = self.fromOffset:Lerp(self.controlOffset, blend)
		local second = self.controlOffset:Lerp(self.targetOffset, blend)
		self.offset = clampOffset(self, first:Lerp(second, blend))
		self.orientation = self.fromOrientation:Lerp(self.targetOrientation, blend)
		bodyBob = math.sin(self.motionTime * 2.6 + self.cycle) * 0.055
	elseif self.state == "Bottom" then
		local blend = smoothstep(math.clamp(progress / 0.82, 0, 1))
		local first = self.fromOffset:Lerp(self.controlOffset, blend)
		local second = self.controlOffset:Lerp(self.targetOffset, blend)
		self.offset = clampOffset(self, first:Lerp(second, blend))
		self.orientation = self.fromOrientation:Lerp(self.targetOrientation, blend)
		bodyBob = math.sin(self.motionTime * 4) * 0.012
	else
		local capacity = self.tankModel:GetAttribute("TankCapacity")
		local yaw = if capacity == 2 then math.sin(progress * 2 * math.pi) * 0.35
			else 2 * math.pi * smoothstep(progress)
		local enter = smoothstep(math.clamp(progress / 0.2, 0, 1))
		local leave = smoothstep(math.clamp((1 - progress) / 0.2, 0, 1))
		self.orientation = self.trickOrientation:Lerp(CFrame.Angles(0, yaw, 0), math.min(enter, leave))
		local orbit = math.min(
			(self.maxOffset.X - self.minOffset.X) / 2,
			(self.maxOffset.Z - self.minOffset.Z) / 2,
			0.08
		)
		self.offset = clampOffset(self, self.trickOrigin + Vector3.new(
			math.sin(progress * 4 * math.pi) * orbit,
			math.sin(math.pi * progress) * 0.18,
			(math.cos(progress * 4 * math.pi) - 1) * orbit
		))
		bodyBob = math.sin(progress * 8 * math.pi) * 0.025
	end

	local home = self.marker.CFrame
	local rotation = self.orientation
	local base = home * CFrame.new(self.offset.X, self.offset.Y + bodyBob, self.offset.Z) * rotation
	local lowest = math.huge
	local highest = -math.huge
	for _, corner in if self.state == "Bottom" and #self.footCorners > 0 then self.footCorners else self.boundsCorners do
		local floorY = self.floor.CFrame:PointToObjectSpace(base:PointToWorldSpace(corner)).Y
		lowest = math.min(lowest, floorY)
	end
	for _, corner in self.boundsCorners do
		local floorY = self.floor.CFrame:PointToObjectSpace(base:PointToWorldSpace(corner)).Y
		highest = math.max(highest, floorY)
	end
	local floorTop = self.floor.Size.Y / 2
	local padding = if self.state == "Handstand" then 0.16
		elseif self.state == "Bottom" then 0.02 else 0.03
	local lift = if self.state == "Bottom" then floorTop + padding - lowest
		else math.max(0, floorTop + padding - lowest)
	lift -= math.max(0, highest + lift - (self.roofHeight - 0.12))
	self.visual:PivotTo(home * CFrame.new(self.offset.X, self.offset.Y + bodyBob + lift, self.offset.Z) * rotation)

	for _, side in { "L", "R" } do
		local sign = if side == "L" then 1 else -1
		local arm = self.joints["Arm_" .. side]
		local claw = self.joints["Claw_" .. side]
		local armSway = if self.state == "Drift" then math.sin(self.motionTime * 3 + sign) * 0.08
			elseif self.state == "Bottom" then math.sin(self.motionTime * 5 + sign) * 0.07
			else math.sin(self.elapsed * 9 + sign) * 0.16
		if arm then
			arm.Transform = CFrame.Angles(0, sign * armSway, 0)
		end
		if claw then
			claw.Transform = CFrame.Angles(0, sign * math.sin(self.motionTime * 4 + sign) * 0.06, 0)
		end
		for index = 1, 4 do
			local leg = self.joints[string.format("Leg_%s_%02d", side, index)]
			if leg then
				local swing = if self.state == "Drift"
					then math.sin(self.motionTime * 3.5 + index + sign) * 0.07
					elseif self.state == "Bottom"
					then math.sin(self.motionTime * 6 + index + sign) * 0.11
					else math.sin(self.elapsed * 8 + index + sign) * 0.1
				leg.Transform = CFrame.Angles(swing, 0, swing * 0.35)
			end
		end
	end
end

function TankCrabAnimatorClient.correctContainment(self: TankCrabAnimatorClient, cameraPosition: Vector3)
	if self.destroyed or not self.visual.Parent
		or (cameraPosition - self.marker.Position).Magnitude > Config.farDistance then
		return
	end
	local boxCFrame, boxSize = self.visual:GetBoundingBox()
	local half = boxSize / 2
	local lowest = math.huge
	local highest = -math.huge
	local minX = math.huge
	local maxX = -math.huge
	local minZ = math.huge
	local maxZ = -math.huge
	for _, x in { -1, 1 } do
		for _, y in { -1, 1 } do
			for _, z in { -1, 1 } do
				local corner = boxCFrame:PointToWorldSpace(Vector3.new(x * half.X, y * half.Y, z * half.Z))
				local floorY = self.floor.CFrame:PointToObjectSpace(corner).Y
				lowest = math.min(lowest, floorY)
				highest = math.max(highest, floorY)
				local localCorner = self.floor.CFrame:PointToObjectSpace(corner)
				minX = math.min(minX, localCorner.X)
				maxX = math.max(maxX, localCorner.X)
				minZ = math.min(minZ, localCorner.Z)
				maxZ = math.max(maxZ, localCorner.Z)
			end
		end
	end
	if self.state == "Bottom" and #self.feet > 0 then
		lowest = math.huge
		for _, foot in self.feet do
			lowest = math.min(lowest, lowestPartY(foot, self.floor))
		end
	end
	local correctionY = if self.state == "Bottom" then self.floor.Size.Y / 2 + 0.02 - lowest
		else math.max(0, self.floor.Size.Y / 2 + 0.02 - lowest)
	correctionY -= math.max(0, highest + correctionY - (self.roofHeight - 0.02))
	local halfX = self.floor.Size.X / 2 - 0.02
	local halfZ = self.floor.Size.Z / 2 - 0.02
	local fitsX = maxX - minX <= halfX * 2
	local fitsZ = maxZ - minZ <= halfZ * 2
	local correctionX = if not fitsX then 0 elseif minX < -halfX then -halfX - minX
		elseif maxX > halfX then halfX - maxX else 0
	local correctionZ = if not fitsZ then 0 elseif minZ < -halfZ then -halfZ - minZ
		elseif maxZ > halfZ then halfZ - maxZ else 0
	if correctionX ~= 0 or correctionY ~= 0 or correctionZ ~= 0 then
		local delta = self.floor.CFrame:VectorToWorldSpace(Vector3.new(correctionX, correctionY, correctionZ))
		self.visual:PivotTo(CFrame.new(delta) * self.visual:GetPivot())
	end
end

function TankCrabAnimatorClient.destroy(self: TankCrabAnimatorClient)
	if self.destroyed then
		return
	end
	self.destroyed = true
	self.visual:Destroy()
	table.clear(self.joints)
end

return TankCrabAnimatorClient
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="543">
              <Properties>
                <string name="Name">TankDecorationPlacementClient</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Vide = require(ReplicatedStorage.Packages.Vide)
local Placement = require(ReplicatedStorage.Source.Features.Tanks.Modules.TankDecorationPlacement)

local PlacementClient = {}
PlacementClient.__index = PlacementClient

local function button(name: string, label: string, x: number, callback: () -> ()): TextButton
	local control = Vide.create "TextButton" {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(x, 0.79),
		Size = UDim2.fromOffset(135, 52),
		BackgroundColor3 = Color3.fromRGB(143, 75, 15),
		Text = label,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		Font = Enum.Font.BuilderSansExtraBold,
		TextScaled = true,
		Activated = callback,
	}
	Vide.create "UICorner" { CornerRadius = UDim.new(0, 10) }.Parent = control
	Vide.create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = Color3.new(0, 0, 0),
		Thickness = 3,
	}.Parent = control
	return control
end

function PlacementClient.new(tankModel: Model, decorId: string, onPlace: (number, number, number) -> (), onCancel: () -> ())
	local floor = tankModel:FindFirstChild("InsideFloor", true)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local decorations = if assets then assets:FindFirstChild("Decorations") else nil
	local template = if decorations then decorations:FindFirstChild(decorId) else nil
	local camera = Workspace.CurrentCamera
	if not floor or not floor:IsA("BasePart") or not template or not template:IsA("Model") or not camera then
		return nil
	end
	local ghost = template:Clone()
	local size = Placement.prepare(ghost, floor)
	if not size then
		ghost:Destroy()
		return nil
	end
	for _, descendant in ghost:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			-- Glass tank walls hide translucent objects behind them, so keep the preview solid.
			if descendant.Transparency < 1 then
				descendant.Transparency = 0
			end
		end
	end
	ghost.Name = "DecorationPreview"
	ghost.Parent = Workspace

	local previousType = camera.CameraType
	local previousSubject = camera.CameraSubject
	local previousCFrame = camera.CFrame
	local center = floor.Position
	local moneyPad = tankModel:FindFirstChild("GreenInnerCircle", true)
	local slotId = tankModel:GetAttribute("SlotId")
	local fallbackDirection = floor.CFrame.RightVector * (if typeof(slotId) == "string" and string.match(slotId, "^Right") then -1 else 1)
	local padOffset = if moneyPad and moneyPad:IsA("BasePart") then moneyPad.Position - center else fallbackDirection
	local horizontalDirection = Vector3.new(padOffset.X, 0, padOffset.Z)
	if horizontalDirection.Magnitude < 0.1 then
		horizontalDirection = fallbackDirection
	end
	local cameraDistance = math.max(7.2, floor.Size.X * 1.8)
	local height = floor.Size.X * 0.95 + 0.7
	local target = center + Vector3.new(0, floor.Size.X * 0.2, 0)
	local placementCameraCFrame = CFrame.lookAt(center + horizontalDirection.Unit * cameraDistance + Vector3.new(0, height, 0), target)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = placementCameraCFrame
	local cameraBinding = "TankDecorationPlacementCamera"
	RunService:BindToRenderStep(cameraBinding, Enum.RenderPriority.Camera.Value + 1, function()
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = placementCameraCFrame
	end)

	local self = setmetatable({
		floor = floor, ghost = ghost, size = size, camera = camera,
		previousType = previousType, previousSubject = previousSubject, previousCFrame = previousCFrame,
		cameraBinding = cameraBinding,
		x = 0, z = 0, rotation = 0, valid = false, destroyed = false,
		connections = {} :: { RBXScriptConnection },
		gui = nil :: ScreenGui?,
		touchPosition = nil :: Vector2?,
	}, PlacementClient)

	local function confirm()
		if self.valid then
			onPlace(self.x, self.z, self.rotation)
		else
			self:setStatus("THAT SPOT IS BLOCKED")
			task.delay(1.5, function()
				if not self.destroyed and self.heading.Text == "THAT SPOT IS BLOCKED" then
					self:setStatus("MOVE DECORATION INSIDE THE TANK")
				end
			end)
		end
	end
	local function rotate()
		self.rotation = (self.rotation + 1) % 4
	end
	local gui = Vide.create "ScreenGui" {
		Name = "TankDecorationPlacement",
		ResetOnSpawn = false,
		DisplayOrder = 40,
		IgnoreGuiInset = true,
	}
	local heading = Vide.create "TextLabel" {
		Name = "Instructions",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.13),
		Size = UDim2.fromOffset(460, 50),
		BackgroundColor3 = Color3.fromRGB(76, 39, 11),
		BackgroundTransparency = 0.15,
		Text = "MOVE DECORATION INSIDE THE TANK",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		Font = Enum.Font.BuilderSansExtraBold,
		TextScaled = true,
	}
	heading.Parent = gui
	Vide.create "UICorner" { CornerRadius = UDim.new(0, 10) }.Parent = heading
	local placeButton = button("PlaceButton", "PLACE", 0.35, confirm)
	placeButton.Parent = gui
	button("RotateButton", "ROTATE (R)", 0.5, rotate).Parent = gui
	button("CancelButton", "CANCEL", 0.65, onCancel).Parent = gui
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	self.gui = gui
	self.heading = heading

	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			rotate()
		elseif input.KeyCode == Enum.KeyCode.Escape then
			onCancel()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			confirm()
		end
	end))
	table.insert(self.connections, UserInputService.TouchStarted:Connect(function(input, processed)
		if not processed then
			self.touchPosition = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	table.insert(self.connections, UserInputService.TouchMoved:Connect(function(input, processed)
		if not processed then
			self.touchPosition = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	table.insert(self.connections, RunService.RenderStepped:Connect(function()
		if not floor.Parent then
			onCancel()
			return
		end
		local mouse = self.touchPosition or UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		local normal = floor.CFrame.UpVector
		local denominator = ray.Direction:Dot(normal)
		if math.abs(denominator) > 0.001 then
			local distance = (floor.Position - ray.Origin):Dot(normal) / denominator
			if distance > 0 then
				local localPoint = floor.CFrame:PointToObjectSpace(ray.Origin + ray.Direction * distance)
				if math.abs(localPoint.X) <= floor.Size.X / 2 and math.abs(localPoint.Z) <= floor.Size.Z / 2 then
					self.x = math.round(localPoint.X * 100) / 100
					self.z = math.round(localPoint.Z * 100) / 100
				end
			end
		end
		self.x, self.z = Placement.clampToFloor(floor, size, self.x, self.z, self.rotation)
		self.valid = Placement.fits(floor, size, self.x, self.z, self.rotation)
		local width, depth = Placement.footprint(size, self.rotation)
		local folder = tankModel:FindFirstChild("ContainedDecorations")
		if folder then
			for _, placed in folder:GetChildren() do
				if placed:IsA("Model") then
					local otherX = placed:GetAttribute("DecorX")
					local otherZ = placed:GetAttribute("DecorZ")
					local otherWidth = placed:GetAttribute("DecorWidth")
					local otherDepth = placed:GetAttribute("DecorDepth")
					if typeof(otherX) == "number" and typeof(otherZ) == "number"
						and typeof(otherWidth) == "number" and typeof(otherDepth) == "number"
						and Placement.overlaps(self.x, self.z, width, depth, otherX, otherZ, otherWidth, otherDepth) then
						self.valid = false
					end
				end
			end
		end
		ghost:PivotTo(Placement.pivotOnFloor(ghost, floor, self.x, self.z, self.rotation))
		placeButton.BackgroundColor3 = if self.valid then Color3.fromRGB(143, 75, 15) else Color3.fromRGB(94, 88, 77)
	end))
	return self
end

function PlacementClient.setStatus(self, message: string)
	if not self.destroyed then
		self.heading.Text = message
	end
end

function PlacementClient.destroy(self)
	if self.destroyed then
		return
	end
	self.destroyed = true
	for _, connection in self.connections do
		connection:Disconnect()
	end
	self.ghost:Destroy()
	RunService:UnbindFromRenderStep(self.cameraBinding)
	if self.gui then
		self.gui:Destroy()
	end
	if Workspace.CurrentCamera == self.camera then
		self.camera.CameraSubject = self.previousSubject
		self.camera.CameraType = self.previousType
		if self.previousType == Enum.CameraType.Scriptable then
			self.camera.CFrame = self.previousCFrame
		end
	end
end

return PlacementClient
]]></string>
              </Properties>
            </Item>
          </Item>
