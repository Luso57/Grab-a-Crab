              <string name="Name">Modules</string>
            </Properties>
            <Item class="ModuleScript" referent="545">
              <Properties>
                <string name="Name">TankAnimationConfig</string>
                <string name="Source"><![CDATA[--!strict

return {
	nearDistance = 70,
	farDistance = 120,
	farUpdateInterval = 1 / 15,
	driftDurationMin = 2.8,
	driftDurationMax = 4.8,
	bottomMoveDurationMin = 3,
	bottomMoveDurationMax = 4,
	bottomCooldownMin = 10,
	bottomCooldownMax = 18,
	handstandDuration = 2.9,
	handstandCooldownMin = 16,
	handstandCooldownMax = 28,
	edgePadding = 0.16,
	verticalPadding = 0.2,
}
