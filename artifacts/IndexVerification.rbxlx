            <Item class="ModuleScript" referent="474">
              <Properties>
                <string name="Name">CrabRigBuilder</string>
                <string name="Source"><![CDATA[--!strict

-- Rig the existing separate MeshParts without changing their resting positions.
local CrabRigBuilder = {}

local RIG_VERSION = 1

local function findBody(model: Model): BasePart?
	if model.Name == "SkeletonCrab" then
		local cage = model:FindFirstChild("SK_BoneCage", true)
		return if cage and cage:IsA("BasePart") then cage else nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart")
			and (descendant.Name == "Body" or descendant.Name:match("^[^_]+_Body$")) then
			return descendant
		end
	end
	return nil
end

local function getPart(model: Model, name: string): BasePart?
	local part = model:FindFirstChild(name, true)
	return if part and part:IsA("BasePart") then part else nil
end

local function addMotor(part0: BasePart, part1: BasePart, role: string, towardChild: number)
	local pivot = CFrame.new(part0.Position:Lerp(part1.Position, towardChild))
	local motor = Instance.new("Motor6D")
	motor.Name = "CrabRig_" .. role
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = part0.CFrame:ToObjectSpace(pivot)
	motor.C1 = part1.CFrame:ToObjectSpace(pivot)
	motor.Parent = part0
end

function CrabRigBuilder.rig(model: Model): BasePart?
	local body = findBody(model)
	if not body then
		warn("Crab rig has no body:", model.Name)
		return nil
	end
	if model:GetAttribute("CrabRigVersion") == RIG_VERSION then
		return body
	end

	local prefix = if model.Name == "SkeletonCrab" then "SK_" else body.Name:gsub("Body$", "")
	local core: { [BasePart]: boolean } = { [body] = true }
	local parts: { [string]: BasePart } = {}
	for _, role in { "Arm_L", "Arm_R", "Claw_L", "Claw_R",
		"Leg_L_01", "Leg_L_02", "Leg_L_03", "Leg_L_04",
		"Leg_R_01", "Leg_R_02", "Leg_R_03", "Leg_R_04" } do
		local part = getPart(model, prefix .. role)
		if not part then
			warn("Crab rig missing " .. role .. ":", model.Name)
			return nil
		end
		parts[role] = part
		core[part] = true
	end

	for _, descendant in model:GetDescendants() do
		if (descendant:IsA("Motor6D") or descendant:IsA("WeldConstraint")) and descendant.Name:match("^CrabRig_") then
			descendant:Destroy()
		end
	end

	model.PrimaryPart = body
	for _, side in { "L", "R" } do
		local arm = parts["Arm_" .. side]
		addMotor(body, arm, "Arm_" .. side, 0.45)
		addMotor(arm, parts["Claw_" .. side], "Claw_" .. side, 0.5)
		for index = 1, 4 do
			local role = string.format("Leg_%s_%02d", side, index)
			addMotor(body, parts[role], role, 0.35)
		end
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and not core[descendant] then
			local target = body
			if descendant.Name:match("Claw_R$") then
				target = parts.Claw_R
			elseif descendant.Name:match("Claw_L$")
				or descendant.Name:find("Palette", 1, true)
				or descendant.Name:find("Paint_", 1, true)
				or descendant.Name:find("Shovel", 1, true) then
				target = parts.Claw_L
			end
			local weld = Instance.new("WeldConstraint")
			weld.Name = "CrabRig_Detail"
			weld.Part0 = target
			weld.Part1 = descendant
			weld.Parent = target
		end
	end

	model:SetAttribute("CrabRigVersion", RIG_VERSION)
	return body
end

return CrabRigBuilder
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="475">
              <Properties>
                <string name="Name">CrabWeights</string>
                <string name="Source"><![CDATA[--!strict

local CrabWeights = {}

local random = Random.new()

-- Chances are out of 10,000; bounds are hundredths of a gram.
local tiers = {
    { chance = 100, minimum = 1, maximum = 99 },
    { chance = 5000, minimum = 100, maximum = 199 },
    { chance = 2500, minimum = 200, maximum = 299 },
    { chance = 1200, minimum = 300, maximum = 499 },
    { chance = 700, minimum = 500, maximum = 999 },
    { chance = 350, minimum = 1000, maximum = 9999 },
    { chance = 100, minimum = 10000, maximum = 99999 },
    { chance = 45, minimum = 100000, maximum = 999999 },
    { chance = 5, minimum = 1000000, maximum = 100000000 },
}

function CrabWeights.roll(): number
    local chance = random:NextInteger(1, 10000)
    for _, tier in tiers do
        chance -= tier.chance
        if chance <= 0 then
            return random:NextInteger(tier.minimum, tier.maximum) / 100
        end
    end
    return 1
end

function CrabWeights.normalize(weightGrams: any): number
    if typeof(weightGrams) ~= "number" or weightGrams ~= weightGrams
        or weightGrams < 0.01 or weightGrams > 1000000 then
        return 1
    end
    return math.round(weightGrams * 100) / 100
end

function CrabWeights.scale(weightGrams: number?): number
    local weight = CrabWeights.normalize(weightGrams)
    if weight <= 100 then
        return 1.15 * weight ^ 0.35
    end
    return 1.15 * 100 ^ 0.35 * (weight / 100) ^ 0.18
end

function CrabWeights.income(baseIncomePerSecond: number, weightGrams: number?): number
    return baseIncomePerSecond * CrabWeights.normalize(weightGrams)
end

function CrabWeights.format(weightGrams: number?): string
    local weight = CrabWeights.normalize(weightGrams)
    if weight % 1 == 0 then
        return string.format("%dg", weight)
    end
    return string.format("%.2fg", weight)
end

return CrabWeights
]]></string>
