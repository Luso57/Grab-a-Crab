            </Item>
            <Item class="ModuleScript" referent="546">
              <Properties>
                <string name="Name">TankDecorationPlacement</string>
                <string name="Source"><![CDATA[--!strict

local TankDecorationPlacement = {}

TankDecorationPlacement.slotCount = 4

local EDGE_PADDING = 0.14
local DECOR_GAP = 0.1
local PREVIEW_EDGE_INSET = 0.04

function TankDecorationPlacement.isRotation(value: any): boolean
	return typeof(value) == "number" and value % 1 == 0 and value >= 0 and value <= 3
end

function TankDecorationPlacement.isFinite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) < 10000
end

function TankDecorationPlacement.prepare(model: Model, floor: BasePart): Vector3?
	local _, size = model:GetBoundingBox()
	if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
		return nil
	end
	local maxWidth = math.min(1.6, math.min(floor.Size.X, floor.Size.Z) * 0.34)
	local factor = math.min(maxWidth / math.max(size.X, size.Z), 2 / size.Y)
	model:ScaleTo(model:GetScale() * factor)
	local _, scaledSize = model:GetBoundingBox()
	return scaledSize
end

function TankDecorationPlacement.footprint(size: Vector3, rotation: number): (number, number)
	if rotation % 2 == 0 then
		return size.X, size.Z
	end
	return size.Z, size.X
end

function TankDecorationPlacement.fits(floor: BasePart, size: Vector3, x: number, z: number, rotation: number): boolean
	if not TankDecorationPlacement.isFinite(x) or not TankDecorationPlacement.isFinite(z)
		or not TankDecorationPlacement.isRotation(rotation) then
		return false
	end
	local width, depth = TankDecorationPlacement.footprint(size, rotation)
	return math.abs(x) + width / 2 <= floor.Size.X / 2 - EDGE_PADDING
		and math.abs(z) + depth / 2 <= floor.Size.Z / 2 - EDGE_PADDING
end

function TankDecorationPlacement.clampToFloor(floor: BasePart, size: Vector3, x: number, z: number, rotation: number): (number, number)
	local width, depth = TankDecorationPlacement.footprint(size, rotation)
	local maxX = math.max(0, floor.Size.X / 2 - EDGE_PADDING - PREVIEW_EDGE_INSET - width / 2)
	local maxZ = math.max(0, floor.Size.Z / 2 - EDGE_PADDING - PREVIEW_EDGE_INSET - depth / 2)
	return math.clamp(x, -maxX, maxX), math.clamp(z, -maxZ, maxZ)
end

function TankDecorationPlacement.overlaps(
	x: number, z: number, width: number, depth: number,
	otherX: number, otherZ: number, otherWidth: number, otherDepth: number
): boolean
	return math.abs(x - otherX) < (width + otherWidth) / 2 + DECOR_GAP
		and math.abs(z - otherZ) < (depth + otherDepth) / 2 + DECOR_GAP
end

function TankDecorationPlacement.pivotOnFloor(model: Model, floor: BasePart, x: number, z: number, rotation: number): CFrame
	local box, size = model:GetBoundingBox()
	local pivotToBottom = model:GetPivot().Position.Y - (box.Position.Y - size.Y / 2)
	return floor.CFrame * CFrame.new(x, floor.Size.Y / 2 + pivotToBottom, z)
		* CFrame.Angles(0, rotation * math.pi / 2, 0)
end

return TankDecorationPlacement
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="547">
              <Properties>
                <string name="Name">Tanks</string>
                <string name="Source">--!strict

export type TankDefinition = {
	name: string,
	modelName: string,
	capacity: number,
}

-- These IDs match the shop entries. Model templates live in ReplicatedStorage.Assets.Tanks.
local definitions: { [string]: TankDefinition } = {
	Small = { name = "Small Tank", modelName = "SmallTank", capacity = 2 },
	Medium = { name = "Medium Tank", modelName = "MediumTank", capacity = 3 },
	Large = { name = "Large Tank", modelName = "LargeTank", capacity = 4 },
}

local Tanks = {}

function Tanks.get(tankId: string): TankDefinition?
	return definitions[tankId]
end

return Tanks</string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="548">
            <Properties>
              <string name="Name">TankServiceClient</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Networker = require(ReplicatedStorage.Packages.Networker)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local Data = require(ReplicatedStorage.Source.Game.Data).client
local DecorConfig = require(ReplicatedStorage.Source.Features.DecorShop.DecorConfig)
local TankClient = require(script.Parent.Classes.TankClient)
local TankPopupRoot = require(script.Parent.UI.TankPopupRoot)
local TankPickupEffect = require(script.Parent.UI.TankPickupEffect)
local TankEmptyWarning = require(script.Parent.UI.TankEmptyWarning)
local TankDecorationPlacementClient = require(script.Parent.Classes.TankDecorationPlacementClient)
local InventoryConfig = require(ReplicatedStorage.Source.Features.Inventory.InventoryConfig)
local MoneyServiceClient = require(ReplicatedStorage.Source.Features.Money.MoneyServiceClient)

local TankServiceClient = {}
local initialized = false
local tanks: { [Model]: TankClient.TankClient } = {}
local pendingTanks: { [Model]: { RBXScriptConnection } } = {}
local selectedTank: TankClient.TankClient? = nil
local popupOpen = Vide.source(false)
local popupCards = Vide.source({} :: { TankPopupRoot.Card })
local popupBoostPercent = Vide.source(0)
local decorCounts = Vide.source({} :: { [string]: number })
local selectedDecorSlot = Vide.source(nil :: number?)
local decorSlots = Vide.source({} :: { [number]: { instanceId: string, decorId: string } })
local activePlacement = nil
local placementItemId: string? = nil
local cardSignature = ""
local pendingPickups: { [string]: { imageId: number, position: Vector2 } } = {}
local playPickup: ((number, Vector2, number?) -> ())? = nil
local showEmptyWarning: (() -> ())? = nil

local function queuePickupAnimation(instanceId: string, imageId: number, position: Vector2)
	local origin = { imageId = imageId, position = position }
	pendingPickups[instanceId] = origin
	task.delay(5, function()
		if pendingPickups[instanceId] == origin then
			pendingPickups[instanceId] = nil
		end
	end)
end

local function closePopup()
	if activePlacement then
		activePlacement:destroy()
		activePlacement = nil
		placementItemId = nil
	end
	selectedTank = nil
	cardSignature = ""
	popupCards({})
	popupBoostPercent(0)
	selectedDecorSlot(nil)
	popupOpen(false)
end

local function refreshDecorations()
	local counts: { [string]: number } = {}
	local slots: { [number]: { instanceId: string, decorId: string } } = {}
	for instanceId, item in Data.inventory() do
		if typeof(item) == "table" and typeof(item.itemId) == "string"
			and item.placedSlotId == nil and item.incubatorInstanceId == nil then
			local decorId = string.match(item.itemId, "^Decor%.([%w_]+)$")
			if decorId and DecorConfig.get(decorId) then
				if item.tankInstanceId == nil then
					counts[decorId] = (counts[decorId] or 0) + 1
				elseif selectedTank and item.tankInstanceId == selectedTank.instanceId
					and typeof(item.decorSlot) == "number" then
					slots[item.decorSlot] = { instanceId = instanceId, decorId = decorId }
				end
			end
		end
	end
	decorCounts(counts)
	decorSlots(slots)
end

local function isLocalOwner(model: Model): boolean
	local placedFolder = model.Parent
	local plotModel = if placedFolder then placedFolder.Parent else nil
	return placedFolder ~= nil and placedFolder.Name == "PlacedItems"
		and plotModel ~= nil and plotModel:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId
end

local function refreshPopup()
	local tank = selectedTank
	if not tank then
		return
	end
	if tanks[tank.model] ~= tank or not isLocalOwner(tank.model) then
		closePopup()
		return
	end

	local nextCards: { TankPopupRoot.Card } = {}
	local signatureParts: { string } = {}
	local rawBoost = tank.model:GetAttribute("TankIncomeBoostPercent")
	local boostPercent = if typeof(rawBoost) == "number" then rawBoost else 0
	popupBoostPercent(boostPercent)
	local folder = tank.model:FindFirstChild("ContainedCrabs")
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") and child.Name == "ContainedCrabAnchor" then
				local crabId = child:GetAttribute("CrabId")
				local definition = if typeof(crabId) == "string" then Crabs.get(crabId) else nil
				if definition then
					local instanceId = child:GetAttribute("ItemInstanceId")
					local key = if typeof(instanceId) == "string" then instanceId else child.Name
					table.insert(nextCards, {
						instanceId = key,
						name = definition.name,
						imageId = definition.imageId,
						weight = string.upper(CrabWeights.format(child:GetAttribute("WeightGrams"))),
						income = CompactNumber.formatIncomeRate(CrabWeights.income(definition.incomePerSecond, child:GetAttribute("WeightGrams")) * (1 + boostPercent / 100)) .. "/s",
						sellPrice = CompactNumber.format(Crabs.sellValue(crabId) or 0),
					})
					table.insert(signatureParts, key .. ":" .. crabId .. ":" .. tostring(child:GetAttribute("WeightGrams")))
				end
			end
		end
	end
	table.sort(nextCards, function(a, b)
		return a.instanceId < b.instanceId
	end)
	table.sort(signatureParts)
	local nextSignature = tostring(boostPercent) .. "|" .. table.concat(signatureParts, "|")
	if nextSignature ~= cardSignature then
		cardSignature = nextSignature
		popupCards(nextCards)
	end
end

local function hasHammerEquipped(): boolean
	local character = Players.LocalPlayer.Character
	if not character then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("ItemId") == InventoryConfig.hammerItemId then
			return true
		end
	end
	return false
end
local function openTank(model: Model)
	local tank = tanks[model]
	if not tank or not isLocalOwner(model) then
		return
	end
	if hasHammerEquipped() then
		closePopup()
		local show = showEmptyWarning
		if show then
			show()
		end
		return
	end
	selectedTank = tank
	refreshDecorations()
	selectedDecorSlot(nil)
	cardSignature = "#"
	refreshPopup()
	popupOpen(true)
end

local function hasCrabEquipped(): boolean
	local character = Players.LocalPlayer.Character
	if not character then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			local itemId = child:GetAttribute("ItemId")
			local instanceId = child:GetAttribute("ItemInstanceId")
			local crabId = if typeof(itemId) == "string" then string.match(itemId, "^Crab%.([%w_]+)$") else nil
			if typeof(instanceId) == "string" and crabId and Crabs.get(crabId) then
				return true
			end
		end
	end
	return false
end

local function clearPendingTank(model: Model)
	local connections = pendingTanks[model]
	if not connections then
		return
	end
	pendingTanks[model] = nil
	for _, connection in connections do
		connection:Disconnect()
	end
end

local function tryAttachTank(model: Model)
	if tanks[model] or not model.Parent or model.Parent.Name ~= "PlacedItems" then
		return
	end
	local itemId = model:GetAttribute("ItemId")
	if typeof(itemId) == "string" and not string.match(itemId, "^Tank%.[%w_]+$") then
		clearPendingTank(model)
		return
	end
	local instanceId = model:GetAttribute("ItemInstanceId")
	if typeof(itemId) ~= "string" or typeof(instanceId) ~= "string" then
		return
	end
	clearPendingTank(model)
	tanks[model] = TankClient.new(instanceId, model, openTank, function()
		if isLocalOwner(model) then
			MoneyServiceClient:playCollection()
		end
	end)
end

local function addTank(instance: Instance)
	if not instance:IsA("Model") or tanks[instance] or pendingTanks[instance]
		or not instance.Parent or instance.Parent.Name ~= "PlacedItems" then
		return
	end
	pendingTanks[instance] = {
		instance:GetAttributeChangedSignal("ItemId"):Connect(function()
			tryAttachTank(instance)
		end),
		instance:GetAttributeChangedSignal("ItemInstanceId"):Connect(function()
			tryAttachTank(instance)
		end),
	}
	tryAttachTank(instance)
end

local function removeTank(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	clearPendingTank(instance)
	local tank = tanks[instance]
	if tank then
		if selectedTank == tank then
			closePopup()
		end
		tanks[instance] = nil
		tank:destroy()
	end
end

function TankServiceClient:init()
	if initialized then
		return
	end
	initialized = true
	local networker = Networker.client.new("TankService", TankServiceClient)
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	Players.LocalPlayer.CharacterAdded:Connect(closePopup)
	playPickup = TankPickupEffect.mount(playerGui)
	showEmptyWarning = TankEmptyWarning.mount(playerGui)
	Data.inventory.Changed(refreshDecorations)
	refreshDecorations()
	Vide.mount(function()
		return TankPopupRoot({
			cards = popupCards,
			boostPercent = popupBoostPercent,
			decorCounts = decorCounts,
			decorSlots = decorSlots,
			selectedDecorSlot = selectedDecorSlot,
			isOpen = popupOpen,
			onClose = closePopup,
			onDecorSlotSelected = function(slotIndex: number)
				local tank = selectedTank
				if not tank or not isLocalOwner(tank.model) then
					return
				end
				selectedDecorSlot(if selectedDecorSlot() == slotIndex then nil else slotIndex)
			end,
			onCloseDecorations = function()
				selectedDecorSlot(nil)
			end,
			onChooseDecoration = function(decorId: string)
				local tank = selectedTank
				local slot = selectedDecorSlot()
				if not tank or not slot or decorSlots()[slot] or not isLocalOwner(tank.model) then
					return
				end
				local itemId: string? = nil
				for instanceId, item in Data.inventory() do
					if item.itemId == "Decor." .. decorId and item.tankInstanceId == nil
						and item.placedSlotId == nil and item.incubatorInstanceId == nil then
						itemId = instanceId
						break
					end
				end
				if not itemId then
					return
				end
				popupOpen(false)
				selectedDecorSlot(nil)
				local function cancel()
					if activePlacement then
						activePlacement:destroy()
						activePlacement = nil
					end
					placementItemId = nil
					if selectedTank == tank and tanks[tank.model] == tank then
						popupOpen(true)
					end
				end
				activePlacement = TankDecorationPlacementClient.new(tank.model, decorId, function(x: number, z: number, rotation: number)
					if placementItemId ~= itemId then
						return
					end
					if activePlacement then
						activePlacement:setStatus("PLACING...")
					end
					networker:fire("placeDecoration", tank.instanceId, itemId, slot, x, z, rotation)
				end, cancel)
				placementItemId = if activePlacement then itemId else nil
				if not activePlacement then
					popupOpen(true)
				end
			end,
			onPickupDecoration = function(itemInstanceId: string, startPosition: Vector2)
				local tank = selectedTank
				if not tank or not isLocalOwner(tank.model) then
					return
				end
				for _, placed in decorSlots() do
					if placed.instanceId == itemInstanceId then
						local definition = DecorConfig.get(placed.decorId)
						if definition then
							queuePickupAnimation(itemInstanceId, definition.imageId, startPosition)
							networker:fire("pickupDecoration", tank.instanceId, itemInstanceId)
						end
						return
					end
				end
			end,
			onSell = function(crabInstanceId: string)
				local tank = selectedTank
				if not tank or not isLocalOwner(tank.model) then
					return
				end
				for _, card in popupCards() do
					if card.instanceId == crabInstanceId then
						networker:fire("sellCrab", tank.instanceId, crabInstanceId)
						return
					end
				end
			end,
			onPickUp = function(crabInstanceId: string, startPosition: Vector2)
				local tank = selectedTank
				if not tank or not isLocalOwner(tank.model) then
					return
				end
				for _, card in popupCards() do
					if card.instanceId == crabInstanceId then
						queuePickupAnimation(crabInstanceId, card.imageId, startPosition)
						networker:fire("pickupCrab", tank.instanceId, crabInstanceId)
						return
					end
				end
			end,
		})
	end, playerGui)

	local spawnedPlots = Workspace:WaitForChild("SpawnedPlots")
	spawnedPlots.DescendantAdded:Connect(addTank)
	spawnedPlots.DescendantRemoving:Connect(removeTank)
	for _, instance in spawnedPlots:GetDescendants() do
		addTank(instance)
	end

	RunService.PreSimulation:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		for model, tank in tanks do
			if model:IsDescendantOf(spawnedPlots) then
				tank:step(dt, cameraPosition)
			end
		end
	end)
	RunService.PostSimulation:Connect(function()
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		for model, tank in tanks do
			if model:IsDescendantOf(spawnedPlots) then
				tank:correctContainment(cameraPosition)
			end
		end
	end)

	task.spawn(function()
		while spawnedPlots.Parent do
			local equipped = hasCrabEquipped()
			for model, tank in tanks do
				if model:IsDescendantOf(spawnedPlots) then
					tank:update(equipped, activePlacement ~= nil)
				else
					removeTank(model)
				end
			end
			refreshPopup()
			task.wait(0.1)
		end
	end)
end

function TankServiceClient:decorationPlaced(tankInstanceId: any, itemInstanceId: any)
	if typeof(itemInstanceId) ~= "string" or itemInstanceId ~= placementItemId then
		return
	end
	if not selectedTank or selectedTank.instanceId ~= tankInstanceId then
		return
	end
	if activePlacement then
		activePlacement:destroy()
		activePlacement = nil
	end
	placementItemId = nil
	refreshDecorations()
	popupOpen(true)
end

function TankServiceClient:decorationPlacementRejected(tankInstanceId: any, itemInstanceId: any)
	if typeof(itemInstanceId) ~= "string" or itemInstanceId ~= placementItemId
		or not selectedTank or selectedTank.instanceId ~= tankInstanceId then
		return
	end
	if activePlacement then
		local placement = activePlacement
		placement:setStatus("CAN'T PLACE HERE - TRY ANOTHER SPOT")
		task.delay(2, function()
			if activePlacement == placement then
				placement:setStatus("MOVE DECORATION INSIDE THE TANK")
			end
		end)
	end
end

function TankServiceClient:showPickedUpItem(instanceId: any, slotIndex: any)
	if typeof(instanceId) ~= "string" then
		return
	end
	local origin = pendingPickups[instanceId]
	pendingPickups[instanceId] = nil
	local play = playPickup
	if origin and play then
		play(origin.imageId, origin.position, if typeof(slotIndex) == "number" and slotIndex > 0 then slotIndex else nil)
	end
end

function TankServiceClient:showSaleCoins()
	MoneyServiceClient:playCollection()
end

function TankServiceClient:getTank(instanceId: string): TankClient.TankClient?
	for _, tank in tanks do
		if tank.instanceId == instanceId then
			return tank
		end
	end
	return nil
end

return TankServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="549">
            <Properties>
              <string name="Name">TankTypes</string>
              <string name="Source"><![CDATA[--!strict

export type TankId = string

export type OwnedTank = {
	instanceId: string,
	tankId: TankId,
	-- Twelve CFrame components relative to the owner's plot when placed.
	placement: { number }?,
}

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="550">
            <Properties>
              <string name="Name">UI</string>
            </Properties>
            <Item class="ModuleScript" referent="551">
              <Properties>
                <string name="Name">MoneyPadDisplay</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Vide = require(ReplicatedStorage.Packages.Vide)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local create = Vide.create

local MoneyPadDisplay = {}

function MoneyPadDisplay.attach(model: Model): () -> ()
	local accrued = Vide.source(0)
	local anchor: Attachment? = nil
	local connections: { RBXScriptConnection } = {}
	local gui: ScreenGui? = nil
	local amountRow: Frame? = nil
	local amountScale: UIScale? = nil
	local rate = 0
	local baseAmount = 0
	local updatedAt = 0
	local alive = true
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true
	local nextVisibilityCheck = 0
	local hasLineOfSight = false

	local function refreshIncome()
		local value = model:GetAttribute("IncomePerSecond")
		local base = model:GetAttribute("MoneyPadBaseAmount")
		local timestamp = model:GetAttribute("MoneyPadUpdatedAt")
		rate = if typeof(value) == "number" then value else 0
		baseAmount = if typeof(base) == "number" then base else 0
		updatedAt = if typeof(timestamp) == "number" then timestamp else Workspace:GetServerTimeNow()
	end

	local function refreshPad()
		local pad = model:FindFirstChild("MoneyPad")
		local green = if pad then pad:FindFirstChild("GreenInnerCircle") else nil
		if anchor and green ~= nil and anchor.Parent == green then
			return
		end
		if anchor then
			anchor:Destroy()
			anchor = nil
		end
		nextVisibilityCheck = 0
		hasLineOfSight = false
		if green and green:IsA("BasePart") then
			local displayAnchor = Instance.new("Attachment")
			displayAnchor.Name = "MoneyPadDisplayAnchor"
			displayAnchor.Position = Vector3.zero
			displayAnchor.Parent = green
			anchor = displayAnchor
		end
	end

	local unmount = Vide.mount(function()
		local screen = create "ScreenGui" {
			Name = "MoneyPadDisplay",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 10,
		}
		local row = create "Frame" {
			Name = "AmountRow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromOffset(175, 38),
			BackgroundTransparency = 1,
			Visible = false,
		}
		row.Parent = screen
		local scale = create "UIScale" { Scale = 1 }
		scale.Parent = row
		amountScale = scale
		create "UIListLayout" {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 3),
		}.Parent = row
		create "ImageLabel" {
			Name = "CoinIcon",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(30, 30),
			Image = "rbxassetid://" .. assets.SandDollar,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 1,
		}.Parent = row
		create "TextLabel" {
			Name = "AccumulatedAmount",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(0, 38),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			Text = function()
				return CompactNumber.format(accrued())
			end,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeColor3 = Color3.new(0, 0, 0),
			TextStrokeTransparency = 0,
			TextSize = 27,
			TextScaled = false,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.BuilderSansExtraBold,
		}.Parent = row
		gui = screen
		amountRow = row
		return screen
	end, Players.LocalPlayer:WaitForChild("PlayerGui"))

	local function updateDisplay()
		local elapsed = math.max(0, Workspace:GetServerTimeNow() - updatedAt)
		local displayed = baseAmount + rate * math.floor(elapsed)
		if displayed ~= accrued() then
			accrued(displayed)
		end

		local row = amountRow
		local scale = amountScale
		local target = anchor
		local camera = Workspace.CurrentCamera
		local green = if target then target.Parent else nil
		local pad = if green then green.Parent else nil
		local blue = if pad then pad:FindFirstChild("BlueOuterCircle") else nil
		if not row or not scale or not target or not camera or not pad or not blue or not blue:IsA("BasePart") then
			if row then
				row.Visible = false
			end
			return
		end
		local worldPosition = target.WorldPosition
		local screenPosition, onScreen = camera:WorldToViewportPoint(worldPosition)
		local cameraPosition = camera.CFrame.Position
		if not onScreen or screenPosition.Z <= 0 or (cameraPosition - worldPosition).Magnitude > 50 then
			row.Visible = false
			nextVisibilityCheck = 0
			return
		end
		local now = os.clock()
		if now >= nextVisibilityCheck then
			local character = Players.LocalPlayer.Character
			raycastParams.FilterDescendantsInstances = if character then { character } else {}
			local hit = Workspace:Raycast(cameraPosition, worldPosition - cameraPosition, raycastParams)
			hasLineOfSight = hit == nil or hit.Instance:IsDescendantOf(pad)
			nextVisibilityCheck = now + 0.1
		end
		row.Visible = hasLineOfSight
		if row.Visible then
			local focalLength = camera.ViewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView) / 2))
			local padDiameter = focalLength * blue.Size.Y / screenPosition.Z
			scale.Scale = padDiameter / 100
			row.Position = UDim2.fromOffset(screenPosition.X, screenPosition.Y - padDiameter * 0.45)
		end
	end

	table.insert(connections, model:GetAttributeChangedSignal("IncomePerSecond"):Connect(refreshIncome))
	table.insert(connections, model:GetAttributeChangedSignal("MoneyPadBaseAmount"):Connect(refreshIncome))
	table.insert(connections, model:GetAttributeChangedSignal("MoneyPadUpdatedAt"):Connect(refreshIncome))
	table.insert(connections, model.DescendantAdded:Connect(function(child)
		if child.Name == "MoneyPad" or child.Name == "GreenInnerCircle" then
			refreshPad()
		end
	end))
	table.insert(connections, model.DescendantRemoving:Connect(function(child)
		if child.Name == "MoneyPad" or child.Name == "GreenInnerCircle" then
			task.defer(function()
				if alive then
					refreshPad()
				end
			end)
		end
	end))
	table.insert(connections, RunService.RenderStepped:Connect(updateDisplay))
	refreshIncome()
	refreshPad()
	updateDisplay()

	return function()
		alive = false
		for _, connection in connections do
			connection:Disconnect()
		end
		unmount()
		if anchor then
			anchor:Destroy()
			anchor = nil
		end
		if gui then
			gui:Destroy()
		end
	end
end

return MoneyPadDisplay
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="552">
              <Properties>
                <string name="Name">TankCrabBillboard</string>
                <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Vide = require(ReplicatedStorage.Packages.Vide)
local Crabs = require(ReplicatedStorage.Source.Features.Crabs.Modules.Crabs)
local CrabWeights = require(ReplicatedStorage.Source.Features.Crabs.Modules.CrabWeights)
local Rarities = require(ReplicatedStorage.Source.Game.Items.Rarities)
local CompactNumber = require(ReplicatedStorage.Source.Game.CompactNumber)
local PlotExtraSlots = require(ReplicatedStorage.Source.Features.Plots.Modules.PlotExtraSlots)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local create = Vide.create

type Card = { instanceId: string, imageId: number, rarity: Rarities.Rarity, rate: string }
local TankCrabBillboard = {}

local cardImages: { [Rarities.Rarity]: { big: number, small: number } } = {
	Common = { big = assets.CommonBigCard, small = assets.CommonSmallCard },
	Uncommon = { big = assets.UncommonBigCard, small = assets.UncommonSmallCard },
	Rare = { big = assets.RareBigCard, small = assets.RareSmallCard },
	Epic = { big = assets.EpicBigCard, small = assets.EpicSmallCard },
	Legendary = { big = assets.LegendaryBigCard, small = assets.LegendarySmallCard },
	Mythic = { big = assets.MythicBigCard, small = assets.MythicSmallCard },
}

local function cardPosition(index: number, count: number): UDim2
	if count == 1 then
		return UDim2.fromScale(0.5, 0.34)
	elseif count == 2 then
		return UDim2.fromScale(if index == 1 then 0.25 else 0.75, 0.34)
	elseif count == 3 and index == 3 then
		return UDim2.fromScale(0.5, 0.59)
	end
	return UDim2.fromScale(if index % 2 == 1 then 0.25 else 0.75, if index <= 2 then 0.205 else 0.59)
end

local function makeCard(index: number, cards: () -> { Card }, boostPercent: () -> number): (ImageLabel, UIScale)
	local card = create "ImageLabel" {
		Name = "CrabCard" .. index,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Image = function()
			local info = cards()[index]
			return if info then "rbxassetid://" .. cardImages[info.rarity].big else ""
		end,
		ScaleType = Enum.ScaleType.Stretch,
		Visible = function()
			return cards()[index] ~= nil
		end,
		Position = function()
			return cardPosition(index, #cards())
		end,
		Size = function()
			return UDim2.fromScale(0.48, if #cards() >= 3 then 0.32 else 0.48)
		end,
	}
	local tile = create "ImageLabel" {
		Name = "RarityTile",
		Position = UDim2.fromScale(0.075, 0.13),
		Size = UDim2.fromScale(0.22, 0.74),
		BackgroundTransparency = 1,
		Image = function()
			local info = cards()[index]
			return if info then "rbxassetid://" .. cardImages[info.rarity].small else ""
		end,
		ScaleType = Enum.ScaleType.Stretch,
		ClipsDescendants = true,
	}
	tile.Parent = card
	local portrait = create "ImageLabel" {
		Name = "CrabImage",
		Position = UDim2.fromScale(0.03, 0.03),
		Size = UDim2.fromScale(0.94, 0.94),
		BackgroundTransparency = 1,
		Image = function()
			local info = cards()[index]
			return if info then "rbxassetid://" .. info.imageId else ""
		end,
		ScaleType = Enum.ScaleType.Fit,
	}
	portrait.Parent = tile
	local coin = create "ImageLabel" {
		Name = "CoinIcon",
		Position = UDim2.fromScale(0.30, 0.08),
		Size = UDim2.fromScale(0.23, 0.84),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.SandDollar,
		ScaleType = Enum.ScaleType.Fit,
	}
	coin.Parent = card
	local rate = create "TextLabel" {
		Name = "IncomePerSecond",
		Position = UDim2.fromScale(0.53, 0.16),
		Size = UDim2.fromScale(0.44, 0.68),
		BackgroundTransparency = 1,
		Text = function()
			local info = cards()[index]
			return if info then info.rate else ""
		end,
		TextColor3 = function()
			return if boostPercent() > 0 then Color3.fromRGB(80, 235, 88) else Color3.new(1, 1, 1)
		end,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.45,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.BuilderSansExtraBold,
	}
	rate.Parent = card
	local rateScale = create "UIScale" { Scale = 1 }
	rateScale.Parent = rate
	local rateStroke = create "UIStroke" {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Color = Color3.new(0, 0, 0),
		Thickness = 1.5,
	}
	rateStroke.Parent = rate
	local rateLimit = create "UITextSizeConstraint" { MaxTextSize = 36 }
	rateLimit.Parent = rate
	return card, rateScale
end

function TankCrabBillboard.attach(model: Model): () -> ()
	local cards = Vide.source({} :: { Card })
	local boostPercent = Vide.source(0)
	local capacity = Vide.source(0)
	local driver = Vide.source(model.PrimaryPart)
	local topOffset = Vide.source(0)
	local floorOccluded = Vide.source(false)
	local floorRaycast = RaycastParams.new()
	floorRaycast.FilterType = Enum.RaycastFilterType.Include
	floorRaycast.IgnoreWater = true
	local nextOcclusionCheck = 0
	local connections: { RBXScriptConnection } = {}
	local folderConnections: { RBXScriptConnection } = {}
	local anchorConnections: { [BasePart]: { RBXScriptConnection } } = {}
	local folder: Folder? = nil
	local destroyed = false
	local pulseScales: { [number]: UIScale } = {}
	local pulseTweens: { [number]: Tween } = {}

	local function refreshPulse()
		for index, scale in pulseScales do
			local shouldPulse = boostPercent() > 0 and cards()[index] ~= nil
			local tween = pulseTweens[index]
			if shouldPulse and not tween then
				tween = TweenService:Create(scale, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
					Scale = 1.05,
				})
				pulseTweens[index] = tween
				tween:Play()
			elseif not shouldPulse and tween then
				tween:Cancel()
				pulseTweens[index] = nil
				scale.Scale = 1
			end
		end
	end

	local function updateGeometry()
		local primary = model.PrimaryPart
		driver(primary)
		if primary then
			local box, size = model:GetBoundingBox()
			topOffset(box.Position.Y + size.Y / 2 - primary.Position.Y + 0.35)
		end
	end

	local function updateFloorOcclusion()
		local now = os.clock()
		if now < nextOcclusionCheck then
			return
		end
		nextOcclusionCheck = now + 0.1

		local camera = Workspace.CurrentCamera
		local primary = model.PrimaryPart
		local placedFolder = model.Parent
		local plot = if placedFolder then placedFolder.Parent else nil
		if not camera or not primary or not plot or not plot:IsA("Model") then
			floorOccluded(false)
			return
		end

		local decks: { Instance } = {}
		for _, floorName in PlotExtraSlots.floorNames do
			local floor = plot:FindFirstChild(floorName)
			local deck = if floor then floor:FindFirstChild("Deck") else nil
			local mainDeck = if deck then deck:FindFirstChild("MainDeck") else nil
			if mainDeck and mainDeck:IsA("BasePart") then
				table.insert(decks, mainDeck)
			end
		end
		if #decks == 0 then
			floorOccluded(false)
			return
		end

		floorRaycast.FilterDescendantsInstances = decks
		local target = primary.Position + Vector3.new(0, topOffset(), 0)
		local cameraPosition = camera.CFrame.Position
		floorOccluded(Workspace:Raycast(cameraPosition, target - cameraPosition, floorRaycast) ~= nil)
	end

	local function refresh()
		local value = model:GetAttribute("TankCapacity")
		capacity(if typeof(value) == "number" then value else 0)
		local rawBoost = model:GetAttribute("TankIncomeBoostPercent")
		local boost = if typeof(rawBoost) == "number" then rawBoost else 0
		boostPercent(boost)
		local nextCards: { Card } = {}
		if folder then
			for _, child in folder:GetChildren() do
				if child:IsA("BasePart") and child.Name == "ContainedCrabAnchor" then
					local crabId = child:GetAttribute("CrabId")
					local definition = if typeof(crabId) == "string" then Crabs.get(crabId) else nil
					if definition then
						local instanceId = child:GetAttribute("ItemInstanceId")
						table.insert(nextCards, {
							instanceId = if typeof(instanceId) == "string" then instanceId else child.Name,
							imageId = definition.imageId,
							rarity = definition.rarity,
							rate = CompactNumber.formatIncomeRate(CrabWeights.income(definition.incomePerSecond, child:GetAttribute("WeightGrams")) * (1 + boost / 100)) .. "/s",
						})
					end
				end
			end
		end
		table.sort(nextCards, function(a, b)
			return a.instanceId < b.instanceId
		end)
		cards(nextCards)
		refreshPulse()
	end

	local function disconnectFolder()
		for _, connection in folderConnections do
			connection:Disconnect()
		end
		table.clear(folderConnections)
		for _, anchorList in anchorConnections do
			for _, connection in anchorList do
				connection:Disconnect()
			end
		end
		table.clear(anchorConnections)
		folder = nil
	end

	local function watchAnchor(child: Instance)
		if not child:IsA("BasePart") or child.Name ~= "ContainedCrabAnchor" or anchorConnections[child] then
			return
		end
		anchorConnections[child] = {
			child:GetAttributeChangedSignal("CrabId"):Connect(refresh),
			child:GetAttributeChangedSignal("ItemInstanceId"):Connect(refresh),
			child:GetAttributeChangedSignal("WeightGrams"):Connect(refresh),
		}
	end

	local function bindFolder(candidate: Instance?)
		if folder == candidate then
			return
		end
		disconnectFolder()
		if candidate and candidate:IsA("Folder") and candidate.Name == "ContainedCrabs" then
			folder = candidate
			for _, child in candidate:GetChildren() do
				watchAnchor(child)
			end
			table.insert(folderConnections, candidate.ChildAdded:Connect(function(child)
				watchAnchor(child)
				refresh()
			end))
			table.insert(folderConnections, candidate.ChildRemoved:Connect(function(child)
				local anchorList = if child:IsA("BasePart") then anchorConnections[child] else nil
				if anchorList then
					for _, connection in anchorList do
						connection:Disconnect()
					end
					anchorConnections[child] = nil
				end
				refresh()
			end))
		end
		refresh()
	end

	local billboard: BillboardGui? = nil
	local unmount = Vide.mount(function()
		local gui = create "BillboardGui" {
			Name = "TankCrabBillboard",
			Adornee = driver,
			Enabled = function()
				return capacity() > 0 and driver() ~= nil and not floorOccluded()
			end,
			Size = function()
				local count = #cards()
				return UDim2.fromScale(8.5, if count == 0 then 1 else if count >= 3 then 3.9 else 2.6)
			end,
			SizeOffset = Vector2.new(0, 0.5),
			StudsOffsetWorldSpace = function()
				return Vector3.new(0, topOffset(), 0)
			end,
			MaxDistance = 50,
			AlwaysOnTop = true,
			LightInfluence = 0,
		}
		for index = 1, 4 do
			local card, scale = makeCard(index, cards, boostPercent)
			pulseScales[index] = scale
			card.Parent = gui
		end
		local countLabel = create "TextLabel" {
			Name = "OccupiedCount",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = function()
				return UDim2.fromScale(0.5, if #cards() == 0 then 0.5 else if #cards() >= 3 then 0.91 else 0.84)
			end,
			Size = function()
				return UDim2.fromScale(0.4, if #cards() == 0 then 0.75 else 0.20)
			end,
			BackgroundTransparency = 1,
			Text = function()
				return tostring(#cards()) .. "/" .. tostring(capacity())
			end,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeColor3 = Color3.new(0, 0, 0),
			TextStrokeTransparency = 0,
			TextScaled = true,
			Font = Enum.Font.BuilderSansExtraBold,
		}
		countLabel.Parent = gui
		local countLimit = create "UITextSizeConstraint" { MaxTextSize = 40 }
		countLimit.Parent = countLabel
		billboard = gui
		return gui
	end, Players.LocalPlayer:WaitForChild("PlayerGui"))

	table.insert(connections, model:GetAttributeChangedSignal("TankCapacity"):Connect(refresh))
	table.insert(connections, model:GetAttributeChangedSignal("TankIncomeBoostPercent"):Connect(refresh))
	table.insert(connections, model:GetPropertyChangedSignal("PrimaryPart"):Connect(updateGeometry))
	table.insert(connections, RunService.RenderStepped:Connect(updateFloorOcclusion))
	table.insert(connections, model.ChildAdded:Connect(function(child)
		if child.Name == "ContainedCrabs" then
			bindFolder(child)
		end
	end))
	table.insert(connections, model.ChildRemoved:Connect(function(child)
		if child == folder then
			bindFolder(model:FindFirstChild("ContainedCrabs"))
		end
	end))
	updateGeometry()
	updateFloorOcclusion()
	bindFolder(model:FindFirstChild("ContainedCrabs"))

	return function()
		if destroyed then
			return
		end
		destroyed = true
		for _, connection in connections do
			connection:Disconnect()
		end
		for _, tween in pulseTweens do
			tween:Cancel()
		end
		table.clear(pulseTweens)
		disconnectFolder()
		unmount()
		if billboard then
			billboard:Destroy()
		end
	end
end

return TankCrabBillboard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="553">
              <Properties>
                <string name="Name">TankEmptyWarning</string>
                <string name="Source">--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create

local TankEmptyWarning = {}

function TankEmptyWarning.mount(playerGui: PlayerGui): () -&gt; ()
	local banner: Frame = nil :: any
	local label: TextLabel = nil :: any
	local stroke: UIStroke = nil :: any
	local sound: Sound = nil :: any

	Vide.mount(function()
		stroke = create "UIStroke" {
			Color = Color3.fromRGB(42, 0, 0),
			Thickness = 3,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		}
		label = create "TextLabel" {
			Name = "Message",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = "EMPTY TANK OUT BEFORE REMOVING",
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			TextScaled = true,
			Font = Enum.Font.BuilderSansExtraBold,
			ZIndex = 2,
		}
		stroke.Parent = label
		create "UITextSizeConstraint" {
			MaxTextSize = 30,
		}.Parent = label
		banner = create "Frame" {
			Name = "Banner",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 1 / 3),
			Size = UDim2.new(0.78, 0, 0, 48),
			BackgroundColor3 = Color3.fromRGB(218, 38, 38),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
		}
		create "UIGradient" {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(139, 14, 18)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 73, 73)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(139, 14, 18)),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.16, 0),
				NumberSequenceKeypoint.new(0.84, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}.Parent = banner
		label.Parent = banner
		sound = create "Sound" {
			Name = "TankWarningSound",
			SoundId = "rbxassetid://550209561",
			Volume = 1,
		}
		local gui = create "ScreenGui" {
			Name = "TankEmptyWarning",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 51,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
		banner.Parent = gui
		sound.Parent = gui
		return gui
	end, playerGui)

	local version = 0
	return function()
		version += 1
		local currentVersion = version
		banner.Visible = true
		banner.BackgroundTransparency = 1
		label.TextTransparency = 1
		stroke.Transparency = 1
		sound.TimePosition = 0
		sound:Play()

		TweenService:Create(banner, TweenInfo.new(0.25), { BackgroundTransparency = 0.3 }):Play()
		TweenService:Create(label, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.25), { Transparency = 0 }):Play()

		task.delay(1.5, function()
			if version ~= currentVersion then
				return
			end
			TweenService:Create(banner, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			local fade = TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 })
			fade.Completed:Once(function()
				if version == currentVersion then
					banner.Visible = false
				end
			end)
			fade:Play()
		end)
	end
end

return TankEmptyWarning</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="554">
              <Properties>
                <string name="Name">TankPickupEffect</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local create = Vide.create

local TankPickupEffect = {}

local function centerOf(guiObject: GuiObject): Vector2
	return guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2
end

local function destination(playerGui: PlayerGui, slotIndex: number?): Vector2
	if slotIndex and slotIndex > 0 then
		local hotbar = playerGui:FindFirstChild("InventoryHotbar")
		local slots = if hotbar then hotbar:FindFirstChild("Slots") else nil
		local row = if slots then slots:FindFirstChild("SlotRow") else nil
		if row then
			for _, child in row:GetChildren() do
				if child:IsA("GuiButton") and child:GetAttribute("SlotIndex") == slotIndex then
					return centerOf(child)
				end
			end
		end
		if slots and slots:IsA("GuiObject") then
			return centerOf(slots)
		end
	end
	local inventory = playerGui:FindFirstChild("InventoryPanel")
	local toggle = if inventory then inventory:FindFirstChild("InventoryToggle") else nil
	if toggle and toggle:IsA("GuiObject") then
		return centerOf(toggle)
	end
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(800, 600)
	return Vector2.new(size.X / 2, size.Y - 75)
end

function TankPickupEffect.mount(playerGui: PlayerGui): (number, Vector2, number?) -> ()
	local layer: ScreenGui = nil :: any
	Vide.mount(function()
		layer = create "ScreenGui" {
			Name = "TankPickupEffect",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 30,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
		return layer
	end, playerGui)

	return function(imageId: number, startPosition: Vector2, slotIndex: number?)
		local crab = create "ImageLabel" {
			Name = "PickedUpCrab",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(startPosition.X, startPosition.Y),
			Size = UDim2.fromOffset(72, 72),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. imageId,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 2,
		}
		crab.Parent = layer

		local rise = TweenService:Create(crab, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(startPosition.X, startPosition.Y - 55),
			Size = UDim2.fromOffset(90, 90),
			Rotation = -12,
		})
		rise.Completed:Once(function(state)
			if state ~= Enum.PlaybackState.Completed or not crab.Parent then
				crab:Destroy()
				return
			end
			local target = destination(playerGui, slotIndex)
			local fall = TweenService:Create(crab, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(target.X, target.Y),
				Size = UDim2.fromOffset(35, 35),
				Rotation = 0,
			})
			fall.Completed:Once(function()
				crab:Destroy()
			end)
			fall:Play()
		end)
		rise:Play()
	end
end

return TankPickupEffect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="555">
              <Properties>
                <string name="Name">TankPopupRoot</string>
                <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Vide = require(ReplicatedStorage.Packages.Vide)
local assets = require(ReplicatedStorage.Source.Assets.UI.ShopImages)
local DecorConfig = require(ReplicatedStorage.Source.Features.DecorShop.DecorConfig)

local create = Vide.create

export type Card = {
	instanceId: string,
	name: string,
	imageId: number,
	weight: string,
	income: string,
	sellPrice: string,
}

export type Props = {
	cards: () -> { Card },
	boostPercent: () -> number,
	decorCounts: () -> { [string]: number },
	decorSlots: () -> { [number]: { instanceId: string, decorId: string } },
	selectedDecorSlot: () -> number?,
	isOpen: () -> boolean,
	onClose: () -> (),
	onDecorSlotSelected: (number) -> (),
	onCloseDecorations: () -> (),
	onChooseDecoration: (string) -> (),
	onPickupDecoration: (string, Vector2) -> (),
	onPickUp: (string, Vector2) -> (),
	onSell: (string) -> (),
}

local function outlinedText(name: string, value: () -> string, position: UDim2, size: UDim2, maxSize: number, strokeThickness: number?, visible: (() -> boolean)?): TextLabel
	local label = create "TextLabel" {
		Name = name,
		BackgroundTransparency = 1,
		Visible = if visible then visible else true,
		Position = position,
		Size = size,
		Text = value,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.BuilderSansExtraBold,
	}
	create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = strokeThickness or 3.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}.Parent = label
	create "UITextSizeConstraint" { MaxTextSize = maxSize }.Parent = label
	return label
end

local function makeCard(index: number, cards: () -> { Card }, onPickUp: (string, Vector2) -> (), onSell: (string) -> ()): ImageLabel
	local function info(): Card?
		return cards()[index]
	end

	local card = create "ImageLabel" {
		Name = "CrabCard" .. index,
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.TankCArdPopUP,
		ScaleType = Enum.ScaleType.Stretch,
		Visible = function()
			return info() ~= nil
		end,
		Size = UDim2.new(1, -8, 0, 210),
	}

	local crabImage = create "ImageLabel" {
		Name = "CrabImage",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.025, 0.08),
		Size = UDim2.fromScale(0.305, 0.84),
		Image = function()
			local item = info()
			return if item then "rbxassetid://" .. item.imageId else ""
		end,
		ScaleType = Enum.ScaleType.Crop,
	}
	crabImage.Parent = card
	local weightText = outlinedText("CrabWeight", function()
		local item = info()
		return if item then item.weight else ""
	end, UDim2.fromScale(0.07, 0.73), UDim2.fromScale(0.86, 0.22), 24, 2.5)
	weightText.TextXAlignment = Enum.TextXAlignment.Center
	weightText.ZIndex = 2
	weightText.Parent = crabImage

	outlinedText("CrabName", function()
		local item = info()
		return if item then string.upper(item.name) else ""
	end, UDim2.fromScale(0.36, 0.07), UDim2.fromScale(0.59, 0.25), 40).Parent = card

	create "ImageLabel" {
		Name = "CoinIcon",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.35, 0.30),
		Size = UDim2.fromScale(0.09, 0.23),
		Image = "rbxassetid://" .. assets.SandDollar,
		ScaleType = Enum.ScaleType.Fit,
	}.Parent = card

	outlinedText("IncomePerSecond", function()
		local item = info()
		return if item then item.income else ""
	end, UDim2.fromScale(0.45, 0.28), UDim2.fromScale(0.46, 0.25), 42).Parent = card

	local pickupScale = create "UIScale" { Scale = 1 }
	local pickupTween: Tween? = nil
	local function setPickupScale(value: number)
		if pickupTween then
			pickupTween:Cancel()
		end
		local tween = TweenService:Create(pickupScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = value,
		})
		pickupTween = tween
		tween:Play()
	end
	local pickup = create "ImageButton" {
		Name = "PickupButton",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.83, 0.605),
		Size = UDim2.fromScale(0.26, 0.19),
		Image = "rbxassetid://" .. assets.TankpickUpbutton,
		ScaleType = Enum.ScaleType.Stretch,
		AutoButtonColor = false,
		MouseEnter = function()
			setPickupScale(1.1)
		end,
		MouseLeave = function()
			setPickupScale(1)
		end,
		Activated = function()
			local item = info()
			if item then
				onPickUp(item.instanceId, crabImage.AbsolutePosition + crabImage.AbsoluteSize / 2)
			end
		end,
	}
	pickup.Parent = card
	pickupScale.Parent = pickup
	local pickupText = outlinedText("PickupText", function()
		return "PICK UP"
	end, UDim2.new(), UDim2.fromScale(1, 1), 26, 2)
	pickupText.TextXAlignment = Enum.TextXAlignment.Center
	pickupText.Parent = pickup

	local sellScale = create "UIScale" { Scale = 1 }
	local sellTween: Tween? = nil
	local function setSellScale(value: number)
		if sellTween then
			sellTween:Cancel()
		end
		local tween = TweenService:Create(sellScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = value,
		})
		sellTween = tween
		tween:Play()
	end
	local sell = create "ImageButton" {
		Name = "SellButton",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.83, 0.82),
		Size = UDim2.fromScale(0.26, 0.18),
		Image = "rbxassetid://" .. assets.TankSellButton,
		ScaleType = Enum.ScaleType.Stretch,
		AutoButtonColor = false,
		MouseEnter = function()
			setSellScale(1.1)
		end,
		MouseLeave = function()
			setSellScale(1)
		end,
		Activated = function()
			local item = info()
			if item then
				setSellScale(1)
				onSell(item.instanceId)
			end
		end,
	}
	sell.Parent = card
	sellScale.Parent = sell
	local sellText = outlinedText("SellText", function()
		local item = info()
		return if item then "SELL $" .. item.sellPrice else "SELL"
	end, UDim2.new(), UDim2.fromScale(1, 1), 26, 2)
	sellText.TextXAlignment = Enum.TextXAlignment.Center
	sellText.Parent = sell

	return card
end

local function TankPopupRoot(props: Props): ScreenGui
	local closeSound = create "Sound" {
		Name = "CloseSound",
		SoundId = "rbxassetid://132948338000932",
		Volume = 1,
	}
	local sellSound = create "Sound" {
		Name = "SellSound",
		SoundId = "rbxassetid://4612383453",
		Volume = 1,
	}
	local function onSell(instanceId: string)
		sellSound.TimePosition = 0
		sellSound:Play()
		props.onSell(instanceId)
	end
	local function onPickUp(instanceId: string, startPosition: Vector2)
		closeSound.TimePosition = 0
		closeSound:Play()
		props.onPickUp(instanceId, startPosition)
	end
	local cardInstances = {
		makeCard(1, props.cards, onPickUp, onSell),
		makeCard(2, props.cards, onPickUp, onSell),
		makeCard(3, props.cards, onPickUp, onSell),
		makeCard(4, props.cards, onPickUp, onSell),
	}

	local visible = Vide.source(false)
	local closeScale = create "UIScale" { Scale = 1 }
	local hoverTween: Tween? = nil
	local function setCloseScale(scale: number)
		if hoverTween then
			hoverTween:Cancel()
		end
		local tween = TweenService:Create(closeScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = scale,
		})
		hoverTween = tween
		tween:Play()
	end

	local gui = create "ScreenGui" {
		Name = "TankPopup",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 20,
		Enabled = visible,
	}

	closeSound.Parent = gui
	sellSound.Parent = gui

	local background = create "ImageLabel" {
		Name = "Background",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.88, 0.8),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.TankPopUpbackgorund,
		ScaleType = Enum.ScaleType.Stretch,
	}
	background.Parent = gui
	create "UIAspectRatioConstraint" {
		AspectRatio = 0.86,
		DominantAxis = Enum.DominantAxis.Width,
	}.Parent = background
	create "UISizeConstraint" {
		MaxSize = Vector2.new(620, 720),
	}.Parent = background

	local titleBanner = create "ImageLabel" {
		Name = "CrabsTitleBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.17, 0.015),
		Size = UDim2.fromScale(0.55, 0.17),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.WoodenPlankShop,
		ScaleType = Enum.ScaleType.Fit,
	}
	titleBanner.Parent = background
	local title = outlinedText("CrabsTitle", function()
		return "CRABS"
	end, UDim2.fromScale(0.14, 0.04), UDim2.fromScale(0.74, 0.90), 72)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.Rotation = -8
	title.Parent = titleBanner
	local close = create "ImageButton" {
		Name = "CloseButton",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.97, 0.015),
		Size = UDim2.fromScale(0.14, 0.12),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.ExitButton,
		ScaleType = Enum.ScaleType.Fit,
		MouseEnter = function()
			setCloseScale(1.1)
		end,
		MouseLeave = function()
			setCloseScale(1)
		end,
		Activated = function()
			setCloseScale(1)
			closeSound:Play()
			props.onClose()
		end,
	}
	close.Parent = background
	closeScale.Parent = close

	local list = create "ScrollingFrame" {
		Name = "CrabList",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.86, 0.56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Color3.fromRGB(100, 48, 8),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	list.Parent = background
	create "UIListLayout" {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
	}.Parent = list
	create "UIPadding" {
		PaddingTop = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 5),
	}.Parent = list

	for _, card in cardInstances do
		card.Parent = list
	end

	local decorBanner = create "ImageLabel" {
		Name = "DecorBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.82),
		Size = UDim2.fromScale(0.94, 0.205),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.ShopPaperBanner,
		ScaleType = Enum.ScaleType.Stretch,
	}
	decorBanner.Parent = background

	for index = 1, 4 do
		local slotScale = create "UIScale" { Scale = 1 }
		local slotTween: Tween? = nil
		local hovering = false
		local hovered = Vide.source(false)
		local function tweenSlot(target: number)
			if slotTween then
				slotTween:Cancel()
			end
			local tween = TweenService:Create(slotScale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = target,
			})
			slotTween = tween
			tween:Play()
		end
		local slot: ImageButton
		slot = create "ImageButton" {
			Name = "DecorSlot" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.19 + (index - 1) * 0.205, 0.52),
			Size = UDim2.fromScale(0.155, 0.6),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. assets.ShopItemBackground,
			ScaleType = Enum.ScaleType.Stretch,
			AutoButtonColor = false,
			MouseEnter = function()
				hovering = true
				hovered(true)
				tweenSlot(1.08)
			end,
			MouseLeave = function()
				hovering = false
				hovered(false)
				tweenSlot(1)
			end,
			Activated = function()
				local placed = props.decorSlots()[index]
				if placed then
					closeSound.TimePosition = 0
					closeSound:Play()
					props.onCloseDecorations()
					props.onPickupDecoration(placed.instanceId, slot.AbsolutePosition + slot.AbsoluteSize / 2)
				else
					props.onDecorSlotSelected(index)
				end
				tweenSlot(0.94)
				task.delay(0.08, function()
					if slotScale.Parent then
						tweenSlot(if hovering then 1.08 else 1)
					end
				end)
			end,
		}
		slot.Parent = decorBanner
		slotScale.Parent = slot
		create "ImageLabel" {
			Name = "PlacedDecoration",
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.08, 0.08),
			Size = UDim2.fromScale(0.84, 0.84),
			ScaleType = Enum.ScaleType.Fit,
			Image = function()
				local placed = props.decorSlots()[index]
				local definition = if placed then DecorConfig.get(placed.decorId) else nil
				return if definition then "rbxassetid://" .. definition.imageId else ""
			end,
		}.Parent = slot
		create "TextLabel" {
			Name = "RemoveDecorationHint",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(0.98, 0.01),
			Size = UDim2.fromScale(0.43, 0.43),
			BackgroundTransparency = 1,
			Text = "X",
			TextColor3 = Color3.fromRGB(255, 38, 42),
			TextStrokeColor3 = Color3.new(0, 0, 0),
			TextStrokeTransparency = 0,
			TextScaled = true,
			Font = Enum.Font.BuilderSansExtraBold,
			ZIndex = 3,
			Visible = function()
				return hovered() and props.decorSlots()[index] ~= nil
			end,
		}.Parent = slot
		create "UICorner" { CornerRadius = UDim.new(0, 8) }.Parent = slot
		create "UIStroke" {
			Name = "SelectedStroke",
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.fromRGB(255, 225, 100),
			Thickness = 3,
			Transparency = function()
				return if props.selectedDecorSlot() == index then 0 else 1
			end,
		}.Parent = slot
	end

	local decorPlank = create "ImageLabel" {
		Name = "DecorTitleBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.19, 0.71),
		Size = UDim2.fromScale(0.37, 0.1),
		BackgroundTransparency = 1,
		Image = "rbxassetid://" .. assets.WoodenPlankShop,
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = 3,
	}
	decorPlank.Parent = background
	local decorTitle = outlinedText("DecorTitle", function()
		return "DECOR"
	end, UDim2.fromScale(0.15, 0.15), UDim2.fromScale(0.7, 0.68), 50, 3)
	decorTitle.TextXAlignment = Enum.TextXAlignment.Center
	decorTitle.Rotation = -8
	decorTitle.ZIndex = 4
	decorTitle.Parent = decorPlank

	local boostLabel = outlinedText("TankBoostPercent", function()
		return `+{props.boostPercent()}% BOOSTED`
	end, UDim2.fromScale(0.55, 0.668), UDim2.fromScale(0.38, 0.055), 24, 2.5, function()
		return props.boostPercent() > 0
	end)
	boostLabel.TextColor3 = Color3.fromRGB(80, 235, 88)
	boostLabel.TextXAlignment = Enum.TextXAlignment.Right
	boostLabel.ZIndex = 4
	boostLabel.Parent = background

	local empty = create "TextLabel" {
		Name = "EmptyMessage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.84, 0.22),
		BackgroundTransparency = 1,
		Text = "NO CRABS IN THIS TANK",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		Font = Enum.Font.BuilderSansExtraBold,
		Visible = function()
			return #props.cards() == 0
		end,
	}
	empty.Parent = background
	create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = 3.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}.Parent = empty
	create "UITextSizeConstraint" { MaxTextSize = 42 }.Parent = empty

	local decorationsPanel = create "Frame" {
		Name = "DecorationsPanel",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(1.025, 0.48),
		Size = UDim2.fromScale(0.48, 0.63),
		BackgroundColor3 = Color3.fromRGB(48, 32, 19),
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		ZIndex = 5,
		Visible = function()
			return props.isOpen() and props.selectedDecorSlot() ~= nil
		end,
	}
	decorationsPanel.Parent = background
	create "UICorner" { CornerRadius = UDim.new(0, 10) }.Parent = decorationsPanel
	create "UIStroke" {
		Color = Color3.fromRGB(107, 58, 19),
		Thickness = 3,
	}.Parent = decorationsPanel

	local decorationsTitle = outlinedText("DecorationsTitle", function()
		return "DECORATIONS"
	end, UDim2.fromScale(0.06, 0.035), UDim2.fromScale(0.76, 0.11), 30, 2.5)
	decorationsTitle.ZIndex = 6
	decorationsTitle.Parent = decorationsPanel

	local closeDecorations = create "TextButton" {
		Name = "CloseDecorations",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.96, 0.035),
		Size = UDim2.fromScale(0.13, 0.1),
		BackgroundTransparency = 1,
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		Font = Enum.Font.BuilderSansExtraBold,
		ZIndex = 6,
		Activated = props.onCloseDecorations,
	}
	closeDecorations.Parent = decorationsPanel
	create "UITextSizeConstraint" { MaxTextSize = 28 }.Parent = closeDecorations

	local decorList = create "ScrollingFrame" {
		Name = "OwnedDecorations",
		Position = UDim2.fromScale(0.06, 0.18),
		Size = UDim2.fromScale(0.88, 0.76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Color3.fromRGB(209, 158, 77),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 6,
		Visible = function()
			local index = props.selectedDecorSlot()
			return index ~= nil and props.decorSlots()[index] == nil
		end,
	}
	decorList.Parent = decorationsPanel
	create "UIGridLayout" {
		CellSize = UDim2.new(0.48, -8, 0, 112),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}.Parent = decorList

	for index, definition in DecorConfig.items do
		local decorCard = create "ImageButton" {
			Name = "OwnedDecor_" .. definition.id,
			Size = UDim2.fromOffset(100, 112),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. assets.ShopItemBackground,
			ScaleType = Enum.ScaleType.Stretch,
			LayoutOrder = index,
			ZIndex = 7,
			AutoButtonColor = true,
			Activated = function()
				props.onChooseDecoration(definition.id)
			end,
			Visible = function()
				return (props.decorCounts()[definition.id] or 0) > 0
			end,
		}
		decorCard.Parent = decorList
		create "ImageLabel" {
			Name = "ItemImage",
			Position = UDim2.fromScale(0.08, 0.06),
			Size = UDim2.fromScale(0.84, 0.62),
			BackgroundTransparency = 1,
			Image = "rbxassetid://" .. definition.imageId,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 8,
		}.Parent = decorCard
		local name = outlinedText("ItemName", function()
			return definition.name
		end, UDim2.fromScale(0.04, 0.69), UDim2.fromScale(0.92, 0.22), 17, 2)
		name.TextXAlignment = Enum.TextXAlignment.Center
		name.ZIndex = 8
		name.Parent = decorCard
		local count = outlinedText("Count", function()
			return "x" .. tostring(props.decorCounts()[definition.id] or 0)
		end, UDim2.fromScale(0.64, 0.04), UDim2.fromScale(0.3, 0.2), 17, 2)
		count.TextXAlignment = Enum.TextXAlignment.Right
		count.ZIndex = 8
		count.Parent = decorCard
	end

	local noDecorations = create "TextLabel" {
		Name = "NoDecorations",
		Position = UDim2.fromScale(0.08, 0.43),
		Size = UDim2.fromScale(0.84, 0.14),
		BackgroundTransparency = 1,
		Text = "NO DECORATIONS IN BACKPACK",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.BuilderSansExtraBold,
		ZIndex = 7,
		Visible = function()
			local index = props.selectedDecorSlot()
			if index and props.decorSlots()[index] then
				return false
			end
			for _, count in props.decorCounts() do
				if count > 0 then
					return false
				end
			end
			return true
		end,
	}
	noDecorations.Parent = decorationsPanel
	create "UIStroke" {
		Color = Color3.new(0, 0, 0),
		Thickness = 2.5,
	}.Parent = noDecorations
	create "UITextSizeConstraint" { MaxTextSize = 22 }.Parent = noDecorations

	local function resizeCards()
		local height = math.max(80, math.floor(math.min((list.AbsoluteSize.X - 8) / 2.8, (list.AbsoluteSize.Y - 22) / 2)))
		for _, card in cardInstances do
			card.Size = UDim2.new(1, -8, 0, height)
		end
	end
	list:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizeCards)
	resizeCards()

	local shownPosition = UDim2.fromScale(0.5, 0.5)
	local hiddenPosition = UDim2.fromScale(0.5, 1.6)
	local panelTween: Tween? = nil
	local animationVersion = 0
	local shown = false
	local wasOpen = false

	background.Position = hiddenPosition

	Vide.effect(function()
		local shouldOpen = props.isOpen()
		if shouldOpen == wasOpen then
			return
		end
		wasOpen = shouldOpen
		animationVersion += 1
		local version = animationVersion

		if panelTween then
			panelTween:Cancel()
		end

		if shouldOpen then
			if not shown then
				background.Position = hiddenPosition
			end
			shown = true
			visible(true)
			local openingTween = TweenService:Create(background, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = shownPosition,
			})
			panelTween = openingTween
			openingTween:Play()
		elseif shown then
			local closingTween = TweenService:Create(background, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = hiddenPosition,
			})
			panelTween = closingTween
			closingTween.Completed:Once(function(playbackState)
				if playbackState == Enum.PlaybackState.Completed and animationVersion == version then
					shown = false
					visible(false)
				end
			end)
			closingTween:Play()
		else
			background.Position = hiddenPosition
		end
	end)

	return gui
end

return TankPopupRoot
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
